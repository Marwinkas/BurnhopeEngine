#version 460

// Используем размер группы 16x16 для прохода по пикселям экрана
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalSceneUbo {
     mat4 projection; mat4 invViewProj; mat4 view; vec3 camPos; float zNear;
    vec3 sunDir; float zFar; vec4 screenSize; mat4 sunLightSpaceMatrices[4];
    vec4 cascadeSplits; uint gridDimX; uint gridDimY; uint gridDimZ; uint portalID; float lightSize;
    vec3 sunColor; float sunIntensity;
    vec4 sscsParams; vec4 gtaoParams; vec4 fogParams; vec4 fogColor; vec4 inscatterColor;
    vec4 skyZenithColor; vec4 skyHorizonColor; vec4 skySunParams;
    vec4 ssgiParams;
    vec4 rtParams;
    
    mat4 prevViewProj;
    vec4 ppExposureParams;
    vec4 ppColorBalance;
    vec4 ppBloomParams;
    vec4 ppDoFParams; 
    vec4 ppVignetteGrain;
    vec4 ppMotionBlur;
    vec4 ppLensFlare;
    vec4 ppTAA_CAS;       // ДОБАВЛЕНО
    vec4 ppLensAdvanced;  // x: halo, y: caDir, z: autoFocus, w: tonemapper
    vec4 ppDistortionDirt;
    vec4 ppDitherAniso;
    vec4 cgShadows;
    vec4 cgMidtones;
    vec4 cgHighlights;
    vec4 ppRetroParams;
    vec4 ppRetroParams2;
    vec4 ppStylizedParams;
    vec4 ppOutlineParams;
    vec4 ppOutlineColor;
    vec4 ppOutlineJitter;
       vec4 ppWeatherSSR;
    vec4 ppSSSS;
    vec4 ppWeatherParams;

    vec4 cgGlobalLift;
    vec4 cgGlobalGamma;
    vec4 cgGlobalGain;
    vec4 cgGlobalOffset;
    vec4 cgShadowsLift;
    vec4 cgShadowsGamma;
    vec4 cgShadowsGain;
    vec4 cgShadowsOffset;
    vec4 cgMidtonesLift;
    vec4 cgMidtonesGamma;
    vec4 cgMidtonesGain;
    vec4 cgMidtonesOffset;
    vec4 cgHighlightsLift;
    vec4 cgHighlightsGamma;
    vec4 cgHighlightsGain;
    vec4 cgHighlightsOffset;
    vec4 cgRgbMixerRed;
    vec4 cgRgbMixerGreen;
    vec4 cgRgbMixerBlue;
    vec4 ppBlurs;
    vec4 ppBlurCenter;
    vec4 ppColorFX;
    vec4 ppFilmDamage;
    vec4 ppEdgeDetect;
    vec4 ppEdgeDetect2;
    vec4 ppEdgeColor;
    vec4 ppEmboss;
    vec4 ppSketch;
    vec4 ppSketch2;
    vec4 ppHalftone; 
    vec4 ppDitherData;
    vec4 ditherShadow;
    vec4 ditherMid;
    vec4 ditherHighlight;
    vec4 ppWarp;
    vec4 ppWarp2;
    vec4 ppColorComp;
    vec4 shadowRampColor1;
    vec4 shadowRampColor2;
} ubo;

layout(set = 1, binding = 3) uniform sampler2D gDepth;

layout(set = 2, binding = 1, std430) buffer PageTable {
    uint virtualPages[]; 
};

struct PointLightData {
    vec4 posType;      // w: type (1-Point, 2-Spot)
    vec4 colorInt; 
    vec4 dirRadius; 
    vec4 shadowParams; // z: castShadows, w: encodedSlot
    mat4 lightSpaceMatrix;
};

layout(std140, set = 3, binding = 0) uniform LightBlock {
    int activeLightsCount;
    int _pad[3];
    PointLightData lights[100];
} lightBlock;

struct LightGrid { uint offset; uint count; };
layout(std430, set = 3, binding = 1) readonly buffer GridBuffer { LightGrid lightGrid[]; };
layout(std430, set = 3, binding = 2) readonly buffer IndexBuffer { 
    uint globalIndexCount; uint globalIndexList[]; 
};

struct PointFaceMatrices { mat4 faces[6]; };
layout(std430, set = 3, binding = 3) readonly buffer FaceMatricesBlock {
    PointFaceMatrices faceMatrices[100];
} faceMatricesBuffer;

const uint VIRTUAL_PAGES_X = 4096;
const uint PAGE_SIZE = 128;

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    vec2 texSize = ubo.screenSize.xy;
    
    if (uv.x >= int(texSize.x) || uv.y >= int(texSize.y)) return;

    float depth = texelFetch(gDepth, uv, 0).r;
    if (depth >= 1.0) return; // Пропускаем небо

    // 1. Восстанавливаем позицию в мире
    vec2 ndc = (vec2(uv) / texSize) * 2.0 - 1.0;
    vec4 clip = vec4(ndc, depth, 1.0);
    vec4 worldPosW = ubo.invViewProj * clip;
    vec3 worldPos = worldPosW.xyz / worldPosW.w;

    // 2. Определяем кластер для поиска источников света
    vec4 viewPos = ubo.view * vec4(worldPos, 1.0);
    float zView = max(-viewPos.z, ubo.zNear + 0.001); 
    
    uint clusterX = uint(float(uv.x) / (texSize.x / float(ubo.gridDimX)));
    uint clusterY = uint(float(uv.y) / (texSize.y / float(ubo.gridDimY)));
    uint clusterZ = uint(max(0.0, log(zView / ubo.zNear) * float(ubo.gridDimZ) / log(ubo.zFar / ubo.zNear)));
    
    clusterX = clamp(clusterX, 0u, ubo.gridDimX - 1u);
    clusterY = clamp(clusterY, 0u, ubo.gridDimY - 1u);
    clusterZ = clamp(clusterZ, 0u, ubo.gridDimZ - 1u);
    
    uint clusterIdx = clusterX + clusterY * ubo.gridDimX + clusterZ * ubo.gridDimX * ubo.gridDimY;
    
    uint offset = lightGrid[clusterIdx].offset;
    uint lightsInCluster = lightGrid[clusterIdx].count;

    // 3. Проходимся по всем источникам в кластере
    for (uint i = 0; i < lightsInCluster; ++i) { 
        uint lightIdx = globalIndexList[offset + i];
        PointLightData light = lightBlock.lights[lightIdx];
        
        if (int(light.shadowParams.z + 0.5) != 1) continue; // Если теней нет

        int type = int(light.posType.w);
        int encodedSlot = int(light.shadowParams.w);
        if (encodedSlot < 0) continue;

        int realSlot = encodedSlot / 10000;
        int tileSize = encodedSlot % 10000;
        float pagesPerFace = float(tileSize) / float(PAGE_SIZE);

        uint faceCount = (type == 1) ? 6 : 1;

        for (uint face = 0; face < faceCount; ++face) {
            mat4 lightMat = (type == 2) ? light.lightSpaceMatrix : faceMatricesBuffer.faceMatrices[lightIdx].faces[face];
            vec4 lightClip = lightMat * vec4(worldPos, 1.0);
            vec3 proj = lightClip.xyz / lightClip.w;
            proj.xy = proj.xy * 0.5 + 0.5;

            // Проверяем, попадает ли точка в область видимости этой грани
            if (proj.z >= 0.0 && proj.z <= 1.0 && proj.x >= 0.0 && proj.x <= 1.0 && proj.y >= 0.0 && proj.y <= 1.0) {
                
                // Вычисляем координаты в виртуальной таблице страниц
                uint slotIndex = lightIdx * 6 + face;
                uint vOffsetX = (slotIndex % 32) * PAGE_SIZE;
                uint vOffsetY = (slotIndex / 32) * PAGE_SIZE;

                uint vPageX = vOffsetX + uint(proj.x * pagesPerFace);
                uint vPageY = vOffsetY + uint(proj.y * pagesPerFace);
                uint vPageIdx = vPageY * VIRTUAL_PAGES_X + vPageX;

                // Вычисляем индекс физической страницы в атласе
                uint baseX = uint(realSlot % 32) * PAGE_SIZE;
                uint baseY = uint(realSlot / 32) * PAGE_SIZE;
                
                // Логика смещения граней внутри слота
                uint faceX = baseX + int(face) * tileSize;
                uint faceY = baseY;
                while (faceX + tileSize > 4096) {
                    faceX -= 4096;
                    faceY += tileSize;
                }

                uint physPageX = (faceX / PAGE_SIZE) + uint(proj.x * pagesPerFace);
                uint physPageY = (faceY / PAGE_SIZE) + uint(proj.y * pagesPerFace);
                uint physIdx = physPageY * 32 + physPageX;

                // Записываем соответствие
                virtualPages[vPageIdx] = physIdx;
            }
        }
    }
}
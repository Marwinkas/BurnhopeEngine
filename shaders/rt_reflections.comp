    vec4 ppWarp;
    vec4 ppWarp2;
    vec4 ppColorComp;
    vec4 shadowRampColor1;
    vec4 shadowRampColor2;
} ubo;

layout(set = 1, binding = 0) uniform sampler2D gNormalRoughness;
layout(set = 1, binding = 1) uniform sampler2D gAlbedoMetallic;
layout(set = 1, binding = 2) uniform sampler2D gHeightAO;
layout(set = 1, binding = 3) uniform sampler2D gDepth;

layout(set = 2, binding = 0) uniform accelerationStructureEXT tlas;

struct Vertex { vec3 position; vec3 normal; vec2 texUV; vec3 tangent; vec3 bitangent; };
layout(buffer_reference, scalar) readonly buffer VertexBuffer { Vertex v[]; };
layout(buffer_reference, scalar) readonly buffer IndexBuffer  { uint i[]; };

struct ObjectData {
    mat4 modelMatrix; uint materialID; uint pad0;
    uint64_t vertexBufferAddress; uint64_t indexBufferAddress; uint64_t pad1;
};

struct MaterialData {
    int albedoAlphaIdx; int normalIdx; int ormxIdx; int emissiveIdx;
    int useTriplanar; int isTransparent; int repeatTexture; int pad1;
    
    vec2 uvScale; float triplanarScale; float emissiveIntensity;
    
    vec4 albedoColor;
    vec4 emissiveColor;

    float metallicStrength;
    float roughnessStrength;
    float normalStrength;
    float heightStrength;

    float aoStrength;
    float pad2; float pad3; float pad4;
};
layout(set = 3, binding = 0, scalar) readonly buffer ObjectBuffer { ObjectData objects[]; } objBuf;
layout(set = 3, binding = 1, scalar) readonly buffer MaterialBuffer { MaterialData materials[]; } matBuf;
layout(set = 4, binding = 0) uniform sampler2D bindlessTextures[];

layout(set = 5, binding = 0, rgba16f) uniform writeonly image2D outReflections;
layout(set = 5, binding = 1) uniform sampler2D reflectionProbes[16];

struct ProbeData {
    vec4 positionAndRadius;
};
layout(set = 5, binding = 2, std430) readonly buffer ProbesInfo {
    int count;
    ProbeData data[16];
} probes;

layout(set = 6, binding = 0) uniform sampler2D diffuseGITex;
layout(set = 6, binding = 1) uniform sampler2D specularGITex;
layout(set = 6, binding = 2) uniform sampler2D cascade0;

layout(push_constant) uniform RC {
    vec4  probeGridMin;
    vec4  probeGridMax;
    ivec4 probeCount; 
    vec4  params;     
} rc;

const float PI = 3.14159265359;

vec2 octaEncode(vec3 dir) {
    dir = normalize(dir);
    dir /= (abs(dir.x) + abs(dir.y) + abs(dir.z));
    if (dir.z < 0.0) dir.xy = (1.0 - abs(dir.yx)) * sign(dir.xy);
    return dir.xy * 0.5 + 0.5;
}

vec3 CalculateSky(vec3 viewDir) {
    float t = max(viewDir.y, 0.0);
    vec3 skyColor = mix(ubo.skyHorizonColor.rgb, ubo.skyZenithColor.rgb, pow(t, 0.5));
    if (ubo.fogParams.x > 0.5) {
        skyColor = mix(ubo.fogColor.rgb, skyColor, pow(t, 0.5));
    }
    float sunDot = dot(viewDir, -ubo.sunDir);
    float sunSize = ubo.skySunParams.x;
    float sunGlow = ubo.skySunParams.y;
    float sunGlowSize = max(ubo.skySunParams.z, 0.001);
    float sunDisk = smoothstep(1.0 - sunSize - 0.001, 1.0 - sunSize, sunDot);
    float sunAura = pow(max(sunDot, 0.0), 1.0 / sunGlowSize) * sunGlow;
    vec3 sunRenderColor = ubo.sunColor * ubo.sunIntensity;
    skyColor += sunRenderColor * sunDisk;
    skyColor += sunRenderColor * sunAura * 0.1;
    return skyColor;
}

vec3 SampleProbe(vec3 pos, vec3 dir) {
    int bestProbe = -1;
    float bestDist = 1000000.0;
    for(int i = 0; i < probes.count; i++) {
        float d = distance(pos, probes.data[i].positionAndRadius.xyz);
        if(d < probes.data[i].positionAndRadius.w && d < bestDist) {
            bestDist = d;
            bestProbe = i;
        }
    }
    if (bestProbe != -1) {
        vec2 uv = octaEncode(dir);
        return texture(reflectionProbes[nonuniformEXT(bestProbe)], uv).rgb;
    }
    return CalculateSky(dir);
}

vec3 sampleProbeRC(ivec3 probeIdx, vec3 dir) {
    int octaSize = int(rc.params.w);
    ivec3 pCount = rc.probeCount.xyz;
    vec2 octaUV = octaEncode(dir);
    int baseX = probeIdx.x * octaSize;
    int baseY = (probeIdx.z * pCount.y + probeIdx.y) * octaSize;
    vec2 p = clamp(octaUV * float(octaSize) - 0.5, vec2(0.0), vec2(float(octaSize - 1)));
    ivec2 i0 = ivec2(floor(p));
    ivec2 i1 = min(i0 + ivec2(1), ivec2(octaSize - 1));
    vec2 f = fract(p);
    ivec2 t00 = ivec2(baseX, baseY) + i0;
    ivec2 t10 = ivec2(baseX, baseY) + ivec2(i1.x, i0.y);
    ivec2 t01 = ivec2(baseX, baseY) + ivec2(i0.x, i1.y);
    ivec2 t11 = ivec2(baseX, baseY) + i1;
    vec3 cx0 = mix(texelFetch(cascade0, t00, 0).rgb, texelFetch(cascade0, t10, 0).rgb, f.x);
    vec3 cx1 = mix(texelFetch(cascade0, t01, 0).rgb, texelFetch(cascade0, t11, 0).rgb, f.x);
    return mix(cx0, cx1, f.y);
}

vec3 sampleRadiance(vec3 worldPos, vec3 N, vec3 dir) {
    vec3 gridSize = rc.probeGridMax.xyz - rc.probeGridMin.xyz;
    ivec3 pCount  = rc.probeCount.xyz;
    // Уменьшаем смещение до 0.1, как в gi_sample.comp
    vec3 biasedPos = worldPos + N * 0.1;
    vec3 localPos = (biasedPos - rc.probeGridMin.xyz) / gridSize;
    vec3 probeF = clamp(localPos * vec3(pCount) - 0.5, vec3(0.0), vec3(pCount - ivec3(1)));
    ivec3 p000 = ivec3(floor(probeF));
    ivec3 p111 = min(p000 + 1, pCount - ivec3(1));
    vec3 t = fract(probeF);
    vec3 radAccum = vec3(0.0);
    float weightSum = 0.0;
    for (int ix = 0; ix < 2; ix++) for (int iy = 0; iy < 2; iy++) for (int iz = 0; iz < 2; iz++) {
        ivec3 idx = ivec3(ix == 0 ? p000.x : p111.x, iy == 0 ? p000.y : p111.y, iz == 0 ? p000.z : p111.z);
        float w = (ix == 0 ? (1.0 - t.x) : t.x) * (iy == 0 ? (1.0 - t.y) : t.y) * (iz == 0 ? (1.0 - t.z) : t.z);
        vec3 probeWorldPos = rc.probeGridMin.xyz + gridSize * (vec3(idx) + 0.5) / vec3(pCount);
        vec3 toProbe = normalize(probeWorldPos - worldPos);
        float finalW = w * max(0.00001, pow(max(0.0, dot(N, toProbe)), 4.0));
        radAccum += sampleProbeRC(idx, dir) * finalW;
        weightSum += finalW;
    } return radAccum / weightSum;
}

vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(ubo.screenSize.x) || pixel.y >= int(ubo.screenSize.y)) return;

    vec2 uv = (vec2(pixel) + 0.5) / ubo.screenSize.xy;
    float depth = texture(gDepth, uv).r;
    if (depth >= 1.0 || ubo.rtParams.x < 0.5) {
        imageStore(outReflections, pixel, vec4(0.0));
        return;
    }

    vec4 normRough = texture(gNormalRoughness, uv);
    vec3 N = normalize(normRough.rgb);
    float roughness = normRough.a;
    vec4 albMet = texture(gAlbedoMetallic, uv);
    float metallic = albMet.a;

    // Трассируем лучи только для более-менее гладких или металлических объектов
    if (roughness > 0.6 && metallic < 0.1) {
        imageStore(outReflections, pixel, vec4(0.0));
        return;
    }

    vec4 ndc = vec4(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosRaw = ubo.invViewProj * ndc;
    vec3 worldPos = worldPosRaw.xyz / worldPosRaw.w;
    
    vec3 V = normalize(ubo.camPos - worldPos);
    vec3 R = reflect(-V, N);

    vec3 rayOrigin = worldPos + N * 0.05;
    vec3 rayDir = R;
    vec3 accumulatedColor = vec3(0.0);
    vec3 throughput = vec3(1.0);
    int MAX_BOUNCES = int(ubo.rtParams.y); // Берем кол-во отскоков из UI

    for (int bounce = 0; bounce < MAX_BOUNCES; bounce++) {
        rayQueryEXT rayQuery;
        rayQueryInitializeEXT(rayQuery, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, rayOrigin, 0.05, rayDir, 100.0);
        while(rayQueryProceedEXT(rayQuery)) {}

        if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            int instanceID = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
            int geomID = rayQueryGetIntersectionGeometryIndexEXT(rayQuery, true);
            int primID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);
            float t = rayQueryGetIntersectionTEXT(rayQuery, true);
            vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
            
            float u = barycentrics.x;
            float v = barycentrics.y;
            float w = 1.0 - u - v;
            
            ObjectData obj = objBuf.objects[instanceID + geomID];
            MaterialData mat = matBuf.materials[obj.materialID];
            vec3 albedo = vec3(0.8);
            
            IndexBuffer indices = IndexBuffer(obj.indexBufferAddress);
            VertexBuffer vertices = VertexBuffer(obj.vertexBufferAddress);
            Vertex v0 = vertices.v[indices.i[primID * 3 + 0]];
            Vertex v1 = vertices.v[indices.i[primID * 3 + 1]];
            Vertex v2 = vertices.v[indices.i[primID * 3 + 2]];
            
            vec2 texUV = v0.texUV * w + v1.texUV * u + v2.texUV * v;
            vec3 localNormal = v0.normal * w + v1.normal * u + v2.normal * v;
            mat3 normalMatrix = transpose(inverse(mat3(obj.modelMatrix)));
            vec3 worldNormal = normalize(normalMatrix * localNormal);
            if (dot(worldNormal, rayDir) > 0.0) worldNormal = -worldNormal;

            if (mat.albedoAlphaIdx >= 0) {
                albedo = textureLod(bindlessTextures[nonuniformEXT(mat.albedoAlphaIdx)], texUV * mat.uvScale, 0.0).rgb * mat.albedoColor.rgb;
            } else {
                albedo = mat.albedoColor.rgb;
            }
            
            float hitRoughness = mat.roughnessStrength;
            float hitMetallic = mat.metallicStrength;
            float hitAO = mat.aoStrength;
            if (mat.ormxIdx >= 0) {
                vec4 ormx = textureLod(bindlessTextures[nonuniformEXT(mat.ormxIdx)], texUV * mat.uvScale, 0.0);
                hitAO *= ormx.r; hitRoughness *= ormx.g; hitMetallic *= ormx.b;
            }
            
            vec3 hitPos = rayOrigin + rayDir * t;
            vec3 L = normalize(-ubo.sunDir);
            float NdotL = max(dot(worldNormal, L), 0.0);
            float shadow = 1.0;
            if (NdotL > 0.0) {
                rayQueryEXT shadowQuery;
                rayQueryInitializeEXT(shadowQuery, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu, hitPos + worldNormal * 0.02 + L * 0.02, 0.01, L, 1000.0);
                while(rayQueryProceedEXT(shadowQuery)) {}
                if (rayQueryGetIntersectionTypeEXT(shadowQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
                    shadow = 0.0;
                }
            }
            
            vec3 directLight = (albedo / PI) * ubo.sunColor * ubo.sunIntensity * (NdotL * shadow) * mix(1.0, hitAO, 0.3);
            
            // --- Radiance Cascades PBR GI в отражениях ---
            vec3 tangent = normalize(abs(worldNormal.x) > 0.9 ? vec3(0, 1, 0) : cross(vec3(1, 0, 0), worldNormal));
            vec3 bitangent = cross(worldNormal, tangent);
            vec3 diffuseGI = vec3(0.0);
            const int NUM_DIFFUSE = 4; // 4 луча достаточно для RT отражений
            for (int d = 0; d < NUM_DIFFUSE; d++) {
                float i_f = float(d) + 0.5;
                float phi = 2.39996323 * i_f;
                float cosTheta = sqrt(1.0 - i_f / float(NUM_DIFFUSE));
                float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
                vec3 d_dir = (cos(phi) * sinTheta) * tangent + (sin(phi) * sinTheta) * bitangent + cosTheta * worldNormal;
                diffuseGI += sampleRadiance(hitPos, worldNormal, d_dir);
            }
            diffuseGI /= float(NUM_DIFFUSE);

        float giStrength = 1.0; // Такое же значение, как в lighting.comp
            vec3 F0_hit = mix(vec3(0.04), albedo, hitMetallic);
            vec3 F_hit = fresnelSchlick(max(dot(worldNormal, -rayDir), 0.0), F0_hit);
            vec3 kD_hit = (vec3(1.0) - F_hit) * (1.0 - hitMetallic);
            
            vec3 indirectLight = diffuseGI * giStrength * albedo * kD_hit * hitAO;
            vec3 hitColor = directLight + indirectLight;

            if (ubo.fogParams.x > 0.5) {
                float fogAmount = clamp(exp(-t * ubo.fogParams.y), 0.0, 1.0);
                hitColor = mix(ubo.fogColor.rgb, hitColor, fogAmount);
            }

            // Если это зеркало и мы можем еще раз отскочить
             if (hitRoughness < 0.4 && hitMetallic > 0.1) {
                vec3 F0 = mix(vec3(0.04), albedo, hitMetallic);
                vec3 F = fresnelSchlick(max(dot(worldNormal, -rayDir), 0.0), F0);
                
                accumulatedColor += throughput * hitColor * (1.0 - hitMetallic);
                throughput *= F;
                
                if (bounce == MAX_BOUNCES - 1) {
                    // Если это последний отскок - дальше трассировать не можем, берем цвет отражения из Local Probe
                    accumulatedColor += throughput * SampleProbe(hitPos, reflect(rayDir, worldNormal));
                } else {
                    // Готовим следующий луч
                    rayOrigin = hitPos + worldNormal * 0.02;
                    rayDir = reflect(rayDir, worldNormal);
                }
            } else {
                accumulatedColor += throughput * hitColor;
                break;
            }
        } else {
            accumulatedColor += throughput * SampleProbe(rayOrigin, rayDir);
            break;
        }
    }

    imageStore(outReflections, pixel, vec4(accumulatedColor, 1.0));
}
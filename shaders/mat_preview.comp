#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;
layout(set = 0, binding = 1) uniform sampler2D texAlbedo;
layout(set = 0, binding = 2) uniform sampler2D texORM;
layout(set = 0, binding = 3) uniform sampler2D texNormal;
layout(set = 0, binding = 4) uniform sampler2D texHDR;

layout(push_constant) uniform PushConsts {
    vec4 albedoColor;   // xyz=color, w=alpha
    vec4 emissiveColor; // xyz=color, w=intensity
    vec4 matParams;     // x=metallic, y=roughness, z=normalStr, w=heightStr
    vec4 uvScale_triSc; // x,y=uvScale, z=triplanarScale, w=pad
    vec4 camPos_time;   // xyz=camPos, w=time
    ivec4 flags;        // x=shapeType, y=bitmask, z=pad, w=pad
} pc;

const float MAX_DIST = 50.0;
const float SURF_DIST = 0.001;
const int MAX_STEPS = 100;

float sdSphere(vec3 p, float s) { return length(p) - s; }
float sdBox(vec3 p, vec3 b) { vec3 q = abs(p) - b; return length(max(q,0.0)) + min(max(q.x,max(q.y,q.z)),0.0); }

float getDist(vec3 p) {
    if (pc.flags.x == 0) return sdSphere(p, 1.2);
    if (pc.flags.x == 1) return sdBox(p, vec3(0.9));
    return sdBox(p, vec3(1.5, 0.05, 1.5));
}

vec3 getNormal(vec3 p) {
    float d = getDist(p); vec2 e = vec2(0.001, 0);
    vec3 n = d - vec3(getDist(p-e.xyy), getDist(p-e.yxy), getDist(p-e.yyx));
    return normalize(n);
}

vec2 getUV(vec3 p, vec3 n) {
    vec3 localN = normalize(n);
    vec2 scale = pc.uvScale_triSc.xy;
    
    if (pc.flags.x == 0) return vec2(atan(localN.z, localN.x)/(2.0*3.14159) + 0.5, asin(localN.y)/3.14159 + 0.5) * scale;
    if (pc.flags.x == 1) {
        vec3 a = abs(localN);
        if (a.x > a.y && a.x > a.z) return p.yz * scale * 0.5 + 0.5;
        if (a.y > a.x && a.y > a.z) return p.xz * scale * 0.5 + 0.5;
        return p.xy * scale * 0.5 + 0.5;
    }
    return p.xz * scale * 0.5 + 0.5;
}

vec3 fresnelSchlick(float cosT, vec3 F0) { return F0 + (1.0 - F0) * pow(clamp(1.0 - cosT, 0.0, 1.0), 5.0); }
float DistributionGGX(vec3 N, vec3 H, float r) { float a=r*r; float a2=a*a; float NdH=max(dot(N,H),0.0); return a2/(3.14159*pow(NdH*NdH*(a2-1.0)+1.0,2.0)); }
float GeometrySchlickGGX(float NdV, float r) { float k=pow(r+1.0,2.0)/8.0; return NdV/(NdV*(1.0-k)+k); }
float GeometrySmith(vec3 N, vec3 V, vec3 L, float r) { return GeometrySchlickGGX(max(dot(N,V),0.0),r) * GeometrySchlickGGX(max(dot(N,L),0.0),r); }

vec4 sampleTex(sampler2D tex, vec3 p, vec3 n, vec2 uv, bool useTri, bool repTex) {
    if(useTri) {
        vec3 bf = abs(n);
        bf = max(bf - 0.2, 0.0);
        bf /= dot(bf, vec3(1.0));
        float s = pc.uvScale_triSc.z;
        vec2 uvX = p.zy * s; vec2 uvY = p.xz * s; vec2 uvZ = p.xy * s;
        if (!repTex) {
            uvX = clamp(uvX, 0.0, 1.0);
            uvY = clamp(uvY, 0.0, 1.0);
            uvZ = clamp(uvZ, 0.0, 1.0);
        }
        vec4 tx = texture(tex, uvX);
        vec4 ty = texture(tex, uvY);
        vec4 tz = texture(tex, uvZ);
        return tx*bf.x + ty*bf.y + tz*bf.z;
    }
    vec2 finalUV = repTex ? uv : clamp(uv, 0.0, 1.0);
    return texture(tex, finalUV);
}

vec2 getSphericalUV(vec3 v) {
    vec2 uv = vec2(atan(v.z, v.x), asin(v.y));
    uv *= vec2(0.1591549, 0.3183098);
    return uv + 0.5;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy); ivec2 size = imageSize(outImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) / vec2(size)) * 2.0 - 1.0;
    uv.y = -uv.y; // Flip Y for Vulkan
    
    vec3 ro = pc.camPos_time.xyz;
    vec3 fwd = normalize(-ro);
    vec3 right = normalize(cross(vec3(0,1,0), fwd));
    if(length(right) < 0.01) right = vec3(1,0,0);
    vec3 up = cross(fwd, right);
    vec3 rd = normalize(fwd + uv.x * right * 0.414 + uv.y * up * 0.414);

    float dO = 0.0;
    for(int i=0; i<MAX_STEPS; i++) { vec3 p = ro + rd*dO; float dS = getDist(p); dO += dS; if(dO>MAX_DIST || dS<SURF_DIST) break; }

    vec3 color = vec3(0.06, 0.06, 0.08); // Dark UI background

    if(dO < MAX_DIST) {
        vec3 p = ro + rd * dO; vec3 n = getNormal(p); vec2 texUV = getUV(p, n);
        
        bool hasAlb = (pc.flags.y & 1) != 0;
        bool hasORM = (pc.flags.y & 2) != 0;
        bool hasNrm = (pc.flags.y & 4) != 0;
        bool isTrn  = (pc.flags.y & 8) != 0;
        bool useTri = (pc.flags.y & 16) != 0;
        bool repTex = (pc.flags.y & 32) != 0;

        vec3 albedo = pc.albedoColor.rgb; float alpha = pc.albedoColor.a;
        if(hasAlb) {
            vec4 aa = sampleTex(texAlbedo, p, n, texUV, useTri, repTex);
            albedo *= aa.rgb; alpha *= aa.a;
        }
        
        float metallic = pc.matParams.x; float roughness = pc.matParams.y; float ao = 1.0;
        if (hasORM) {
            vec3 orm = sampleTex(texORM, p, n, texUV, useTri, repTex).rgb;
            ao *= orm.r; roughness *= orm.g; metallic *= orm.b;
        }
        
        vec3 emissive = pc.emissiveColor.rgb * pc.emissiveColor.w;

        if(hasNrm) {
            vec3 rgb = sampleTex(texNormal, p, n, texUV, useTri, repTex).rgb;
            vec2 xy = rgb.xy * 2.0 - 1.0;
            xy *= pc.matParams.z;
            vec3 tNormal = vec3(xy, sqrt(max(1.0 - dot(xy, xy), 0.0)));
            vec3 up = abs(n.y)<0.999 ? vec3(0,1,0) : vec3(1,0,0); vec3 t = normalize(cross(up, n)); vec3 b = cross(n, t);
            n = normalize(mat3(t, b, n) * tNormal);
        }

        vec3 V = normalize(-rd);
        
        // Image-Based Lighting Ambient (Используем Lod для устранения шума от HDRI)
        vec3 envDiff = textureLod(texHDR, getSphericalUV(n), 8.0).rgb;
        vec3 envSpec = textureLod(texHDR, getSphericalUV(reflect(-V, n)), roughness * 8.0).rgb;

        vec3 F0 = mix(vec3(0.04), albedo, metallic);
        vec3 kD = (vec3(1.0) - fresnelSchlick(max(dot(n, V), 0.0), F0)) * (1.0 - metallic);
        
        vec3 ambient = (kD * albedo * envDiff + envSpec * F0) * ao;

        // Sun Light
        vec3 sunDir = normalize(vec3(sin(pc.camPos_time.w), 0.5, cos(pc.camPos_time.w)));
        vec3 Ls = sunDir; vec3 Hs = normalize(V + Ls);
        vec3 radS = vec3(5.0); // Sun intensity
        
        float NdotL = max(dot(n, Ls), 0.0);
        vec3 spec = (DistributionGGX(n, Hs, roughness) * GeometrySmith(n, V, Ls, roughness) * fresnelSchlick(max(dot(Hs, V), 0.0), F0)) / (4.0 * max(dot(n, V), 0.0) * NdotL + 0.0001);
        vec3 Lo = (kD * albedo / 3.14159 + spec) * radS * NdotL;
        
        vec3 finalColor = ambient + Lo + emissive;
        
        if (isTrn) {
            // Настоящее полупрозрачное смешивание (alpha blending)
            color = mix(color, finalColor, alpha);
        } else {
            if (alpha >= 0.5) {
                color = finalColor;
            }
        }
    }
    
    color = color / (color + vec3(1.0)); // Simple ACES/Reinhard
    color = pow(color, vec3(1.0/2.2));   // Gamma
    imageStore(outImage, pixel, vec4(color, 1.0));
}
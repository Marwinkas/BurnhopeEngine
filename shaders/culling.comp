#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
struct ObjectData {
    mat4 modelMatrix;
    uint materialID;
    uint pad0;
    uint64_t vertexBufferAddress;
    uint64_t indexBufferAddress;
    uint64_t pad1; // ДОБАВИТЬ
};
struct SubMeshInfo {
    vec3  aabbMin;
    float boundingRadius;
    vec3  aabbMax;
    uint  lodCount;          
    uint  indexCounts[4];    
    uint  firstIndices[4];   
    uint  materialIndex;
    uint  pad1, pad2, pad3;
};
struct DrawCommand {
    uint indexCount;
    uint instanceCount; 
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};
layout(std430, set = 0, binding = 0) readonly buffer ObjectBuffer {
    ObjectData objects[];
};
layout(std430, set = 0, binding = 1) readonly buffer SubMeshBuffer {
    SubMeshInfo subMeshes[];
};
layout(std430, set = 0, binding = 2) buffer DrawCommandBuffer {
    DrawCommand drawCommands[];
};
layout(set = 0, binding = 3) uniform sampler2D hiZBuffer; 
layout(push_constant) uniform CullPushConstants {
    mat4  viewProj;
    vec4  frustumPlanes[6];
    vec3  camPos;      
    uint  objectCount;
    float zNear;
} push;
bool isVisible(vec3 worldMin, vec3 worldMax) {
    for (int i = 0; i < 6; i++) {
        vec3 n = push.frustumPlanes[i].xyz;
        float d = push.frustumPlanes[i].w;
        vec3 positiveVertex = vec3(
            n.x >= 0.0 ? worldMax.x : worldMin.x,
            n.y >= 0.0 ? worldMax.y : worldMin.y,
            n.z >= 0.0 ? worldMax.z : worldMin.z
        );
        if (dot(n, positiveVertex) + d < 0.0) return false;
    }
    return true;
}
bool isOccluded(vec3 corners[8]) {
    vec2 minXY = vec2(1.0);
    vec2 maxXY = vec2(0.0);
    float minZ = 1.0;
    for(int i = 0; i < 8; i++) {
        vec4 clip = push.viewProj * vec4(corners[i], 1.0);
        if (clip.w <= 0.0) return false; 
        vec3 ndc = clip.xyz / clip.w;
        vec2 uv = ndc.xy * 0.5 + 0.5; 
        minXY = min(minXY, uv);
        maxXY = max(maxXY, uv);
        minZ = min(minZ, ndc.z); 
    }
    if (minXY.x > 1.0 || maxXY.x < 0.0 || minXY.y > 1.0 || maxXY.y < 0.0) return true;
    minXY = clamp(minXY, 0.0, 1.0);
    maxXY = clamp(maxXY, 0.0, 1.0);
    vec2 size = (maxXY - minXY) * vec2(textureSize(hiZBuffer, 0));
    float lod = ceil(log2(max(size.x, size.y)));
    lod = max(0.0, lod + 1.0); 
    float d1 = textureLod(hiZBuffer, vec2(minXY.x, minXY.y), lod).r;
    float d2 = textureLod(hiZBuffer, vec2(maxXY.x, minXY.y), lod).r;
    float d3 = textureLod(hiZBuffer, vec2(minXY.x, maxXY.y), lod).r;
    float d4 = textureLod(hiZBuffer, vec2(maxXY.x, maxXY.y), lod).r;
    float maxZ = max(max(d1, d2), max(d3, d4));
    return minZ > maxZ; 
}
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= push.objectCount) return;
    SubMeshInfo sub = subMeshes[idx];
    ObjectData  obj = objects[idx];
    vec3 corners[8];
    corners[0] = (obj.modelMatrix * vec4(sub.aabbMin.x, sub.aabbMin.y, sub.aabbMin.z, 1.0)).xyz;
    corners[1] = (obj.modelMatrix * vec4(sub.aabbMax.x, sub.aabbMin.y, sub.aabbMin.z, 1.0)).xyz;
    corners[2] = (obj.modelMatrix * vec4(sub.aabbMin.x, sub.aabbMax.y, sub.aabbMin.z, 1.0)).xyz;
    corners[3] = (obj.modelMatrix * vec4(sub.aabbMax.x, sub.aabbMax.y, sub.aabbMin.z, 1.0)).xyz;
    corners[4] = (obj.modelMatrix * vec4(sub.aabbMin.x, sub.aabbMin.y, sub.aabbMax.z, 1.0)).xyz;
    corners[5] = (obj.modelMatrix * vec4(sub.aabbMax.x, sub.aabbMin.y, sub.aabbMax.z, 1.0)).xyz;
    corners[6] = (obj.modelMatrix * vec4(sub.aabbMin.x, sub.aabbMax.y, sub.aabbMax.z, 1.0)).xyz;
    corners[7] = (obj.modelMatrix * vec4(sub.aabbMax.x, sub.aabbMax.y, sub.aabbMax.z, 1.0)).xyz;
    vec3 worldMin = corners[0], worldMax = corners[0];
    for (int i = 1; i < 8; i++) {
        worldMin = min(worldMin, corners[i]);
        worldMax = max(worldMax, corners[i]);
    }
    
    bool visible = isVisible(worldMin, worldMax);
    if (visible) {
        visible = !isOccluded(corners);
    }

    uint drawIdx = idx; 
uint selectedLod = 0;
    if (visible) {
        vec3 center = (worldMin + worldMax) * 0.5;
        float dist = distance(push.camPos, center);
        if (dist > 20.0) selectedLod = 1;
        if (dist > 50.0) selectedLod = 2;
        if (dist > 100.0) selectedLod = 3;
        selectedLod = min(selectedLod, sub.lodCount - 1);
    }
    drawCommands[drawIdx].indexCount    = visible ? sub.indexCounts[selectedLod] : 0;
    drawCommands[drawIdx].instanceCount = visible ? 1 : 0;
    drawCommands[drawIdx].firstIndex    = sub.firstIndices[selectedLod];
    drawCommands[drawIdx].vertexOffset  = 0;
    drawCommands[drawIdx].firstInstance = drawIdx;
}
#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_buffer_reference2 : require
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

struct TaskPayload {
    uint objectID;
    uint firstIndex;
    uint lodTriCount;
};
taskPayloadSharedEXT TaskPayload payload;

struct ObjectData {
    mat4 modelMatrix;
    uint materialID;
    uint indexCount;
    uint vrsRate;
    uint boneOffset;
    uint64_t posBufferAddress;
    uint64_t attrBufferAddress;
    uint64_t indexBufferAddress;
    uint64_t colorBufferAddress;
    uint64_t uv2BufferAddress;
    uint64_t animBufferAddress;
    vec4 aabbMin;
    vec4 aabbMax;
};



layout(std430, set = 1, binding = 0) readonly buffer ObjectBuffer {
    ObjectData objects[];
};
layout(set = 1, binding = 2) uniform sampler2D hiZBuffer;

layout(set = 0, binding = 0) uniform GlobalSceneUbo {
    mat4 projection; mat4 invViewProj; mat4 view; vec3 camPos; float zNear;
    vec3 sunDir; float zFar; vec4 screenSize;
} ubo;

shared uint sharedMeshGroups;

bool isVisible(uint objIdx) {
    ObjectData obj = objects[objIdx];
    vec3 aabbMin = obj.aabbMin.xyz;
    vec3 aabbMax = obj.aabbMax.xyz;

    vec3 corners[8];
    corners[0] = (obj.modelMatrix * vec4(aabbMin.x, aabbMin.y, aabbMin.z, 1.0)).xyz;
    corners[1] = (obj.modelMatrix * vec4(aabbMax.x, aabbMin.y, aabbMin.z, 1.0)).xyz;
    corners[2] = (obj.modelMatrix * vec4(aabbMin.x, aabbMax.y, aabbMin.z, 1.0)).xyz;
    corners[3] = (obj.modelMatrix * vec4(aabbMax.x, aabbMax.y, aabbMin.z, 1.0)).xyz;
    corners[4] = (obj.modelMatrix * vec4(aabbMin.x, aabbMin.y, aabbMax.z, 1.0)).xyz;
    corners[5] = (obj.modelMatrix * vec4(aabbMax.x, aabbMin.y, aabbMax.z, 1.0)).xyz;
    corners[6] = (obj.modelMatrix * vec4(aabbMin.x, aabbMax.y, aabbMax.z, 1.0)).xyz;
    corners[7] = (obj.modelMatrix * vec4(aabbMax.x, aabbMax.y, aabbMax.z, 1.0)).xyz;

    vec2 minXY = vec2(1.0); vec2 maxXY = vec2(0.0); float minZ = 1.0;
    mat4 viewProj = ubo.projection * ubo.view;

    for(int i = 0; i < 8; i++) {
        vec4 clip = viewProj * vec4(corners[i], 1.0);
        if (clip.w > 0.0) {
            vec3 ndc = clip.xyz / clip.w;
            vec2 uv = ndc.xy * 0.5 + 0.5; 
            minXY = min(minXY, uv); maxXY = max(maxXY, uv); minZ = min(minZ, ndc.z); 
        } else {
            return true;
        }
    }

    if (minXY.x > 1.0 || maxXY.x < 0.0 || minXY.y > 1.0 || maxXY.y < 0.0 || minZ > 1.0) return false;

    minXY = clamp(minXY, 0.0, 1.0); maxXY = clamp(maxXY, 0.0, 1.0);
    vec2 size = (maxXY - minXY) * vec2(textureSize(hiZBuffer, 0));
    float lod = max(0.0, ceil(log2(max(size.x, size.y))) + 1.0); 

    float d1 = textureLod(hiZBuffer, vec2(minXY.x, minXY.y), lod).r;
    float d2 = textureLod(hiZBuffer, vec2(maxXY.x, minXY.y), lod).r;
    float d3 = textureLod(hiZBuffer, vec2(minXY.x, maxXY.y), lod).r;
    float d4 = textureLod(hiZBuffer, vec2(maxXY.x, maxXY.y), lod).r;
    return minZ <= max(max(d1, d2), max(d3, d4)); 
}

void main() {
    uint objIdx = gl_WorkGroupID.x;
    
    if (gl_LocalInvocationID.x == 0) {
        bool visible = isVisible(objIdx);
        uint triCount = 0;
        uint firstIdx = 0;
        
        if (visible) {
            ObjectData obj = objects[objIdx];
            triCount = obj.indexCount / 3;
            firstIdx = 0; 
        }
        
        payload.objectID = objIdx;
        payload.firstIndex = firstIdx;
        payload.lodTriCount = triCount;
        sharedMeshGroups = (triCount + 84) / 85; 
    }
    
    barrier();
    EmitMeshTasksEXT(sharedMeshGroups, 1, 1);
}

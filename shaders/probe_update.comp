layout(set = 1, binding = 0) uniform sampler2D gNormalRoughness;
layout(set = 1, binding = 1) uniform sampler2D gAlbedoMetallic;
layout(set = 1, binding = 2) uniform sampler2D gHeightAO;
layout(set = 1, binding = 3) uniform sampler2D gDepth;

layout(set = 2, binding = 0, rgba16f) uniform image2D outProbe;
layout(set = 2, binding = 1) uniform sampler2D inLighting; 

layout(set = 3, binding = 0) uniform accelerationStructureEXT tlas;

struct Vertex {
    vec3 position;
    uint normal;
    uint texUV;
    uint tangent;
};
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer VertexBuffer { Vertex v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer IndexBuffer  { uint i[]; }; 

struct ObjectData {
    mat4 modelMatrix;
    uint materialID;
    uint indexCount;
    uint pad[2];
    uint64_t vertexBufferAddress;
    uint64_t indexBufferAddress;
    vec4 aabbMin;
    vec4 aabbMax;
};

struct MaterialData {
    int albedoAlphaIdx; int normalIdx; int ormxIdx; int emissiveIdx;
    int useTriplanar; int isTransparent; int repeatTexture; int pad1;
    
    vec2 uvScale; float triplanarScale; float emissiveIntensity;
    
    vec4 albedoColor;
    vec4 emissiveColor;

    float metallicStrength;
    float roughnessStrength;
    float normalStrength;
    float heightStrength;

    float aoStrength;
    float pad2; float pad3; float pad4;
};

layout(set = 4, binding = 0, scalar) readonly buffer ObjectBuffer { ObjectData objects[]; } objBuf;
layout(set = 4, binding = 1, scalar) readonly buffer MaterialBuffer { MaterialData materials[]; } matBuf;

// Bindless текстуры
layout(set = 5, binding = 0) uniform sampler2D bindlessTextures[];

layout(push_constant) uniform RC {
    vec4  probeGridMin;
    vec4  probeGridMax;
    ivec4 probeCount; 
    vec4  params;     
} rc;

vec3 unpackNormal(uint n) {
    vec3 norm;
    norm.x = float(n & 0x3FF) / 1023.0 * 2.0 - 1.0;
    norm.y = float((n >> 10) & 0x3FF) / 1023.0 * 2.0 - 1.0;
    norm.z = float((n >> 20) & 0x3FF) / 1023.0 * 2.0 - 1.0;
    return normalize(norm);
}

vec2 unpackUV(uint uvPacked) {
    return unpackHalf2x16(uvPacked);
}

// Декодирование направления луча из октаэдра
vec3 octaDecode(vec2 uv) {
    uv = uv * 2.0 - 1.0;
    vec3 v = vec3(uv.x, uv.y, 1.0 - abs(uv.x) - abs(uv.y));
    if (v.z < 0.0) v.xy = (1.0 - abs(v.yx)) * sign(v.xy);
    return normalize(v);
}

// Полезная функция для защиты от математического мусора
bool isNaN(float val) {
    return (val < 0.0 || 0.0 < val || val == 0.0) ? false : true;
}
bool isAnyNaN(vec3 v) {
    return isNaN(v.x) || isNaN(v.y) || isNaN(v.z);
}

vec3 CalculateSky(vec3 viewDir) {
    float t = max(viewDir.y, 0.0);
    vec3 skyColor = mix(ubo.skyHorizonColor.rgb, ubo.skyZenithColor.rgb, pow(t, 0.5));
    if (ubo.fogParams.x > 0.5) {
        skyColor = mix(ubo.fogColor.rgb, skyColor, pow(t, 0.5));
    }
    float sunDot = dot(viewDir, -ubo.sunDir);
    float sunSize = ubo.skySunParams.x;
    float sunGlow = ubo.skySunParams.y;
    float sunGlowSize = max(ubo.skySunParams.z, 0.001);
    float sunDisk = smoothstep(1.0 - sunSize - 0.001, 1.0 - sunSize, sunDot);
    float sunAura = pow(max(sunDot, 0.0), 1.0 / sunGlowSize) * sunGlow;
    vec3 sunRenderColor = ubo.sunColor * ubo.sunIntensity;
    skyColor += sunRenderColor * sunDisk;
    skyColor += sunRenderColor * sunAura * 0.1;
    return skyColor;
}

vec3 EvaluateHit(int objIndex, int primID, vec2 bary, vec3 hitPos) {
    ObjectData obj = objBuf.objects[objIndex];
    
    IndexBuffer indices = IndexBuffer(obj.indexBufferAddress);
    VertexBuffer vertices = VertexBuffer(obj.vertexBufferAddress);
    
    uint i0 = indices.i[primID * 3 + 0];
    uint i1 = indices.i[primID * 3 + 1];
    uint i2 = indices.i[primID * 3 + 2];
    
    Vertex v0_raw = vertices.v[i0];
    Vertex v1_raw = vertices.v[i1];
    Vertex v2_raw = vertices.v[i2];
    
    float u = bary.x;
    float v = bary.y;
    float w = clamp(1.0 - u - v, 0.0, 1.0); // Защита от выхода за пределы
    
    vec2 finalUV = unpackUV(v0_raw.texUV) * w + unpackUV(v1_raw.texUV) * u + unpackUV(v2_raw.texUV) * v;
    vec3 localNormal = unpackNormal(v0_raw.normal) * w + unpackNormal(v1_raw.normal) * u + unpackNormal(v2_raw.normal) * v;
    
    mat3 normalMatrix = transpose(inverse(mat3(obj.modelMatrix)));
    vec3 worldNormal = normalize(normalMatrix * localNormal);
    
    MaterialData mat = matBuf.materials[obj.materialID];
    
const float PI = 3.14159265359;

    // 1. vec3(1.0) - это идеально белый (как снег). Серый - это 0.5 или 0.8
    vec3 albedo = vec3(0.8); 
    float hitAO = mat.aoStrength;
    if (mat.albedoAlphaIdx >= 0) {
        albedo = textureLod(bindlessTextures[nonuniformEXT(mat.albedoAlphaIdx)], finalUV * mat.uvScale, 0.0).rgb * mat.albedoColor.rgb;
    } else {
        albedo = mat.albedoColor.rgb;
    }
    if (mat.ormxIdx >= 0) {
        vec4 ormx = textureLod(bindlessTextures[nonuniformEXT(mat.ormxIdx)], finalUV * mat.uvScale, 0.0);
        hitAO *= ormx.r;
    }

    vec3 L = normalize(-ubo.sunDir); 
    float NdotL = max(0.0, dot(worldNormal, L));
    
    // ПУСКАЕМ ТЕНЕВОЙ ЛУЧ К СОЛНЦУ
    float shadow = 1.0; 
    if (NdotL > 0.0) {
        rayQueryEXT shadowQuery;
        vec3 shadowOrigin = hitPos + worldNormal * 0.05; 
        rayQueryInitializeEXT(shadowQuery, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu, shadowOrigin, 0.05, L, 1000.0);

        while(rayQueryProceedEXT(shadowQuery)) {}
        
        if (rayQueryGetIntersectionTypeEXT(shadowQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            shadow = 0.0; 
        }
    }
    
    // 2. Полностью убираем фейковый эмбиент из GI! 
    // Если объект в глухой тени (в коробке), он не должен светиться сам по себе.
    // Настоящий свет неба придет сюда через лучи, вылетевшие наружу!
    
    vec3 actualSunRadiance = ubo.sunColor * ubo.sunIntensity;
    
    // 3. ФИЗИЧЕСКИ КОРРЕКТНЫЙ РАСЧЕТ (Делим albedo на PI)
    vec3 directLight = (albedo / PI) * actualSunRadiance * NdotL * shadow * mix(1.0, hitAO, 0.3);
    
    vec3 finalColor = directLight;
    
    if (isAnyNaN(finalColor)) return vec3(0.0);
    return finalColor;
}

vec4 rtRaymarch(vec3 origin, vec3 dir, float rayLen) {
    rayQueryEXT rayQuery;
   rayQueryInitializeEXT(rayQuery, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, origin, 0.05, dir, rayLen);
    while(rayQueryProceedEXT(rayQuery)) {}

    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        int instanceID = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
        int geomID = rayQueryGetIntersectionGeometryIndexEXT(rayQuery, true);
        int primID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);
        vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
        
        float t = rayQueryGetIntersectionTEXT(rayQuery, true);
        vec3 hitPos = origin + dir * t;
        
        int objIndex = instanceID + geomID;
        vec3 hitColor = EvaluateHit(objIndex, primID, barycentrics, hitPos);
        return vec4(hitColor, 1.0);
    }

    // ПРОМАХ (Луч ни во что не врезался).
    // Мы рисуем небо ТОЛЬКО на самом последнем (самом длинном) каскаде!
    // Иначе короткие лучи будут плюсовать небо на каждом шаге, и вся комната станет синей и яркой.
    if (rc.params.y > 0.5) {
        return vec4(CalculateSky(dir), 0.0);
    }
    return vec4(0.0); 
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 probeTexSize = imageSize(outProbe);
    if (pixel.x >= probeTexSize.x || pixel.y >= probeTexSize.y) return;

    int octaSize = int(rc.params.w);
    ivec3 pCount = rc.probeCount.xyz;
    
    int probeIdxX  = pixel.x / octaSize;
    int probeIdxYZ = pixel.y / octaSize;
    int probeIdxY  = probeIdxYZ % pCount.y;
    int probeIdxZ  = probeIdxYZ / pCount.y;

    if (probeIdxX >= pCount.x || probeIdxZ >= pCount.z) return;

    vec3 gridSize = rc.probeGridMax.xyz - rc.probeGridMin.xyz;
    vec3 probePos = rc.probeGridMin.xyz + gridSize * (vec3(probeIdxX, probeIdxY, probeIdxZ) + 0.5) / vec3(pCount);

    float jitter = fract(sin(dot(vec3(probeIdxX, probeIdxY, probeIdxZ), vec3(12.9898, 78.233, 45.164))) * 43758.5453);
    
    vec2 localUV = (vec2(pixel % octaSize) + 0.5) / float(octaSize);
    vec3 rayDir = octaDecode(localUV);
    float startOffset = (rc.probeCount.w > 0) ? rc.params.x * 0.5 : 0.0;
    float currentRange = rc.params.x - startOffset;

    vec4 result = rtRaymarch(probePos + rayDir * startOffset, rayDir, currentRange);
    
    imageStore(outProbe, pixel, result);
}
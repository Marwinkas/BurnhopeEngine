#version 460
#extension GL_EXT_shader_atomic_float : enable
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalSceneUbo {
    mat4 projection; mat4 invViewProj; mat4 view; vec3 camPos; float zNear;
    vec3 sunDir; float zFar; vec4 screenSize; mat4 sunLightSpaceMatrices[4];
    vec4 cascadeSplits; uint gridDimX; uint gridDimY; uint gridDimZ;
    float lightSize; vec3 sunColor; float sunIntensity;
    vec4 sscsParams;
    vec4 gtaoParams;
    vec4 fogParams;
    vec4 fogColor;
    vec4 inscatterColor;
    vec4 skyZenithColor;
    vec4 skyHorizonColor;
    vec4 skySunParams;
    vec4 ssgiParams;
    vec4 rtParams;
} ubo;

layout(set = 1, binding = 0) uniform accelerationStructureEXT tlas;

struct Vertex { vec3 position; vec3 normal; vec2 texUV; vec3 tangent; vec3 bitangent; };
layout(buffer_reference, scalar) readonly buffer VertexBuffer { Vertex v[]; };
layout(buffer_reference, scalar) readonly buffer IndexBuffer  { uint i[]; };

struct ObjectData {
    mat4 modelMatrix; uint materialID; uint pad0;
    uint64_t vertexBufferAddress; uint64_t indexBufferAddress; uint64_t pad1;
};

struct MaterialData {
    int albedoIdx; int normalIdx; int heightIdx; int metallicIdx;
    int roughnessIdx; int aoIdx; int emissiveIdx; int hasAlbedo;
    
    int hasNormal; int hasHeight; int hasMetallic; int hasRoughness;
    int hasAO; int hasEmissive; int useTriplanar; float triplanarScale;
    
    vec2 uvScale; float emissiveIntensity; int useORM;
    
    vec4 albedoColor;
    vec4 emissiveColor;

    float metallicStrength;
    float roughnessStrength;
    float normalStrength;
    float heightStrength;

    float aoStrength;
    int repeatTexture;
    int pad1;
    int pad2;
};


layout(set = 2, binding = 0, scalar) readonly buffer ObjectBuffer { ObjectData objects[]; } objBuf;
layout(set = 2, binding = 1, scalar) readonly buffer MaterialBuffer { MaterialData materials[]; } matBuf;
layout(set = 3, binding = 0) uniform sampler2D bindlessTextures[];
layout(set = 4, binding = 0, rgba16f) uniform writeonly image2D outProbeTex;

layout(push_constant) uniform Push {
    vec4 probePos;
    int resolution;
} push;

vec3 octaDecode(vec2 uv) {
    uv = uv * 2.0 - 1.0;
    vec3 v = vec3(uv.x, uv.y, 1.0 - abs(uv.x) - abs(uv.y));
    if (v.z < 0.0) v.xy = (1.0 - abs(v.yx)) * sign(v.xy);
    return normalize(v);
}

vec3 CalculateSky(vec3 viewDir) {
    float t = max(viewDir.y, 0.0);
    vec3 skyColor = mix(ubo.skyHorizonColor.rgb, ubo.skyZenithColor.rgb, pow(t, 0.5));
    if (ubo.fogParams.x > 0.5) {
        skyColor = mix(ubo.fogColor.rgb, skyColor, pow(t, 0.5));
    }
    float sunDot = dot(viewDir, -ubo.sunDir);
    float sunSize = ubo.skySunParams.x;
    float sunGlow = ubo.skySunParams.y;
    float sunGlowSize = max(ubo.skySunParams.z, 0.001);
    float sunDisk = smoothstep(1.0 - sunSize - 0.001, 1.0 - sunSize, sunDot);
    float sunAura = pow(max(sunDot, 0.0), 1.0 / sunGlowSize) * sunGlow;
    vec3 sunRenderColor = ubo.sunColor * ubo.sunIntensity;
    skyColor += sunRenderColor * sunDisk;
    skyColor += sunRenderColor * sunAura * 0.1;
    return skyColor;
}

const float PI = 3.14159265359;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= push.resolution || pixel.y >= push.resolution) return;

    vec2 uv = (vec2(pixel) + 0.5) / float(push.resolution);
    vec3 dir = octaDecode(uv);

    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, push.probePos.xyz, 0.05, dir, 1000.0);
    while(rayQueryProceedEXT(rayQuery)) {}

    vec3 color = vec3(0.0);
    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        int instanceID = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
        int geomID = rayQueryGetIntersectionGeometryIndexEXT(rayQuery, true);
        int primID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);
        vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
        
        float u = barycentrics.x;
        float v = barycentrics.y;
        float w = 1.0 - u - v;

        ObjectData obj = objBuf.objects[instanceID + geomID];
        MaterialData mat = matBuf.materials[obj.materialID];
        vec3 albedo = vec3(0.8);
        
        IndexBuffer indices = IndexBuffer(obj.indexBufferAddress);
        VertexBuffer vertices = VertexBuffer(obj.vertexBufferAddress);
        Vertex v0 = vertices.v[indices.i[primID * 3 + 0]];
        Vertex v1 = vertices.v[indices.i[primID * 3 + 1]];
        Vertex v2 = vertices.v[indices.i[primID * 3 + 2]];
        
        vec2 texUV = v0.texUV * w + v1.texUV * u + v2.texUV * v;
        vec3 localNormal = v0.normal * w + v1.normal * u + v2.normal * v;
        mat3 normalMatrix = transpose(inverse(mat3(obj.modelMatrix)));
        vec3 worldNormal = normalize(normalMatrix * localNormal);
        if (dot(worldNormal, dir) > 0.0) worldNormal = -worldNormal; // Двусторонняя геометрия

        if (mat.hasAlbedo == 1 && mat.albedoIdx >= 0) {
            albedo = textureLod(bindlessTextures[nonuniformEXT(mat.albedoIdx)], texUV * mat.uvScale, 0.0).rgb;
        }
        
        vec3 L = normalize(-ubo.sunDir);
        float NdotL = max(dot(worldNormal, L), 0.0);
        float shadow = 1.0;
        if (NdotL > 0.0) {
            float t = rayQueryGetIntersectionTEXT(rayQuery, true);
            vec3 hitPos = push.probePos.xyz + dir * t;
            rayQueryEXT shadowQuery;
            rayQueryInitializeEXT(shadowQuery, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu, hitPos + worldNormal * 0.02 + L * 0.02, 0.01, L, 1000.0);
            while(rayQueryProceedEXT(shadowQuery)) {}
            if (rayQueryGetIntersectionTypeEXT(shadowQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
                shadow = 0.0;
            }
        }
        
        // Реалистичный мягкий Ambient от неба для запекания
        vec3 skyAmbient = mix(ubo.skyHorizonColor.rgb, ubo.skyZenithColor.rgb, max(0.0, worldNormal.y)) * ubo.sunIntensity * 0.2;
        color = (albedo / PI) * ubo.sunColor * ubo.sunIntensity * (NdotL * shadow) + albedo * skyAmbient;
    } else {
        color = CalculateSky(dir);
    }

    imageStore(outProbeTex, pixel, vec4(color, 1.0));
}
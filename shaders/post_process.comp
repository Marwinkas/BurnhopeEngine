};

vec3 ApplyCDL(vec3 c, vec4 lift, vec4 gamma, vec4 gain, vec4 offset) {
    c = c * gain.rgb + offset.rgb;
    c = c + lift.rgb * clamp(vec3(1.0) - c, 0.0, 1.0);
    c = pow(max(c, vec3(0.0001)), gamma.rgb);
    return c;
}

vec3 isolateBright(vec3 c, float thresh) {
    float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
    float contribution = max(0.0, luma - thresh);
    contribution /= max(luma, 0.00001);
    return min(c * contribution, vec3(5.0)); // Clamp maximum brightness
}

// RGB to HSV
vec3 rgb2hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

// HSV to RGB
vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

// Правильное физическое искажение линзы (Barrel Distortion)
vec2 distCoords(vec2 uv, float strength) {
    vec2 d = uv - 0.5;
    float r2 = dot(d, d);
    return uv + d * (strength * r2);
}

vec3 ReadRawColor(vec2 uv) {
    return textureLod(hdrInput, uv, 0.0).rgb;
}

vec3 ReadColor(vec2 uv) {
    vec3 c;
    if (ubo.ppVignetteGrain.w > 0.0) { // Chromatic Aberration
        float ca = ubo.ppVignetteGrain.w;
        float dist = length(uv - 0.5);
        vec2 offset = (uv - 0.5) * ca * dist;
        c.r = ReadRawColor(uv + offset).r;
        c.g = ReadRawColor(uv).g;
        c.b = ReadRawColor(uv - offset).b;
    } else {
        c = ReadRawColor(uv);
    }
    return c;
}

// Эффект картины маслом (Kuwahara Filter)
vec3 ApplyKuwahara(vec2 uv, int radius) {
    vec2 texel = 1.0 / ubo.screenSize.xy;
    int offsetsX[4][2] = {{-radius, 0}, {0, radius}, {-radius, 0}, {0, radius}};
    int offsetsY[4][2] = {{-radius, 0}, {-radius, 0}, {0, radius}, {0, radius}};
    
    float16_t minVar = float16_t(1e6);
    f16vec3 finalColor = f16vec3(0.0);
    
    for(int q = 0; q < 4; q++) {
        f16vec3 sum = f16vec3(0.0);
        f16vec3 sum2 = f16vec3(0.0);
        float16_t count = float16_t(0.0);
        
        for(int x = offsetsX[q][0]; x <= offsetsX[q][1]; x++) {
            for(int y = offsetsY[q][0]; y <= offsetsY[q][1]; y++) {
                f16vec3 c = f16vec3(ReadColor(uv + vec2(x, y) * texel));
                sum += c;
                sum2 += c * c;
                count += float16_t(1.0);
            }
        }
        f16vec3 mean = sum / count;
        f16vec3 variance = abs((sum2 / count) - (mean * mean));
        float16_t totalVar = variance.r + variance.g + variance.b;
        
        if(totalVar < minVar) {
            minVar = totalVar;
            finalColor = mean;
        }
    }
    return vec3(finalColor);
}

float hatch(vec2 uv, float angle, float scale, float thickness) {
    float s = sin(angle), c = cos(angle);
    vec2 rotatedUV = mat2(c, -s, s, c) * uv;
    return smoothstep(thickness - 0.1, thickness + 0.1, sin(rotatedUV.x * scale));
}

vec3 getEdge(vec2 pos, float w) {
    vec2 texel = w / ubo.screenSize.xy;
    vec3 s00 = textureLod(hdrInput, clamp(pos + vec2(-texel.x, -texel.y), 0.0, 1.0), 0.0).rgb;
    vec3 s10 = textureLod(hdrInput, clamp(pos + vec2(0.0, -texel.y), 0.0, 1.0), 0.0).rgb;
    vec3 s20 = textureLod(hdrInput, clamp(pos + vec2(texel.x, -texel.y), 0.0, 1.0), 0.0).rgb;
    vec3 s01 = textureLod(hdrInput, clamp(pos + vec2(-texel.x, 0.0), 0.0, 1.0), 0.0).rgb;
    vec3 s21 = textureLod(hdrInput, clamp(pos + vec2(texel.x, 0.0), 0.0, 1.0), 0.0).rgb;
    vec3 s02 = textureLod(hdrInput, clamp(pos + vec2(-texel.x, texel.y), 0.0, 1.0), 0.0).rgb;
    vec3 s12 = textureLod(hdrInput, clamp(pos + vec2(0.0, texel.y), 0.0, 1.0), 0.0).rgb;
    vec3 s22 = textureLod(hdrInput, clamp(pos + vec2(texel.x, texel.y), 0.0, 1.0), 0.0).rgb;
    vec3 gx = -s00 - 2.0*s01 - s02 + s20 + 2.0*s21 + s22;
    vec3 gy = -s00 - 2.0*s10 - s20 + s02 + 2.0*s12 + s22;
    return sqrt(gx*gx + gy*gy);
}

// Быстрый шум для Voronoi
vec3 voronoi(vec2 uv, float scale) {
    vec2 g = floor(uv * scale);
    vec2 f = fract(uv * scale);
    vec2 res = vec2(8.0);
    float hash = 0.0;
    for(int y=-1; y<=1; y++) {
        for(int x=-1; x<=1; x++) {
            vec2 lattice = vec2(x,y);
            // Вариант 1: Создаем вектор, используя разные смещения для X и Y
            float noiseX = fract(sin(dot(g + lattice, vec2(12.9898, 78.233))) * 43758.5453);
            float noiseY = fract(sin(dot(g + lattice, vec2(39.346, 11.135))) * 43758.5453);
            vec2 r = vec2(noiseX, noiseY);
            vec2 d = lattice + r - f;
            float dist = dot(d,d);
            if(dist < res.x) { res.y = res.x; res.x = dist; hash = noiseX; }
            else if(dist < res.y) { res.y = dist; }
        }
    }
    return vec3(res.x, res.y, hash);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(ubo.screenSize.x) || pixel.y >= int(ubo.screenSize.y)) return;
    vec2 uv = (vec2(pixel) + 0.5) / ubo.screenSize.xy;
    float rawD = textureLod(depthInput, uv, 0.0).r;

    // --- WORLD CURVATURE (Inception) ---
    if (ubo.ppCanvasInk.y > 0.5) {
        float curve = ubo.ppCanvasInk.z;
        uv.y -= (uv.x - 0.5) * (uv.x - 0.5) * curve; 
    }

    // --- ENVIRONMENT BREATHING ---
    if (ubo.ppCausticsBreath.y > 0.5) {
        float amp = ubo.ppCausticsBreath.z;
        float speed = ubo.ppCausticsBreath.w;
        float t = ubo.ppMotionBlur.z * speed;
        float breath = sin(t) * amp * 0.05;
        uv = (uv - 0.5) * (1.0 + breath) + 0.5;
    }
    
    // --- DROSTE EFFECT (Рекурсивный экран) ---
    if (ubo.ppReactDroste.w > 0.0) {
        float scale = ubo.ppReactDroste.w;
        vec2 dUV = uv - 0.5;
        if (length(dUV) > 0.0) uv = 0.5 + normalize(dUV) * exp(mod(log(length(dUV)), scale));
    }
    
    // --- SLIT SCAN ---
    if (ubo.ppPurkinjeSlit.w > 0.5) {
        float delay = uv.y * ubo.ppReactDroste.x;
        // Требуется массив истории или сильная зависимость от Motion Vectors. 
        // Эмуляция через волну:
        uv.x += sin(uv.y * 10.0 + ubo.ppMotionBlur.z * delay) * 0.05;
    }
    
    // --- ROLLING SHUTTER ---
    if (ubo.ppEctoRolling.w > 0.5) {
        vec4 ndc = vec4(uv * 2.0 - 1.0, rawD, 1.0);
        vec4 worldPos = ubo.invViewProj * ndc; worldPos /= worldPos.w;
        vec4 prevNdc = ubo.prevViewProj * worldPos; prevNdc /= prevNdc.w;
        vec2 velocity = uv - (prevNdc.xy * 0.5 + 0.5);
        uv -= velocity * uv.y * ubo.ppPurkinjeSlit.x * 50.0;
    }
    
    // --- GRAVITATIONAL LENSING ---
    if (ubo.ppPhosASCII.z > 0.5) {
        vec2 center = vec2(0.5);
        vec2 dir = uv - center;
        float dist = length(dir);
        if (dist > 0.01) {
            float bend = ubo.ppPhosASCII.w / dist;
            uv -= normalize(dir) * bend * 0.01;
        }
    }
    
    // --- SCREEN TEAR / GLITCH SLICE ---
    if (ubo.ppGlitch4.y > 0.5) {
        float t = ubo.ppMotionBlur.z * ubo.ppGlitch4.z; // Frequency
        float slice = step(0.95, fract(sin(floor(uv.y * 20.0 + t)) * 43758.5453));
        uv.x += slice * ubo.ppGlitch4.w * (fract(sin(t * 100.0)) - 0.5);
        uv = clamp(uv, 0.0, 1.0);
    }
    
    // --- ANALOG VIDEO NOISE (Horizontal Sync Loss) ---
    if (ubo.ppHatchAnalog.y > 0.5) {
        float syncLoss = ubo.ppHatchAnalog.z;
        float t = ubo.ppMotionBlur.z * 10.0;
        float wave = sin(uv.y * 5.0 + t) * sin(uv.y * 12.0 - t * 0.5);
        if (wave > 0.8) uv.x += (wave - 0.8) * syncLoss;
        uv.x = fract(uv.x); // Wrapping
    }
    
    // --- Fluid Dynamics (Navier-Stokes Advection Approximation) ---
    if (ubo.ppAfterBleed.w > 0.5 || ubo.ppPsych4.y > 0.0) {
        float vis = max(ubo.ppPsych4.y, ubo.ppFluidCMYK.x);
        vec4 ndc = vec4(uv * 2.0 - 1.0, rawD, 1.0);
        vec4 worldPos = ubo.invViewProj * ndc; worldPos /= worldPos.w;
        vec4 prevNdc = ubo.prevViewProj * worldPos; prevNdc /= prevNdc.w;
        vec2 velocity = (uv - (prevNdc.xy * 0.5 + 0.5));
        
        float t = ubo.ppMotionBlur.z * 0.5;
        vec2 curl = vec2(sin(uv.y * 15.0 + t), cos(uv.x * 15.0 - t));
        
        uv -= (velocity * vis + curl * 0.002 * vis) * 5.0;
    }

    // --- LENS BREATHING ---
    if (ubo.ppLens3.w > 0.5) {
        float focus = ubo.ppDoFParams.y;
        float breath = ubo.ppLens4.x;
        float scale = 1.0 - (1.0 / max(focus, 0.1)) * breath * 0.01;
        uv = (uv - 0.5) * scale + 0.5;
    }
        // --- VECTOR FIELD FLOW ---
    if (ubo.ppGravVector.x > 0.5) {
        int texIdx = int(ubo.ppTexIndices.x); 
        if (texIdx >= 0) {
            float scale = ubo.ppPsych8.y;
            // Тайлинг текстуры + анимация
            vec2 flow = textureLod(bindlessTextures[nonuniformEXT(texIdx)], uv * scale + ubo.ppMotionBlur.z * 0.1, 0.0).xy * 2.0 - 1.0;
            uv += flow * ubo.ppGravVector.y;
        }
    }
    float pSize = 1.0;
    // --- PIXELATION ---
    if (ubo.ppRetroParams.x > 0.5 && ubo.ppRetroParams2.x > 1.1) {
        pSize = floor(ubo.ppRetroParams2.x);
        vec2 centerPixel = floor(vec2(pixel) / pSize) * pSize + (pSize * 0.5);
        uv = centerPixel / ubo.screenSize.xy;
    }
    
    // Distort UVs early (Barrel Distortion)
    if (ubo.ppDistortionDirt.x > 0.5) {
        vec2 d = uv - 0.5;
        float r2 = dot(d, d);
        uv = 0.5 + d * (1.0 + r2 * ubo.ppDistortionDirt.y);
        
        if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
            imageStore(outImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
            imageStore(outHistory, pixel, vec4(0.0));
            return;
        }
    }
    
    if (ubo.ppWarp.x > 0.5) {
        float time = ubo.ppMotionBlur.z * ubo.ppWarp.z;
        float noise = fract(sin(dot(uv * 10.0 + time, vec2(12.9898, 78.233))) * 43758.5453);
        uv += (noise - 0.5) * ubo.ppWarp.y;
    }
    
    // Screen Space Refraction (Heat Haze / Water)
    if (ubo.ppDitherAniso.z > 0.5) {
        float time = ubo.ppVignetteGrain.z; // time * speed
        vec2 refr;
        refr.x = sin(uv.y * 30.0 + time) * cos(uv.x * 20.0 + time);
        refr.y = cos(uv.x * 25.0 + time) * sin(uv.y * 35.0 + time);
        uv += refr * ubo.ppDitherAniso.w;
        uv = clamp(uv, 0.0, 1.0);
    }

    // Retro Glitch UV displacement
    if (ubo.ppRetroParams.x > 0.5 && ubo.ppRetroParams.z > 0.0) {
        float t = ubo.ppMotionBlur.z * 10.0; // time
        float glitchBand = step(0.95, fract(sin(floor(uv.y * 20.0) * 12.9898 + t) * 43758.5453));
        float shift = (fract(sin(t * 123.456) * 789.123) - 0.5) * 0.1 * ubo.ppRetroParams.z;
        uv.x += glitchBand * shift;
        uv = clamp(uv, 0.0, 1.0);
    }
    
    // Voronoi Stained Glass UV Pixelation
    if (ubo.ppStylizedParams.w > 0.0) {
        float scale = ubo.ppStylizedParams.w;
        vec3 v = voronoi(uv, scale);
        uv += (v.z - 0.5) * 0.1; // Физическое искажение витража (Shattered Glass)
    }
    
    // --- SCREEN FROST ---
    if (ubo.ppColorSplash.w > 0.5) {
        vec2 noiseUV = uv * 3.0;
        float frostNoise = fract(sin(dot(noiseUV, vec2(12.9898, 78.233))) * 43758.5453);
        float dist = length(uv - 0.5) * 2.0;
        float frostMask = smoothstep(0.6, 1.0, dist) * ubo.ppHeatFrost.x;
        uv += (frostNoise - 0.5) * frostMask * 0.05;
    }
    
    // --- SCANLINE MOIRE ---
    if (ubo.ppHatchAnalog.w > 0.5) {
        float scale = ubo.ppMoireTunnel.x;
        float moire = sin(uv.x * scale) * cos(uv.y * scale * 0.9);
        uv += (moire - 0.5) * 0.005; // Легкое геометрическое искажение
    }
    
    // --- HEAT SHIMMER (MIRAGE) ---
    if (ubo.ppColorSplash.y > 0.5) {
        float t = ubo.ppMotionBlur.z * 5.0;
        float noise = fract(sin(dot(uv * 15.0 + vec2(t, t * 0.5), vec2(12.9898, 78.233))) * 43758.5453);
        uv.x += (noise - 0.5) * ubo.ppColorSplash.z;
        uv = clamp(uv, 0.0, 1.0);
    }
    
    // --- LENS CONDENSATION / HUMIDITY ---
    if (ubo.ppFluidCMYK.w > 0.5) {
        float fogMask = smoothstep(0.3, 1.0, length(uv - 0.5) * 2.0) * ubo.ppCondenDust.x;
        uv += (fract(sin(dot(uv*50.0, vec2(12.9, 78.2)))*43758.5) - 0.5) * fogMask * 0.02;
        uv = clamp(uv, 0.0, 1.0);
    }

    // --- LENS WEATHER & WATER DROPS (Raindrops with Physics & Shapes) ---
    if (ubo.ppWeatherSSR.x > 0.5 || ubo.ppHeatFrost.y > 0.5) {
        float speed = ubo.ppWeatherParams.x;
        float size = ubo.ppWeatherParams.y;
        float densityThreshold = ubo.ppWeatherParams.z;
        float distortion = ubo.ppWeatherParams.w;

        // Если включены отдельные "Капли Воды", применяем их настройку преломления
        if (ubo.ppHeatFrost.y > 0.5) {
            distortion = max(distortion, ubo.ppHeatFrost.z); // dropRefraction
            if (ubo.ppWeatherSSR.x < 0.5) { // Если погода выключена, задаем дефолт
                speed = 1.0; size = 20.0; densityThreshold = 0.8;
            }
        }

        float time = ubo.ppMotionBlur.z * speed;
        
        // Физическая симуляция (Инерция камеры + Завихрения ветра Навье-Стокса)
        vec4 ndc = vec4(uv * 2.0 - 1.0, rawD, 1.0);
        vec4 worldPos = ubo.invViewProj * ndc; worldPos /= worldPos.w;
        vec4 prevNdc = ubo.prevViewProj * worldPos; prevNdc /= prevNdc.w;
        vec2 velocity = (uv - (prevNdc.xy * 0.5 + 0.5)); 
        
        float windTime = ubo.ppMotionBlur.z * 0.5;
        vec2 windCurl = vec2(
            sin(uv.y * 5.0 + windTime) * cos(uv.x * 3.0 - windTime),
            cos(uv.x * 4.0 - windTime) * sin(uv.y * 6.0 + windTime)
        ) * 0.02;
        
        // Смещаем UV сетки капель в противоход движению камеры, создавая инерцию
        vec2 dropUV = uv - (velocity * 2.0) - windCurl;
        
        vec2 grid = dropUV * vec2(size, size * 0.5);
        
        // Уникальный рандом для каждой вертикальной колонки
        float idX = floor(grid.x);
        float rndX = fract(sin(idX * 123.456) * 789.123);
        
        // Капли рандомно виляют по X при падении
        grid.x += sin(grid.y * 3.0 + time * 2.0 + rndX * 10.0) * 0.15 * rndX;
        
        // Рандомная скорость падения каждой колонки (от 0.5 до 2.5)
        float colSpeed = 0.5 + rndX * 2.0; 
        
        // ВАЖНО: Знак минус (-=) заставляет капли падать ВНИЗ по экрану
        grid.y -= time * colSpeed * 2.0;
        
        // Смещаем начальную позицию по Y, чтобы колонки падали не синхронно
        grid.y += rndX * 50.0;
        
        vec2 id = floor(grid);
        vec2 f = fract(grid) - 0.5;
        float rnd = fract(sin(dot(id, vec2(12.9898, 78.233))) * 43758.5453);
        
        if (rnd > (1.0 - densityThreshold)) {
            // Жизненный цикл капли (чтобы они рандомно появлялись и исчезали, а не висели вечно)
            float dropLife = fract(time * 0.5 + rnd);
            float dropFade = smoothstep(0.0, 0.1, dropLife) * smoothstep(1.0, 0.8, dropLife);
            
            // Выбор формы на основе ID ячейки
            float shapeRnd = fract(rnd * 43.123);
            if (shapeRnd > 0.6) {
                // Идеальная капля - сужаем верхнюю часть (f.y < 0.0)
                f.x *= 1.0 + max(-f.y * 4.0, 0.0);
            } else if (shapeRnd > 0.3) {
                // Прямоугольная / длинная струйка
                f.x *= 2.5; 
                f.y *= 0.6; 
            } else {
                // Бесформенная лужица (splat)
                f.x *= 1.0 + sin(f.y * 15.0) * 0.4;
                f.y *= 1.0 + cos(f.x * 15.0) * 0.4;
            }

            float dist = length(f);
            float edgeFade = smoothstep(0.2, 0.05, dist); 
            
            if (dist < 0.2) { 
                // Преломление работает как линза
                uv += f * distortion * 8.0 * dropFade * edgeFade; 
                uv = clamp(uv, 0.0, 1.0);
            }
        }
    }

    vec3 color = vec3(0.0);
    
    // --- WATERCOLOR FILTER ---
    if (ubo.ppStylized3.w > 0.5) {
        float rad = ubo.ppStylized4.x;
        vec2 noiseUV = uv * 10.0;
        vec2 wobble = vec2(fract(sin(dot(noiseUV, vec2(12.9898, 78.233))) * 43758.5453), 
                           fract(sin(dot(noiseUV, vec2(39.346, 11.135))) * 43758.5453)) - 0.5;
        color = ApplyKuwahara(uv + wobble * 0.005 * rad, int(rad));
    } 
    // --- POINTILLISM ---
    else if (ubo.ppStylized4.y > 0.5) {
        float pSize = max(ubo.ppStylized4.z, 1.0);
        float pDens = ubo.ppStylized4.w;
        vec2 pUV = floor(uv * ubo.screenSize.xy / pSize) * pSize / ubo.screenSize.xy;
        vec2 localUV = fract(uv * ubo.screenSize.xy / pSize) - 0.5;
        float noise = fract(sin(dot(pUV, vec2(12.9898, 78.233))) * 43758.5453);
        vec2 randOffset = vec2(cos(noise * 6.28), sin(noise * 6.28)) * pSize * 0.5 / ubo.screenSize.xy;
        vec3 pColor = ReadColor(clamp(pUV + randOffset, 0.0, 1.0));
        float pMask = smoothstep(0.5 * pDens, 0.4 * pDens, length(localUV));
        color = mix(vec3(0.0), pColor, pMask);
    } else if (ubo.ppStylizedParams.y > 0.0) {
        color = ApplyKuwahara(uv, int(ubo.ppStylizedParams.y));
    } else {
        color = ReadColor(uv);
    }
    
    // --- PERIPHERAL TUNNEL VISION ---
    if (ubo.ppMoireTunnel.y > 0.5) {
        float intensity = ubo.ppMoireTunnel.z;
        float dist = distance(uv, vec2(0.5));
        float tunnel = smoothstep(0.3, 0.8, dist) * intensity;
        color = mix(color, vec3(dot(color, vec3(0.333)) * 0.2), tunnel);
    }
    
    // --- CMYK OFFSET ---
    if (ubo.ppFluidCMYK.y > 0.5) {
        float off = ubo.ppFluidCMYK.z;
        vec3 cC = ReadColor(uv + vec2(off, off));
        vec3 cM = ReadColor(uv + vec2(-off, off));
        vec3 cY = ReadColor(uv + vec2(0.0, -off));
        // CMYK Extract
        float r = cC.r; float g = cM.g; float b = cY.b;
        color = vec3(r, g, b);
    }
    
    // --- PURKINJE SHIFT (Ночное зрение) ---
    if (ubo.ppPurkinjeSlit.y > 0.5) {
        float luma = dot(color, vec3(0.299, 0.587, 0.114));
        vec3 nightVision = vec3(0.05, 0.15, 0.35) * luma * 2.0; // Синеватый фильтр
        float isDark = 1.0 - smoothstep(0.0, 0.5, luma);
        color = mix(color, nightVision, isDark * ubo.ppPurkinjeSlit.z);
    }
    
    // --- INK BLEED ---
    if (ubo.ppDropsEcho.w > 0.5) {
        float radius = ubo.ppCanvasInk.x;
        vec2 texel = 1.0 / ubo.screenSize.xy;
        vec3 minColor = color;
        for (int x = -1; x <= 1; x++) {
            for (int y = -1; y <= 1; y++) {
                vec3 c = ReadColor(clamp(uv + vec2(x, y) * texel * radius, 0.0, 1.0));
                minColor = min(minColor, c);
            }
        }
        color = minColor;
    }
    
    // --- DUST MOTES (Screen Space Particles) ---
    if (ubo.ppCondenDust.y > 0.5) {
        float t = ubo.ppMotionBlur.z * 0.2;
        float dust = fract(sin(dot(floor(uv * 100.0 + vec2(t, t * 0.5)), vec2(12.9898, 78.233))) * 43758.5453);
        if (dust > 0.995) {
            color += vec3(1.0) * dot(color, vec3(0.333)) * ubo.ppCondenDust.z; 
        }
    }
    
    // --- PURKINJE TREE (Blood Vessels on Retina) ---
    if (ubo.ppPsych3.w > 0.0) {
        float pScale = ubo.ppPsych3.w * 50.0;
        float t = ubo.ppMotionBlur.z * ubo.ppPsych8.x; // Speed
        float thickness = ubo.ppPsych7.x;
        vec3 pColor = ubo.ppPsych7.yzw; // Цвет кровеносных сосудов
        float veins = sin(uv.x * pScale + t + sin(uv.y * pScale * 0.8 - t)) * cos(uv.y * pScale * 1.2 + t);
        float vignette = smoothstep(0.4, 1.0, distance(uv, vec2(0.5)));
        color = mix(color, pColor, smoothstep(1.0 - thickness, 1.0, veins) * vignette * 0.8);
    }

    // --- JPEG / MPEG ARTIFACTS ---
    if (ubo.ppGlitch3.z > 0.5) {
        float bSize = max(ubo.ppGlitch3.w, 1.0);
        float q = max(ubo.ppGlitch4.x, 1.0);
        vec2 blockUV = floor(uv * ubo.screenSize.xy / bSize) * bSize / ubo.screenSize.xy;
        color = floor(ReadColor(blockUV) * q + 0.5) / q;
    }
    
    // --- OPTICAL SOUP / COLOR BLEEDING ---
    if (ubo.ppBleedMosh.x > 0.0) {
        float radius = ubo.ppBleedMosh.y;
        vec2 texel = 1.0 / ubo.screenSize.xy;
        vec3 edgeH = ReadColor(uv + vec2(texel.x, 0.0)) - ReadColor(uv - vec2(texel.x, 0.0));
        vec3 edgeV = ReadColor(uv + vec2(0.0, texel.y)) - ReadColor(uv - vec2(0.0, texel.y));
        vec2 bleedDir = normalize(vec2(length(edgeH), length(edgeV)) + 0.001);
        color += ReadColor(clamp(uv + bleedDir * radius * texel, 0.0, 1.0)) * 0.5;
        color *= 0.666;
    }
    
    // --- PIXEL SORTING ---
    if (ubo.ppAsciiSort.z > 0.0) {
        float thresh = ubo.ppAsciiSort.w;
        float angle = ubo.ppPixelSort.x * 3.14159 / 180.0;
        float sortLen = ubo.ppPixelSort.y;
        float time = ubo.ppMotionBlur.z * ubo.ppPixelSort.z;
        
        vec2 dir = vec2(cos(angle), sin(angle));
        vec3 maxColor = color;
        float maxLuma = dot(color, vec3(0.299, 0.587, 0.114));
        
        int steps = max(1, int(sortLen * 50.0));
        for(int i = 1; i < steps; i++) {
            vec2 offset = dir * (float(i) * 0.005 + sin(time)*0.01);
            vec3 sampleC = ReadColor(clamp(uv - offset, 0.0, 1.0));
            float luma = dot(sampleC, vec3(0.299, 0.587, 0.114));
            if(luma > thresh && luma > maxLuma) {
                maxColor = sampleC;
                maxLuma = luma;
            }
        }
        color = maxColor;
    }
    
    // --- BLURS ---
    if (ubo.ppBlurs.x > 0.0) {
        int mode = int(ubo.ppBlurs.x + 0.5);
        float strength = ubo.ppBlurs.y;
        float radius = ubo.ppBlurs.z;
        vec3 blurColor = vec3(0.0);
        
        if (mode == 1) { 
            float16_t totW = float16_t(0.0); int r = int(min(radius, 15.0)); // CLAMPED
            f16vec3 blurColor16 = f16vec3(0.0);
            for(int x = -r; x <= r; x++) {
                for(int y = -r; y <= r; y++) {
                    blurColor16 += f16vec3(ReadColor(uv + vec2(x,y) / ubo.screenSize.xy));
                    totW += float16_t(1.0);
                }
            }
            color = mix(color, vec3(blurColor16 / max(totW, float16_t(1.0))), strength);
        } else if (mode == 2) { 
            float16_t totW = float16_t(0.0); int r = int(min(radius, 15.0)); // CLAMPED
            f16vec3 blurColor16 = f16vec3(0.0);
            for(int x = -r; x <= r; x++) {
                for(int y = -r; y <= r; y++) {
                    float16_t w = float16_t(exp(-(float(x*x + y*y)) / (2.0 * max(radius, 0.1))));
                    blurColor16 += f16vec3(ReadColor(uv + vec2(x,y) / ubo.screenSize.xy)) * w;
                    totW += w;
                }
            }
            color = mix(color, vec3(blurColor16 / max(totW, float16_t(1.0))), strength);
        } else if (mode == 3) { 
            vec2 center = ubo.ppBlurCenter.xy;
            vec2 dir = center - uv;
            int samples = int(radius * 2.0);
            for(int i = 0; i < samples; i++) {
                blurColor += ReadColor(uv + dir * (float(i) / float(samples)) * 0.1);
            }
            color = mix(color, blurColor / float(max(samples, 1)), strength);
        } else if (mode == 4) { 
            vec2 cPixel = floor(uv * ubo.screenSize.xy / radius) * radius + radius * 0.5;
            blurColor = ReadColor(cPixel / ubo.screenSize.xy);
            color = mix(color, blurColor, strength);
        }
    }
    
    // --- TILT SHIFT ---
    if (ubo.ppLens3.x > 0.5) {
        float amount = ubo.ppLens3.y;
        float falloff = ubo.ppLens3.z;
        float blurAmount = smoothstep(falloff, 1.0, abs(uv.y - 0.5) * 2.0) * amount;
        if (blurAmount > 0.0) {
            vec3 blurC = vec3(0.0);
            int samples = int(blurAmount * 5.0);
            for(int i=-samples; i<=samples; i++) blurC += ReadColor(clamp(uv + vec2(0.0, i) / ubo.screenSize.y, 0.0, 1.0));
            color = mix(color, blurC / float(samples * 2 + 1), clamp(blurAmount, 0.0, 1.0));
        }
        // Усиление цветов в центре фокуса
        float centerDist = smoothstep(falloff + 0.2, 0.0, abs(uv.y - 0.5) * 2.0);
        color = mix(color, color * 1.3, centerDist);
    }

    // --- SPEED LINES (ANIME) ---
    if (ubo.ppSpeedLines.x > 0.5) {
        float time = ubo.ppMotionBlur.z * ubo.ppPsych8.w * 10.0;
        vec2 center = vec2(0.5);
        vec2 dir = uv - center;
        float angle = atan(dir.y, dir.x);
        float noise = fract(sin(floor(angle * ubo.ppPsych8.z) * 12.9898 + time) * 43758.5453); // z: Lines Count
        float dist = length(dir) * 2.0;
        // Растягиваем шум вдоль радиуса
        float lines = step(0.9, noise) * smoothstep(1.0 - ubo.ppPsych8.w, 1.0, dist); // w: Length
        color += vec3(lines); // Белые штрихи по краям
    }
    
    // --- SCREEN-SPACE CANVAS ---
    if (ubo.ppDropsEcho.y > 0.5) {
        vec2 canvasUV = uv * 200.0;
        float noise = fract(sin(dot(canvasUV, vec2(12.9898, 78.233))) * 43758.5453);
        color *= mix(1.0, noise, 0.1 * ubo.ppDropsEcho.z);
    }

    // --- EYE FLOATERS ---
    if (ubo.ppPsych1.y > 0.0) {
        float t = ubo.ppMotionBlur.z * 0.2;
        vec4 ndc = vec4(uv * 2.0 - 1.0, rawD, 1.0);
        vec4 worldPos = ubo.invViewProj * ndc; worldPos /= worldPos.w;
        vec4 prevNdc = ubo.prevViewProj * worldPos; prevNdc /= prevNdc.w;
        vec2 vel = uv - (prevNdc.xy * 0.5 + 0.5);
        vec2 floatUV = uv * 10.0 + vel * 50.0; // Floaters lag behind camera
        float f1 = sin(floatUV.x * 2.0 + t) * cos(floatUV.y * 3.0 - t);
        float f2 = sin(floatUV.x * 5.0 - t * 2.0) * cos(floatUV.y * 4.0 + t);
        float floaterShape = smoothstep(0.5, 1.0, f1 * f2);
        color = mix(color, vec3(0.0), floaterShape * ubo.ppPsych1.y * 0.8);
    }

    if (any(isnan(color)) || any(isinf(color))) color = vec3(0.0);
    
    // --- SCREEN SPACE SUBSURFACE SCATTERING (SSSS) ---
    if (ubo.ppSSSS.x > 0.5) {
        float roughness = textureLod(normalInput, uv, 0.0).a;
        float cDepth = textureLod(depthInput, uv, 0.0).r;
        if (cDepth < 1.0 && roughness > 0.3 && roughness < 0.8) { 
            vec3 sssColor = vec3(0.0); 
            vec3 totW = vec3(0.0);
            vec2 texel = 1.0 / ubo.screenSize.xy;
            vec3 scatterProfile[5] = vec3[](
                vec3(0.1, 0.03, 0.01), vec3(0.3, 0.1, 0.05), vec3(1.0, 0.8, 0.6), vec3(0.3, 0.1, 0.05), vec3(0.1, 0.03, 0.01)
            );
            for(int x=-2; x<=2; x++) {
                for(int y=-2; y<=2; y++) {
                    vec2 off = vec2(x,y) * texel * ubo.ppSSSS.y * 100.0;
                    vec2 sampleUV = clamp(uv + off, 0.0, 1.0);
                    float sDepth = textureLod(depthInput, sampleUV, 0.0).r;
                    float w = exp(-abs(cDepth - sDepth) * 50.0);
                    vec3 profileW = scatterProfile[x+2] * scatterProfile[y+2] * w;
                    sssColor += textureLod(hdrInput, sampleUV, 0.0).rgb * profileW; 
                    totW += profileW;
                }
            }
            color = mix(color, sssColor / max(totW, vec3(0.001)), 0.8 * ubo.ppSSSS.x);
        }
    }

    // --- STOCHASTIC SCREEN SPACE REFLECTIONS (SSSR) ---
    if (ubo.ppWeatherSSR.z > 0.5) {
        float roughness = textureLod(normalInput, uv, 0.0).a;
        if (roughness < 0.6 && roughness > 0.01) { 
            vec3 N = textureLod(normalInput, uv, 0.0).rgb;
            if (length(N) > 0.1) {
                N = normalize(N);
                float d = textureLod(depthInput, uv, 0.0).r;
                if (d < 1.0) {
                    vec4 worldPosRaw = ubo.invViewProj * vec4(uv * 2.0 - 1.0, d, 1.0);
                    vec3 worldPos = worldPosRaw.xyz / worldPosRaw.w;
                    vec3 V = normalize(worldPos - ubo.camPos);
                    
                    vec3 reflColor = vec3(0.0); float hit = 0.0;
                    
                    // --- Half-Resolution Subgroup Optimization ---
                    // Выполняем дорогой raymarching только в 1 пикселе из блока 2x2
                    bool isRaycaster = ((pixel.x % 2) == 0 && (pixel.y % 2) == 0);
                    
                    if (isRaycaster) {
                        vec3 R = reflect(V, N);
                        vec2 noise = fract(sin(dot(uv, vec2(12.9898, 78.233)) + ubo.ppMotionBlur.z) * vec2(43758.5453, 28001.8384));
                        R = normalize(R + (vec3(noise, fract(noise.x + noise.y)) - 0.5) * roughness * 0.4);
                        float stepSize = 0.1; float steps = ubo.ppWeatherSSR.w; float thickness = max(ubo.ppSSSS.z, 0.1);
                        vec3 rayPos = worldPos + N * 0.1;
                        for (int i = 0; i < int(steps); i++) {
                            rayPos += R * stepSize;
                            vec4 rClip = ubo.projection * ubo.view * vec4(rayPos, 1.0);
                            if (rClip.w <= 0.0) break;
                            vec3 rNdc = rClip.xyz / rClip.w; vec2 rUv = rNdc.xy * 0.5 + 0.5;
                            if (rUv.x < 0.0 || rUv.x > 1.0 || rUv.y < 0.0 || rUv.y > 1.0) break;
                            float sDepth = textureLod(depthInput, rUv, 0.0).r;
                            if (sDepth < rNdc.z) {
                                vec4 hitWorldRaw = ubo.invViewProj * vec4(rUv * 2.0 - 1.0, sDepth, 1.0);
                                if (distance(hitWorldRaw.xyz / hitWorldRaw.w, rayPos) < thickness) {
                                    reflColor = textureLod(hdrInput, rUv, 0.0).rgb; hit = 1.0; break;
                                }
                            }
                            stepSize *= 1.05; 
                        }
                    }
                    
                    // Мгновенно и аппаратно раздаем результаты вычислений соседям
                    hit = subgroupQuadBroadcast(hit, 0);
                    reflColor.r = subgroupQuadBroadcast(reflColor.r, 0);
                    reflColor.g = subgroupQuadBroadcast(reflColor.g, 0);
                    reflColor.b = subgroupQuadBroadcast(reflColor.b, 0);

                    if (hit > 0.5) color = mix(color, reflColor, mix(0.1, 1.0, pow(1.0 - max(dot(N, -V), 0.0), 5.0)) * (1.0 - roughness));
                }
            }
        }
    }
    
    // --- DATAMOSH ---
    if (ubo.ppBleedMosh.z > 0.0) {
        float d = textureLod(depthInput, uv, 0.0).r;
        vec4 ndc = vec4(uv * 2.0 - 1.0, d, 1.0);
        vec4 worldPos = ubo.invViewProj * ndc; 
        worldPos /= worldPos.w; vec4 prevNdc = ubo.prevViewProj * worldPos; prevNdc /= prevNdc.w;
        vec2 velocity = uv - (prevNdc.xy * 0.5 + 0.5);
        
        if (length(velocity) > 0.0001 && length(velocity) < ubo.ppBleedMosh.w) {
            color = textureLod(historyInput, uv - velocity, 0.0).rgb; // Настоящий Datamosh
        }
    }

    // --- ECTOPLASM / SLIME TRAIL ---
    if (ubo.ppCondenDust.w > 0.5) {
        vec3 ectoColor = ubo.ppEctoRolling.xyz;
        vec2 vel = vec2(0.0);
        vec4 ndc = vec4(uv * 2.0 - 1.0, rawD, 1.0);
        vec4 worldPos = ubo.invViewProj * ndc; worldPos /= worldPos.w;
        vec4 prevNdc = ubo.prevViewProj * worldPos; prevNdc /= prevNdc.w;
        vel = uv - (prevNdc.xy * 0.5 + 0.5); 
        
        if (length(vel) > 0.005) {
            vec3 hist = textureLod(historyInput, clamp(uv - vel * 2.0, 0.0, 1.0), 0.0).rgb;
            color = mix(color, ectoColor * hist, 0.5);
        }
    }

    // --- TAA / MOTION TRAILS ---
    if (ubo.ppTAA_CAS.x > 0.5 || ubo.ppMotionBlur.w > 0.0) {
        float trails = ubo.ppMotionBlur.w;
        float d = textureLod(depthInput, uv, 0.0).r;
        vec2 velocity = vec2(0.0);
        vec4 ndc = vec4(uv * 2.0 - 1.0, d, 1.0);
        vec4 worldPos = ubo.invViewProj * ndc; 
        if (abs(worldPos.w) > 0.00001) {
            worldPos /= worldPos.w;
            vec4 prevNdc = ubo.prevViewProj * worldPos; 
            if (abs(prevNdc.w) > 0.00001) {
                prevNdc /= prevNdc.w;
                vec2 prevUv = prevNdc.xy * 0.5 + 0.5;
                velocity = (uv - prevUv); 
            }
        }
        
        vec3 historyColor = textureLod(historyInput, uv - velocity, 0.0).rgb;
                if (ubo.ppAstigDolly.z > 0.5) {
            if (length(velocity) > ubo.ppAstigDolly.w) {
                color = mix(color, vec3(dot(color, vec3(0.333))), 0.8); // Обесцвечиваем и смазываем
            }
        }
        
        // --- TEMPORAL ECHO (PSYCHEDELIC) ---
        if (ubo.ppHeatFrost.w > 0.5 || ubo.ppSaccBurn.z > 0.5 || ubo.ppAfterBleed.y > 0.5 || ubo.ppPsych1.z > 0.0) {
            vec3 staticHist = textureLod(historyInput, uv, 0.0).rgb; // Игнорируем камеру!
            
            // Phosphor Trails (Только зеленое свечение ярких пикселей)
            if (ubo.ppSaccBurn.z > 0.5) {
                vec3 phos = max(vec3(0.0), staticHist - ubo.ppSaccBurn.w) * vec3(0.2, 1.0, 0.2);
                color = max(color, phos);
            }
            // Temporal Color Bleeding
            else if (ubo.ppAfterBleed.y > 0.5) {
                color.r = mix(color.r, staticHist.r, ubo.ppAfterBleed.z);
                color.b = mix(color.b, staticHist.b, ubo.ppAfterBleed.z * 0.5);
            }
            // Time Stutter
            else if (ubo.ppPsych1.z > 0.0) {
                float severity = ubo.ppPsych1.z;
                float speed = ubo.ppPsych4.z;
                float t = ubo.ppMotionBlur.z * speed * 5.0;
                if (fract(t) < severity) {
                    color = staticHist;
                }
            }
            // Стандартное эхо
            else {
                // Плавное смешивание вместо жесткого max
                color = mix(color, max(color, staticHist), ubo.ppDropsEcho.x);
            }
        }
        
        // --- FRAME BUFFER HAUNTING ---
        if (ubo.ppPsych3.y > 0.0) {
            float luma = dot(color, vec3(0.333));
            float noise = fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453);
            if (luma < 0.5 && noise > (1.0 - ubo.ppPsych3.y)) {
                color = mix(color, textureLod(historyInput, uv, 0.0).rgb, 0.8); 
            }
        }

        // --- INSIDE SCREEN SMUDGES ---
        if (ubo.ppPsych3.x > 0.0) {
            float s = sin(uv.x*30.0 + sin(uv.y*20.0)) * cos(uv.y*25.0 + sin(uv.x*15.0));
            float smudgeNoise = smoothstep(0.5, 1.0, s);
            float invLuma = 1.0 - dot(color, vec3(0.333));
            color += vec3(0.5) * smudgeNoise * invLuma * ubo.ppPsych3.x; 
        }

        if (trails > 0.0) {
            float blend = 1.0 - trails;
            color = mix(historyColor, color, blend);
        } else {
            vec3 cMin = color; vec3 cMax = color;
            vec2 texel = 1.0 / ubo.screenSize.xy;
            vec3 s1 = ReadRawColor(clamp(uv + vec2( texel.x, 0.0), 0.0, 1.0));
            vec3 s2 = ReadRawColor(clamp(uv + vec2(-texel.x, 0.0), 0.0, 1.0));
            vec3 s3 = ReadRawColor(clamp(uv + vec2(0.0,  texel.y), 0.0, 1.0));
            vec3 s4 = ReadRawColor(clamp(uv + vec2(0.0, -texel.y), 0.0, 1.0));
            cMin = min(cMin, min(s1, min(s2, min(s3, s4))));
            cMax = max(cMax, max(s1, max(s2, max(s3, s4))));
            historyColor = clamp(historyColor, cMin, cMax);
            float blend = clamp(ubo.ppTAA_CAS.y, 0.01, 0.99);
            color = mix(historyColor, color, blend);
        }
    }

    // --- REACTION-DIFFUSION ---
    if (ubo.ppReactDroste.y > 0.5) {
        float speed = ubo.ppReactDroste.z;
        float t = ubo.ppMotionBlur.z * speed;
        vec2 noiseUV = uv * 5.0;
        float rd = sin(noiseUV.x * 10.0 + t) * cos(noiseUV.y * 10.0 - t) +
                   sin(noiseUV.y * 15.0 - t * 1.5) * cos(noiseUV.x * 15.0 + t * 1.5);
        rd = smoothstep(0.0, 0.5, rd);
        color = mix(color, vec3(0.1, 0.9, 0.5), rd * 0.5);
    }

    // --- SMEAR / RIBBON TRAILS ---
    if (ubo.ppTrails.x > 0.0) {
        vec3 hist = textureLod(historyInput, uv, 0.0).rgb;
        float luma = dot(color, vec3(0.333));
        if (luma > ubo.ppTrails.z) color = mix(color, hist, ubo.ppTrails.y);
    }
    
    // Записываем чистый TAA результат в историю следующего кадра (БЕЗ Bloom, DoF, ToneMap!)
    imageStore(outHistory, pixel, vec4(color, 1.0));

    // Motion Blur (Camera Velocity)
    if (ubo.ppMotionBlur.x > 0.5) {
        float d = textureLod(depthInput, uv, 0.0).r;
        vec4 ndc = vec4(uv * 2.0 - 1.0, d, 1.0);
        vec4 worldPos = ubo.invViewProj * ndc; 
        if (abs(worldPos.w) > 0.00001) {
            worldPos /= worldPos.w;
            vec4 prevNdc = ubo.prevViewProj * worldPos; 
            if (abs(prevNdc.w) > 0.00001) {
                prevNdc /= prevNdc.w;
                vec2 prevUv = prevNdc.xy * 0.5 + 0.5;
                
                vec2 velocity = (uv - prevUv); 
                velocity *= ubo.ppMotionBlur.y; // Strength applies before clamp
                float maxVel = 0.1; // Ограничение размытия 10% экрана
                if (length(velocity) > maxVel) velocity = normalize(velocity) * maxVel;
                
                if (length(velocity) > 0.0005) {
                    vec3 mbColor = color; float totalWeight = 1.0;
                    int samples = 16;
                    for (int i = 1; i < samples; ++i) {
                        float t = (float(i) / float(samples - 1)) - 0.5;
                        vec2 offsetUV = clamp(uv + velocity * t, 0.0, 1.0);
                        float sampleD = textureLod(depthInput, offsetUV, 0.0).r;
                        float weight = (sampleD < d - 0.01) ? 0.0 : 1.0; 
                        mbColor += ReadColor(offsetUV) * weight;
                        totalWeight += weight;
                    }
                    color = mbColor / max(totalWeight, 0.001);
                }
            }
        }
    }

    // Depth of Field
    if (ubo.ppDoFParams.x > 0.5) {
        float d = textureLod(depthInput, uv, 0.0).r;
        float zN = ubo.zNear; float zF = ubo.zFar;
        float linDepth = (zN * zF) / (zF + d * (zN - zF));
        
        float focusDist = ubo.ppDoFParams.y;
        if (ubo.ppLensAdvanced.z > 0.5) { // Auto-Focus
            float centerD = textureLod(depthInput, vec2(0.5, 0.5), 0.0).r;
            focusDist = (zN * zF) / (zF + centerD * (zN - zF));
        }
        
        float coc = clamp(abs(linDepth - focusDist) / max(ubo.ppDoFParams.z, 0.001), 0.0, 1.0);
        if (coc > 0.05) {
            vec3 dofColor = vec3(0.0); float totW = 0.0;
            float rad = ubo.ppDoFParams.w * coc * 0.01;
            
            // Оптимизация (Имитация полу-разрешения): Разреженный Bokeh-семплинг (Golden Ratio)
            int samples = int(mix(4.0, 24.0, coc));
            const float GOLDEN_ANGLE = 2.39996323;
            
            // Custom Bokeh Figure
            int shape = int(ubo.ppRetroParams2.z + 0.5);
            float rotAngle = ubo.ppRetroParams2.w * 3.14159 / 180.0;
            float blades = 6.0; 
            if (shape == 1) blades = 6.0;
            else if (shape == 2) blades = 8.0;
            else if (shape == 3) blades = 3.0;
            
            for (int i = 0; i < samples; ++i) {
                float r = sqrt(float(i) + 0.5) / sqrt(float(samples));
                float theta = float(i) * GOLDEN_ANGLE;
                vec2 off = vec2(cos(theta), sin(theta)) * (rad * r);
                
                // Применяем фигуру к боке
                if (shape > 0) {
                    float angle = atan(off.y, off.x) + rotAngle;
                    float rShape = cos(3.14159/blades) / cos(angle - (2.0*3.14159/blades)*floor((angle + 3.14159/blades)/(2.0*3.14159/blades)));
                    off *= rShape;
                }
                
                vec2 sampUV = uv + off;
                float sampD = textureLod(depthInput, sampUV, 0.0).r;
                float sampLin = (zN * zF) / (zF + sampD * (zN - zF));
                float sampCoc = clamp(abs(sampLin - ubo.ppDoFParams.y) / ubo.ppDoFParams.z, 0.0, 1.0);
                
                float weight = (sampLin < linDepth) ? 1.0 : clamp(sampCoc / max(coc, 0.001), 0.0, 1.0);
                dofColor += textureLod(hdrInput, sampUV, 0.0).rgb * weight; 
                totW += weight;
            }
            color = dofColor / max(totW, 0.001);
        }
    }

    // Bloom & Lens Flare
    vec3 bloom = vec3(0.0); vec3 flare = vec3(0.0);
    vec2 texel = 1.0 / ubo.screenSize.xy; float thresh = ubo.ppBloomParams.y;
    if (ubo.ppBloomParams.x > 0.5) {
        float totalWeight = 0.0;
        for(int x = -2; x <= 2; x+=2) {
            for(int y = -2; y <= 2; y+=2) {
                vec3 s = textureLod(hdrInput, uv + vec2(x, y) * texel * 2.0, 0.0).rgb;
                bloom += isolateBright(s, thresh);
                totalWeight += 1.0;
            }
        }
        vec3 totalBloom = (bloom / max(totalWeight, 1.0)) * ubo.ppBloomParams.z;
        if (ubo.ppDistortionDirt.z > 0.5) {
            vec3 dirt = textureLod(dirtInput, uv, 0.0).rgb;
            float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
            vec3 dirtIllumination = totalBloom + vec3(luma * 0.2); // Also illuminated by general bright areas
            color += dirt * dirtIllumination * ubo.ppDistortionDirt.w;
        }
        color += totalBloom;
    }
    if (ubo.ppLensFlare.x > 0.5) {
        // Anamorphic Flares (Горизонтальные синие блики)
        if (ubo.ppBlurCenter.z > 0.5) {
            vec3 streak = vec3(0.0);
            for (int i = -10; i <= 10; i++) {
                streak += isolateBright(texture(hdrInput, clamp(uv + vec2(float(i) * 3.0 * texel.x, 0.0), 0.0, 1.0)).rgb, thresh) * (1.0 - abs(float(i))/10.0);
            }
            flare += streak * vec3(0.1, 0.3, 1.0) * 1.5;
        }
        
        vec2 ghostVec = (vec2(0.5) - uv) * ubo.ppLensFlare.z; int ghosts = int(ubo.ppLensFlare.w);
        
        // Хроматическая аберрация на бликах
        vec2 dir = normalize(ghostVec) * ubo.ppLensAdvanced.y; 
        for(int i = 0; i < ghosts; i++) {
            vec2 gUV = fract(uv + ghostVec * float(i));
            float weight = pow(1.0 - float(i)/float(ghosts), 2.0);
            vec3 s;
            s.r = texture(hdrInput, gUV - dir).r;
            s.g = texture(hdrInput, gUV).g;
            s.b = texture(hdrInput, gUV + dir).b;
            flare += isolateBright(s, thresh) * weight;
        }
        
        // Halo (Ореол)
        if (ubo.ppLensAdvanced.x > 0.001) {
            vec2 haloVec = normalize(ghostVec) * ubo.ppLensAdvanced.x;
            vec2 haloUV = fract(uv + haloVec);
            float haloWeight = length(vec2(0.5) - haloUV) / length(vec2(0.5));
            haloWeight = pow(1.0 - clamp(haloWeight, 0.0, 1.0), 5.0);
            flare += isolateBright(texture(hdrInput, haloUV).rgb, thresh) * haloWeight;
        }
        
        // --- STAR FILTER / CROSS SCREEN ---
        if (ubo.ppLens4.y > 0.5) {
            float starThresh = ubo.ppLens4.z;
            float starLen = ubo.ppLens4.w;
            
            // Фикс: Читаем строго по кресту X и Y с широким шагом, а не по диагонали
            for(int i = -15; i <= 15; i++) {
                if(i == 0) continue;
                float w = 1.0 - abs(float(i)) / 15.0;
                // Горизонтальный луч
                flare += isolateBright(textureLod(hdrInput, clamp(uv + vec2(float(i) * starLen * texel.x, 0.0), 0.0, 1.0), 0.0).rgb, starThresh) * w * 2.0;
                // Вертикальный луч
                flare += isolateBright(textureLod(hdrInput, clamp(uv + vec2(0.0, float(i) * starLen * texel.y), 0.0, 1.0), 0.0).rgb, starThresh) * w * 2.0;
            }
        }
        
        // --- ASTIGMATISM (Лучи света от астигматизма) ---
        if (ubo.ppTransAnime.w > 0.5) {
            float astLen = ubo.ppAstigDolly.x;
            float angle = ubo.ppAstigDolly.y * 3.14159 / 180.0;
            vec2 dir = vec2(cos(angle), sin(angle));
            for(int i = -10; i <= 10; i++) {
                if (i==0) continue;
                flare += isolateBright(textureLod(hdrInput, clamp(uv + dir * float(i) * astLen * texel, 0.0, 1.0), 0.0).rgb, thresh) * (1.0 - abs(float(i))/10.0);
            }
        }
        
        color += flare * ubo.ppLensFlare.y;
    }
    // --- BURNING FILM ---
    if (ubo.ppSaccBurn.x > 0.5) {
        float time = ubo.ppSaccBurn.y; // Читаем правильный параметр времени горения!
        float dist = distance(uv, vec2(0.5));
        float noise = fract(sin(dot(uv*20.0, vec2(12.9, 78.2)))*43758.5);
        float burnEdge = time - dist + noise*0.1;
        
        if (burnEdge > 0.05) color = vec3(0.0); // Сгорело
        else if (burnEdge > 0.0) color = mix(color, vec3(1.0, 0.2, 0.0) * 5.0, burnEdge / 0.05);
    }
    // --- CAS (Contrast Adaptive Sharpening) ДО Tonemapping ---
    if (ubo.ppTAA_CAS.z > 0.5) {
        vec2 texel = 1.0 / ubo.screenSize.xy;
        vec3 a = ReadRawColor(clamp(uv + vec2(0, -texel.y), 0.0, 1.0));
        vec3 b = ReadRawColor(clamp(uv + vec2(-texel.x, 0), 0.0, 1.0));
        vec3 c = ReadRawColor(clamp(uv + vec2(texel.x, 0), 0.0, 1.0));
        vec3 d = ReadRawColor(clamp(uv + vec2(0, texel.y), 0.0, 1.0));
        
        float w = -1.0 / max(8.0, ubo.ppTAA_CAS.w * 10.0 + 8.0);
        vec3 sharpened = (color + (a + b + c + d) * w) / (1.0 + 4.0 * w);
        
        // Защита от отрицательных значений HDR
        color = mix(color, max(sharpened, vec3(0.0)), ubo.ppTAA_CAS.w);
    }

    // Color Grade & Tone Mapping
    
    // ЗАЩИТА: Если C++ не передал настройки (например, буфер состоит из нулей), gamma будет 0.
    // В этом случае мы используем дефолтные значения, чтобы экран не становился черным или серым.

    
    float currentAdapted = max(adaptedLuminance, 0.0001);
    float exposure = 1.0;
    if (ubo.ppExposureParams.x > 0.5) {
        exposure = (0.18 / currentAdapted) * ubo.ppExposureParams.y; // UE5 style adaptation + comp.
    } else {
        exposure = max(ubo.ppExposureParams.y, 0.01);
    }
    color *= exposure;
    
    float temp = max(ubo.ppColorBalance.x, 1000.0); 
    color *= vec3(temp > 6500.0 ? 6500.0 / temp : 1.0, 1.0, temp < 6500.0 ? temp / 6500.0 : 1.0);
    
    // --- 3-Way Color Grading ---
    float luma_cg = dot(color, vec3(0.2126, 0.7152, 0.0722));
    float shadowFactor = clamp(1.0 - (luma_cg * 2.5), 0.0, 1.0);
    float highlightFactor = clamp((luma_cg - 0.5) * 2.0, 0.0, 1.0);
    float midtoneFactor = 1.0 - shadowFactor - highlightFactor;
    
    vec3 shadowColor = ApplyCDL(color, ubo.cgShadowsLift, ubo.cgShadowsGamma, ubo.cgShadowsGain, ubo.cgShadowsOffset);
    vec3 midtoneColor = ApplyCDL(color, ubo.cgMidtonesLift, ubo.cgMidtonesGamma, ubo.cgMidtonesGain, ubo.cgMidtonesOffset);
    vec3 highlightColor = ApplyCDL(color, ubo.cgHighlightsLift, ubo.cgHighlightsGamma, ubo.cgHighlightsGain, ubo.cgHighlightsOffset);
                
    color = shadowColor * shadowFactor + midtoneColor * midtoneFactor + highlightColor * highlightFactor;
    color = ApplyCDL(color, ubo.cgGlobalLift, ubo.cgGlobalGamma, ubo.cgGlobalGain, ubo.cgGlobalOffset);

    vec3 cgColor = ubo.cgShadows.rgb * shadowFactor + ubo.cgMidtones.rgb * midtoneFactor + ubo.cgHighlights.rgb * highlightFactor;
    if (length(ubo.cgShadows.rgb) + length(ubo.cgMidtones.rgb) + length(ubo.cgHighlights.rgb) > 0.01) {
        color *= cgColor;
    }
    vec3 mixed;
    mixed.r = dot(color, ubo.cgRgbMixerRed.rgb);
    mixed.g = dot(color, ubo.cgRgbMixerGreen.rgb);
    mixed.b = dot(color, ubo.cgRgbMixerBlue.rgb);
    color = mixed;

    // --- Tone Mapping ---
    int tonemapper = int(ubo.ppLensAdvanced.w + 0.5);
    if (tonemapper == 1) {
        color = color / (color + vec3(1.0)); // Reinhard
    } else if (tonemapper == 2) {
        // ACES Film
        float a = 2.51f; float b = 0.03f; float c = 2.43f; float d = 0.59f; float e = 0.14f;
        color = clamp((color * (a * color + b)) / (color * (c * color + d) + e), 0.0, 1.0);
    }
    
    float sat = max(ubo.ppColorBalance.z, 0.0);
    color = mix(vec3(dot(color, vec3(0.2126, 0.7152, 0.0722))), color, sat);
    
    float contrast = max(ubo.ppColorBalance.y, 0.0);
    color = clamp((color - 0.5) * contrast + 0.5, 0.0, 1.0);
    
    if (ubo.ppVignetteGrain.x > 0.0) color *= smoothstep(0.8, 0.8 - ubo.ppVignetteGrain.x, distance(uv, vec2(0.5)) * (0.5 + ubo.ppVignetteGrain.x));
    if (ubo.ppVignetteGrain.y > 0.0) color += (fract(sin(dot(uv, vec2(12.9898, 78.233)) + ubo.ppMotionBlur.z) * 43758.5453) - 0.5) * ubo.ppVignetteGrain.y;
    
    float gamma = max(ubo.ppColorBalance.w, 0.1);
    color = pow(clamp(color, 0.0, 1.0), vec3(1.0 / gamma));

    // --- OUTLINE / EDGE DETECTION ---
    if (ubo.ppOutlineParams.x > 0.5) {
        vec2 outUV = uv;
        int outlineMode = int(ubo.ppOutlineColor.w + 0.5);
        
        // Outline Wobble/Jitter
        if (ubo.ppOutlineJitter.x > 0.5) {
            float t = ubo.ppMotionBlur.z * ubo.ppOutlineJitter.y;
            float t_discrete = floor(t); // Stop-motion effect (FPS)
            vec2 jitter = vec2(
                fract(sin(dot(uv + t_discrete, vec2(12.9898, 78.233))) * 43758.5453),
                fract(cos(dot(uv - t_discrete, vec2(39.346, 11.135))) * 43758.5453)
            ) - 0.5;
            outUV += jitter * (ubo.ppOutlineJitter.z / ubo.screenSize.xy);
        }

        float thickness = ubo.ppOutlineParams.y;
        vec2 texel = 1.0 / ubo.screenSize.xy;
        vec2 offsets[4] = vec2[]( vec2(thickness, 0.0)*texel, vec2(-thickness, 0.0)*texel, vec2(0.0, thickness)*texel, vec2(0.0, -thickness)*texel );

        float d0 = texture(depthInput, outUV).r;
        vec3 n0 = texture(normalInput, outUV).rgb;
        if (length(n0) > 0.1) n0 = normalize(n0);

        float zN = ubo.zNear; float zF = ubo.zFar;
        float linD0 = (zN * zF) / (zF + d0 * (zN - zF));
        float edgeDepth = 0.0, edgeNormal = 0.0;

        for (int i = 0; i < 4; i++) {
            vec2 sampUV = clamp(outUV + offsets[i], 0.0, 1.0);
            float d1 = textureLod(depthInput, sampUV, 0.0).r;
            
            if (outlineMode == 0 || outlineMode == 1) {
                if (d0 >= 1.0 && d1 >= 1.0) continue; 
                if ((d0 >= 1.0 && d1 < 1.0) || (d0 < 1.0 && d1 >= 1.0)) { edgeDepth = 1.0; continue; }
                float linD1 = (zN * zF) / (zF + d1 * (zN - zF));
                float depthDiff = abs(linD0 - linD1) / max(min(linD0, linD1), 0.0001);
                if (depthDiff > ubo.ppOutlineParams.z) edgeDepth = 1.0;
            }
            
            if (outlineMode == 0 || outlineMode == 2) {
                if (d0 >= 1.0 || d1 >= 1.0) continue; // Don't draw internal lines on the sky
                vec3 n1 = textureLod(normalInput, sampUV, 0.0).rgb;
                if (length(n1) > 0.1 && 1.0 - dot(n0, normalize(n1)) > ubo.ppOutlineParams.w) edgeNormal = 1.0;
            }
        }
        float edge = max(edgeDepth, edgeNormal);
        color = mix(color, ubo.ppOutlineColor.rgb, edge);
    }

    // Adaptive Posterization
    if (ubo.ppStylizedParams.x > 0.0) {
        float levels = ubo.ppStylizedParams.x;
        color = floor(color * levels + 0.5) / levels;
    }

    // Dithering to prevent color banding
    if (ubo.ppDitherAniso.x > 0.5) {
        int dMode = int(ubo.ppDitherData.x + 0.5);
        float dScale = max(1.0, ubo.ppDitherData.y);
        vec2 pixelScale = floor(vec2(pixel) / dScale);
        if (ubo.ppHatchAnalog.x > 0.5) {
            vec4 ndc = vec4(uv * 2.0 - 1.0, rawD, 1.0);
            vec4 worldPos = ubo.invViewProj * ndc; worldPos /= worldPos.w;
            pixelScale = floor(worldPos.xz * 100.0 / dScale);
        }
        const int bayer4[16] = int[](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
        int bx = int(pixelScale.x) % 4;
        int by = int(pixelScale.y) % 4;
        float ditherPattern = (float(bayer4[by * 4 + bx]) / 15.0) - 0.5;

        if (dMode == 0) {
            float ditherStrength = max(ubo.ppDitherAniso.y, 1.0);
            if (ditherStrength > 1.1) {
                float levels = max(256.0 / (ditherStrength * 2.0), 2.0); 
                color = color + (ditherPattern / levels) * 2.0;
                color = floor(color * levels + 0.5) / levels;
            } else {
                float randomDither = fract(sin(dot(uv, vec2(12.9898, 78.233)) + ubo.ppMotionBlur.z) * 43758.5453);
                color += (randomDither - 0.5) / 255.0;
            }
        } else if (dMode == 1) {
            float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
            luma += ditherPattern * 0.5; 
            if (luma < 0.33) color = ubo.ditherShadow.rgb;
            else if (luma < 0.66) color = ubo.ditherMid.rgb;
            else color = ubo.ditherHighlight.rgb;
        } else if (dMode == 2) {
            // Custom Bayer/Pattern Texture
            float customPat = texture(ditherInput, fract(uv * dScale)).r;
            color += (customPat - 0.5) * (ubo.ppDitherAniso.y / 10.0);
        }
    }

    // --- EYE BLINKING ---
    if (ubo.ppPsych1.x > 0.0) {
        float t = ubo.ppMotionBlur.z * ubo.ppPsych1.x; // Freq
        float blink = smoothstep(0.8, 1.0, abs(sin(t * 3.14159))); 
        color *= (1.0 - blink); // Экран полностью гаснет
    }

    // --- Color Compression & Palette ---
    if (ubo.ppColorComp.x > 0.5) {
        float levels = ubo.ppColorComp.y;
        color = floor(color * levels) / levels;
    }
    if (ubo.ppColorComp.w > 0.5) { // LUT (256x16 standard format)
        vec3 c = clamp(color, 0.0, 1.0);
        float b = c.b * 15.0;
        float b_floor = floor(b);
        float b_fract = fract(b);
        vec2 uv1 = vec2((b_floor + c.r) / 16.0, c.g);
        vec2 uv2 = vec2((b_floor + 1.0 + c.r) / 16.0, c.g);
        color = mix(textureLod(paletteInput, uv1, 0.0).rgb, textureLod(paletteInput, uv2, 0.0).rgb, b_fract);
    }
    
    // --- ASCII ART ---
    if (ubo.ppAsciiSort.x > 0.0) {
        float scale = max(2.0, ubo.ppAsciiSort.y);
        int mode = int(ubo.ppPixelSort.w + 0.5);
        vec2 cell = floor(uv * ubo.screenSize.xy / scale) * scale;
        vec2 localUV = fract(uv * ubo.screenSize.xy / scale);
        vec3 cellColor = ReadColor(cell / ubo.screenSize.xy);
        float luma = dot(cellColor, vec3(0.2126, 0.7152, 0.0722));
        float shape = 0.0;
        
        if (mode == 0) {
            int charIndex = int(luma * 8.0); 
            if (charIndex == 0) shape = 0.0; 
            else if (charIndex == 1) shape = step(0.4, localUV.x) * step(localUV.x, 0.6) * step(0.4, localUV.y); 
            else if (charIndex == 2) shape = step(0.4, localUV.y) * step(localUV.y, 0.6); 
            else if (charIndex == 3) shape = step(0.2, localUV.y) * step(localUV.y, 0.8) * step(0.4, localUV.x) * step(localUV.x, 0.6); 
            else if (charIndex == 4) shape = step(length(localUV - 0.5), 0.3); 
            else if (charIndex == 5) shape = step(length(localUV - 0.5), 0.4) - step(length(localUV - 0.5), 0.2); 
            else if (charIndex == 6) shape = step(abs(localUV.x + localUV.y - 1.0), 0.1) + step(abs(localUV.x - localUV.y), 0.1); 
            else shape = 1.0; 
        } else if (mode == 1) {
            shape = luma > (localUV.x * localUV.y) ? 1.0 : 0.0;
        } else if (mode == 2) {
            float bin = fract(sin(dot(cell, vec2(12.9898, 78.233))) * 43758.5453) > 0.5 ? 1.0 : 0.0;
            shape = (luma > 0.2) ? (bin > 0.5 ? step(0.3, localUV.x)*step(localUV.x, 0.7) : step(0.3, localUV.y)*step(localUV.y, 0.7)) : 0.0;
        }
        color = cellColor * shape;
    }
    
    // --- WORLD-SPACE ASCII ---
    if (ubo.ppPhosASCII.x > 0.5) {
        float scale = ubo.ppPhosASCII.y;
        vec4 worldRaw = ubo.invViewProj * vec4(uv * 2.0 - 1.0, rawD, 1.0);
        vec3 worldPos = worldRaw.xyz / worldRaw.w;
        vec3 N = textureLod(normalInput, uv, 0.0).rgb;
        float pattern = fract(sin(dot(floor(worldPos * scale), vec3(12.9, 78.2, 45.1)))*43758.5);
        float luma = dot(color, vec3(0.333));
        color *= step(0.5, pattern + luma); // Накладываем матричный дождь на мир
    }
    
    // --- SELECTIVE COLOR (COLOR SPLASH) ---
    if (ubo.ppSpeedLines.z > 0.5) {
        vec3 hsv = rgb2hsv(color);
        float targetHue = ubo.ppSpeedLines.w;
        float hueRange = ubo.ppColorSplash.x;
        float hueDist = min(abs(hsv.x - targetHue), 1.0 - abs(hsv.x - targetHue));
        
        if (hueDist > hueRange) {
            float luma = dot(color, vec3(0.299, 0.587, 0.114));
            color = vec3(luma); // Обесцвечиваем всё, кроме нужного цвета
        }
    }

    // CRT Scanlines & VHS Noise
    if (ubo.ppRetroParams.x > 0.5) {
        if (ubo.ppRetroParams.y > 0.0) {
            float scanlineY = (float(pixel.y) + 0.5) / pSize;
            float scanline = sin(fract(scanlineY) * 3.14159265);
            color *= mix(1.0, scanline, 0.5 * ubo.ppRetroParams.y);
            
            vec2 crtUV = uv * 2.0 - 1.0;
            color *= mix(1.0, smoothstep(2.0, 0.8, dot(crtUV, crtUV)), 0.25 * ubo.ppRetroParams.y);
        }
        if (ubo.ppRetroParams.w > 0.0) {
            float vhsNoise = fract(sin(dot(uv + fract(ubo.ppMotionBlur.z * 10.0), vec2(12.9898, 78.233))) * 43758.5453);
            float tapeBand = step(0.98, fract(uv.y * 3.0 - ubo.ppMotionBlur.z * 1.5));
            color += (vhsNoise - 0.5) * 0.15 * ubo.ppRetroParams.w;
            color += tapeBand * (vhsNoise - 0.5) * 0.3 * ubo.ppRetroParams.w; 
        }
    }

    // --- FILM DAMAGE ---
    if (ubo.ppColorFX.w > 0.5) {
        float intensity = ubo.ppFilmDamage.x;
        float scratches = ubo.ppFilmDamage.y;
        color *= mix(vec3(1.0), vec3(1.0, 0.9, 0.7), intensity); // Yellowing
        float t = ubo.ppMotionBlur.z;
        float scratch = fract(sin(dot(vec2(uv.x, floor(t * 10.0)), vec2(12.9898, 78.233))) * 43758.5453);
        if (scratch > 0.99) {
            float lineIntensity = fract(sin(uv.y * 10.0 + t) * 100.0);
            color *= (1.0 - lineIntensity * scratches);
        }
        float dust = fract(sin(dot(uv + floor(t * 15.0), vec2(12.9898, 78.233))) * 43758.5453);
        if (dust > 0.998) color *= 0.5;
    }
    
    // --- LIGHT LEAKS ---
    if (ubo.ppGlitch3.x > 0.5) {
        float t = ubo.ppMotionBlur.z * 0.5;
        float leak = sin(uv.x * 5.0 + t) * sin(uv.y * 3.0 - t * 1.2);
        leak = smoothstep(0.5, 1.0, leak) * smoothstep(0.2, 0.8, abs(uv.x - 0.5) * 2.0);
        color += vec3(1.0, 0.3, 0.0) * leak * ubo.ppGlitch3.y;
    }
    
    // --- EMBOSS ---
    if (ubo.ppEmboss.x > 0.5) {
        float strength = ubo.ppEmboss.y;
        float angle = ubo.ppEmboss.z * 3.14159 / 180.0;
        int style = int(ubo.ppEmboss.w + 0.5);
        vec2 dir = vec2(cos(angle), sin(angle)) / ubo.screenSize.xy;
        vec3 c1_e = textureLod(hdrInput, clamp(uv - dir, 0.0, 1.0), 0.0).rgb;
        vec3 c2_e = textureLod(hdrInput, clamp(uv + dir, 0.0, 1.0), 0.0).rgb;
        vec3 diff = (c2_e - c1_e) * strength;
        if (style == 0) {
            float lumaDiff = dot(diff, vec3(0.333));
            color = vec3(0.5) + vec3(lumaDiff);
        } else {
            color = color + diff;
        }
    }

    // --- PENCIL SKETCH ---
    if (ubo.ppSketch.x > 0.5) {
        float strokeStrength = ubo.ppSketch.y;
        float strokeLen = max(ubo.ppSketch.z, 0.1);
        float threshold = ubo.ppSketch.w;
        float shadowLevel = ubo.ppSketch2.x;
        float wS = ubo.ppSketch2.y; float wM = ubo.ppSketch2.z; float wH = ubo.ppSketch2.w;
        float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
        float hatchScale = ubo.screenSize.y / strokeLen;
        float h1 = hatch(uv, 0.785, hatchScale, threshold) * wM;  
        float h2 = hatch(uv, -0.785, hatchScale, threshold) * wS; 
        float h3 = hatch(uv, 0.0, hatchScale, threshold) * wS;    
        float h4 = hatch(uv, 1.57, hatchScale, threshold) * wH;   
        float sketch = 1.0;
        if (luma < shadowLevel * 0.33) sketch = h1 * h2 * h3;
        else if (luma < shadowLevel * 0.66) sketch = h1 * h2;
        else if (luma < shadowLevel) sketch = h1;
        else sketch = mix(1.0, h4, 1.0 - clamp((luma - shadowLevel)/(1.0 - shadowLevel), 0.0, 1.0));
        sketch = mix(1.0, clamp(sketch, 0.0, 1.0), strokeStrength);
        color = color * vec3(sketch);
    }

    // --- EDGE DETECT ---
    if (ubo.ppEdgeDetect.x > 0.5) {
        float width = ubo.ppEdgeDetect.y;
        float brightness = ubo.ppEdgeDetect.z;
        float gamma = ubo.ppEdgeDetect.w;
        float blur = ubo.ppEdgeDetect2.x;
        int mode = int(ubo.ppEdgeDetect2.y + 0.5);
        vec3 edgeColor = getEdge(uv, width);
        if (blur > 0.0) {
            vec2 bTexel = blur / ubo.screenSize.xy;
            edgeColor += getEdge(uv + vec2(bTexel.x, 0.0), width);
            edgeColor += getEdge(uv + vec2(-bTexel.x, 0.0), width);
            edgeColor += getEdge(uv + vec2(0.0, bTexel.y), width);
            edgeColor += getEdge(uv + vec2(0.0, -bTexel.y), width);
            edgeColor /= 5.0;
        }
        if (mode == 1) edgeColor = ubo.ppEdgeColor.rgb * dot(edgeColor, vec3(0.2126, 0.7152, 0.0722));
        edgeColor = pow(max(edgeColor * brightness, vec3(0.0001)), vec3(gamma));
        color = edgeColor;
    }

    // --- HALFTONE / CROSS-HATCHING ---
    if (ubo.ppHalftone.x > 0.5) {
        float hScale = ubo.ppHalftone.y;
        float hContrast = ubo.ppHalftone.z;
        vec2 hUv = uv * vec2(ubo.screenSize.x / ubo.screenSize.y, 1.0) * hScale;
        float hTex = texture(halftoneInput, hUv).r;
        
        // Procedural fallback (Процедурная штриховка, если текстура белая/отсутствует)
        if (ubo.ppHalftone.w < 0.5) {
            hTex = clamp(sin(hUv.x * 2.0)*sin(hUv.y * 2.0)*2.0, 0.0, 1.0);
        }
        
        float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
        luma = clamp((luma - 0.5) * hContrast + 0.5, 0.0, 1.0);
        float hatchVal = smoothstep(0.45, 0.55, hTex + luma - 0.5); 
        
        color = mix(vec3(0.0), color, hatchVal);
    }
    
    // --- K-MEANS PALETTE (Постеризация с умным сдвигом) ---
    if (ubo.ppGravVector.z > 0.5) {
        float k = max(ubo.ppGravVector.w, 1.0);
        vec3 hsv = rgb2hsv(color);
        hsv.x = floor(hsv.x * k + 0.5) / k;
        hsv.z = floor(hsv.z * k + 0.5) / k;
        color = hsv2rgb(hsv);
    }
    
    // --- RECURSIVE FEEDBACK LOOPS ---
    if (ubo.ppKMeansFeed.x > 0.5) {
        float zoom = ubo.ppKMeansFeed.y;
        float angle = ubo.ppKMeansFeed.z * 3.14159 / 180.0;
        vec2 d = uv - 0.5;
        float s = sin(angle), c = cos(angle);
        vec2 feedUV = 0.5 + mat2(c, -s, s, c) * d * zoom;
        vec3 feedColor = textureLod(historyInput, feedUV, 0.0).rgb;
        color = max(color, feedColor * 0.95); 
    }
     if (ubo.gbColor1.w > 0.5) {
        float luma = dot(color, vec3(0.299, 0.587, 0.114));
        vec2 pixelScale = floor(vec2(pixel) / 2.0); // Dither Grid
        const int bayer[16] = int[](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
        float dither = (float(bayer[(int(pixelScale.y)%4)*4 + (int(pixelScale.x)%4)]) / 15.0) - 0.5;
        luma = clamp(luma + dither * 0.3, 0.0, 1.0); // Dithering mix
        
        if (luma < 0.25) color = ubo.gbColor1.rgb;
        else if (luma < 0.5) color = ubo.gbColor2.rgb;
        else if (luma < 0.75) color = ubo.gbColor3.rgb;
        else color = ubo.gbColor4.rgb;
    }
    // --- MANGA SCREENTONES ---
    if (ubo.ppStylized3.x > 0.5) {
        float sSize = max(ubo.ppStylized3.y, 1.0);
        float darkness = ubo.ppStylized3.z;
        vec2 scrUV = uv * ubo.screenSize.xy / sSize;
        vec2 localUV = fract(scrUV) - 0.5;
        float luma = dot(color, vec3(0.299, 0.587, 0.114));
        float radius = clamp(1.0 - luma * darkness, 0.0, 1.0) * 0.707;
        float dotMask = step(length(localUV), radius);
        color = mix(color, vec3(0.0), dotMask); // Черные точки в тенях
    }

    // --- CMAA (Conservative Morphological Anti-Aliasing) ---
    if (ubo.ppColorComp.z > 0.5) {
        vec2 texel = 1.0 / ubo.screenSize.xy;
        float luma = dot(color, vec3(0.299, 0.587, 0.114));
        float lumaU = dot(ReadColor(uv + vec2(0, texel.y)), vec3(0.299, 0.587, 0.114));
        float lumaD = dot(ReadColor(uv - vec2(0, texel.y)), vec3(0.299, 0.587, 0.114));
        float lumaL = dot(ReadColor(uv - vec2(texel.x, 0)), vec3(0.299, 0.587, 0.114));
        float lumaR = dot(ReadColor(uv + vec2(texel.x, 0)), vec3(0.299, 0.587, 0.114));

        float dU = abs(luma - lumaU);
        float dD = abs(luma - lumaD);
        float dL = abs(luma - lumaL);
        float dR = abs(luma - lumaR);

        float maxH = max(dL, dR);
        float maxV = max(dU, dD);
        
        vec2 dir = (maxH > maxV) ? vec2(texel.x, 0) : vec2(0, texel.y);
        float maxDiff = max(maxH, maxV);
        
        if (maxDiff > 0.05) { // Edge threshold
            color = (color * 2.0 + ReadColor(uv - dir) + ReadColor(uv + dir)) * 0.25;
        }
    }

    // --- COLOR FX & DEBUG ---
    if (ubo.ppColorFX.x > 0.5) {
        color = vec3(1.0) - color;
    }
    if (ubo.ppColorFX.y > 0.5) {
        float l = dot(color, vec3(0.2126, 0.7152, 0.0722));
        if (l < 0.25) color = mix(vec3(0,0,1), vec3(0,1,1), l*4.0);
        else if (l < 0.5) color = mix(vec3(0,1,1), vec3(0,1,0), (l-0.25)*4.0);
        else if (l < 0.75) color = mix(vec3(0,1,0), vec3(1,1,0), (l-0.5)*4.0);
        else color = mix(vec3(1,1,0), vec3(1,0,0), (l-0.75)*4.0);
    }
    if (ubo.ppColorFX.z > 0.5) {
        float d = textureLod(depthInput, uv, 0.0).r;
        float zN = ubo.zNear; float zF = ubo.zFar;
        float linD = (zN * zF) / (zF + d * (zN - zF));
        color = vec3(linD / 50.0);
    }

    if (any(isnan(color)) || any(isinf(color))) color = vec3(0.0);
    

    imageStore(outImage, pixel, vec4(color, 1.0));

    // --- Auto Exposure Adaptation (Выполняется в 1 потоке на весь кадр) ---
    // SUBGROUP OPTIMIZATION: 256 threads of the first workgroup do this in parallel!
    if (gl_WorkGroupID.x == 0 && gl_WorkGroupID.y == 0 && ubo.ppExposureParams.x > 0.5) {
        vec2 suv = (vec2(gl_LocalInvocationID.xy) + 0.5) / 16.0;
        vec3 s = max(textureLod(hdrInput, suv, 0.0).rgb, vec3(0.0));
        float luma = dot(s, vec3(0.2126, 0.7152, 0.0722));
        float logLuma = log2(clamp(luma, 0.0001, 10000.0));
        
        // Аппаратная редукция (сложение) внутри subgroup без shared memory!
        float sumLuma = subgroupAdd(logLuma);
        
        if (subgroupElect()) {
            // Только 1 поток (лидер) выполняет финальный расчет
            float avgLuma = exp2(sumLuma / 256.0);
            float targetLuma = clamp(avgLuma, ubo.ppExposureParams.z, ubo.ppExposureParams.w);
            adaptedLuminance = mix(adaptedLuminance, targetLuma, 0.02);
        }
    }
}
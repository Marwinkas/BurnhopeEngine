#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform GlobalSceneUbo {
    mat4 projection; mat4 invViewProj; mat4 view; vec3 camPos; float zNear;
    vec3 sunDir; float zFar; vec4 screenSize; mat4 sunLightSpaceMatrices[4];
    vec4 cascadeSplits; uint gridDimX; uint gridDimY; uint gridDimZ; uint portalID; float lightSize;
    vec3 sunColor; float sunIntensity;
    vec4 sscsParams; vec4 gtaoParams; vec4 fogParams; vec4 fogColor; vec4 inscatterColor;
    vec4 skyZenithColor; vec4 skyHorizonColor; vec4 skySunParams;
    vec4 ssgiParams;
    vec4 rtParams;
    
    mat4 prevViewProj;
    vec4 ppExposureParams;
    vec4 ppColorBalance;
    vec4 ppBloomParams;
    vec4 ppDoFParams;
    vec4 ppVignetteGrain;
    vec4 ppMotionBlur;
    vec4 ppLensFlare;
    vec4 ppTAA_CAS;       // ДОБАВЛЕНО
    vec4 ppLensAdvanced;  // x: halo, y: caDir, z: autoFocus, w: tonemapper
    vec4 ppDistortionDirt;
    vec4 ppDitherAniso;
    vec4 cgShadows;
    vec4 cgMidtones;
    vec4 cgHighlights;
    vec4 ppRetroParams;
    vec4 ppRetroParams2;
    vec4 ppStylizedParams;
    vec4 ppOutlineParams;
    vec4 ppOutlineColor;
    vec4 ppOutlineJitter;
} ubo;

layout(set = 1, binding = 0) uniform sampler2D depthMap;
layout(set = 1, binding = 1) uniform sampler2D normalRoughnessMap;
layout(set = 1, binding = 2, r8) uniform writeonly image2D outGTAO;

const int   STEPS = 3;            // ОПТИМИЗАЦИЯ: 3 шага
const int   DIRECTIONS = 4;       // ОПТИМИЗАЦИЯ: 4 направления (итого 12 выборок)
const float PI = 3.14159265359;

vec3 reconstructWorldPos(vec2 uv, float depth) {
    vec4 clipSpace = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldSpace = ubo.invViewProj * clipSpace;
    return worldSpace.xyz / worldSpace.w;
}

float interleavedGradientNoise(vec2 pixelCoord) {
    return fract(52.9829189 * fract(dot(pixelCoord, vec2(0.06711056, 0.00583715))));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = imageSize(outGTAO);
    if (pixelCoord.x >= texSize.x || pixelCoord.y >= texSize.y) return;
    
    if (ubo.gtaoParams.x < 0.5) {
        imageStore(outGTAO, pixelCoord, vec4(1.0));
        return;
    }
    
    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(texSize);
    float depth = textureLod(depthMap, uv, 0.0).r;
    
    if (depth >= 1.0) {
        imageStore(outGTAO, pixelCoord, vec4(1.0));
        return;
    }
    
    vec3 viewPos = (ubo.view * vec4(reconstructWorldPos(uv, depth), 1.0)).xyz; 
    vec3 worldNormal = textureLod(normalRoughnessMap, uv, 0.0).rgb;
    vec3 viewNormal = normalize(mat3(ubo.view) * worldNormal);
    
    float noise = interleavedGradientNoise(vec2(pixelCoord));
    float angleOffset = noise * PI;
    vec2 texelSize = 1.0 / vec2(texSize);
    
    float radius = ubo.gtaoParams.y;
    float bias = ubo.gtaoParams.z;
    float screenRadius = (radius / abs(viewPos.z)) * abs(ubo.projection[1][1]); 
    screenRadius = max(screenRadius, 2.0 * texelSize.y); 
    
    float visibility = 0.0;
    for (int i = 0; i < DIRECTIONS; ++i) {
        float angle = angleOffset + (float(i) / float(DIRECTIONS)) * PI;
        vec2 dir = vec2(cos(angle), sin(angle));
        
        float maxElevation1 = 0.0; 
        float maxElevation2 = 0.0;
        
        for (int j = 1; j <= STEPS; ++j) {
            float t = (float(j) - 0.5 + noise) / float(STEPS); 
            vec2 stepUV = dir * screenRadius * t;
            
            // Вперед
            vec2 uv1 = uv + stepUV;
            if (uv1.x > 0.0 && uv1.x < 1.0 && uv1.y > 0.0 && uv1.y < 1.0) {
                float d1 = textureLod(depthMap, uv1, 0.0).r;
                vec3 p1 = (ubo.view * vec4(reconstructWorldPos(uv1, d1), 1.0)).xyz;
                vec3 v1 = p1 - viewPos;
                float lenV1 = length(v1);
                float weight = max(0.0, 1.0 - (lenV1 * lenV1) / (radius * radius));
                if(lenV1 > 0.001) {
                    float elevation = dot(v1 / lenV1, viewNormal) - bias;
                    maxElevation1 = max(maxElevation1, elevation * weight);
                }
            }
            
            // Назад
            vec2 uv2 = uv - stepUV;
            if (uv2.x > 0.0 && uv2.x < 1.0 && uv2.y > 0.0 && uv2.y < 1.0) {
                float d2 = textureLod(depthMap, uv2, 0.0).r;
                vec3 p2 = (ubo.view * vec4(reconstructWorldPos(uv2, d2), 1.0)).xyz;
                vec3 v2 = p2 - viewPos;
                float lenV2 = length(v2);
                float weight = max(0.0, 1.0 - (lenV2 * lenV2) / (radius * radius));
                if(lenV2 > 0.001) {
                    float elevation = dot(v2 / lenV2, viewNormal) - bias;
                    maxElevation2 = max(maxElevation2, elevation * weight);
                }
            }
        }
        visibility += (1.0 - maxElevation1) * (1.0 - maxElevation2);
    }
    
    visibility /= float(DIRECTIONS);
    visibility = pow(visibility, ubo.gtaoParams.w); // Усиливаем контраст теней
    
    imageStore(outGTAO, pixelCoord, vec4(visibility, visibility, visibility, 1.0));
}
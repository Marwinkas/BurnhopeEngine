layout(set = 11, binding = 0) uniform sampler2D volumetricFogTex;
const float PI = 3.14159265359;
const float atlasResolution = 4096.0;
const vec2 poissonDisk[16] = vec2[](
    vec2(-0.94201624, -0.39906216), vec2(0.94558609, -0.76890725),
    vec2(-0.094184101, -0.92938870), vec2(0.34495938, 0.29387760),
    vec2(-0.91588581, 0.45771432), vec2(-0.81544232, -0.87912464),
    vec2(-0.38277543, 0.27676845), vec2(0.97484398, 0.75648379),
    vec2(0.44323325, -0.97511554), vec2(0.53742981, -0.47373420),
    vec2(-0.26496911, -0.41893023), vec2(0.79197514, 0.19090188),
    vec2(-0.24188840, 0.99706507), vec2(-0.81409955, 0.91437590),
    vec2(0.19984126, 0.78641367), vec2(0.14383161, -0.14100790)
);
float DistributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    return a2 / (3.141592 * pow(NdotH * NdotH * (a2 - 1.0) + 1.0, 2.0));
}
float GeometrySchlickGGX(float NdotV, float roughness) {
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / (NdotV * (1.0 - k) + k);
}
float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    return GeometrySchlickGGX(max(dot(N, V), 0.0), roughness) * GeometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}
vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}
vec3 CalculatePBR(vec3 N, vec3 V, vec3 L, vec3 albedo, float metallic, float roughness, vec3 radiance, float cavity, float celLevels) {
    vec3 H = normalize(V + L);
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    float NDF = DistributionGGX(N, H, roughness);
    float G = GeometrySmith(N, V, L, roughness);
    vec3 F = fresnelSchlick(max(dot(H, V), 0.0), F0);
    vec3 kS = F;
    vec3 kD = (vec3(1.0) - kS) * (1.0 - metallic);
    vec3 numerator = NDF * G * F;
    float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.001;
    vec3 specular = numerator / denominator;
    
    float NdotL = max(dot(N, L), 0.0);
    
    // Cel-Shading (Toon) Processing
    if (celLevels > 0.0) {
        NdotL = floor(NdotL * celLevels + 0.5) / celLevels;
        // Жесткий срез для бликов
        specular = step(0.1, specular) * 0.5;
    }
    
    return (kD * albedo / 3.141592 + specular * cavity) * radiance * NdotL;
}
float CalculatePCSS_Atlas(vec2 atlasUV, vec2 tileMin, vec2 tileMax, float currentDepth, float bias, mat2 rot, GlobalUboStruct currentUbo) {
    vec2 texelSize = vec2(1.0 / atlasResolution);
    float distToEdgeX = min(atlasUV.x - tileMin.x, tileMax.x - atlasUV.x) / texelSize.x;
    float distToEdgeY = min(atlasUV.y - tileMin.y, tileMax.y - atlasUV.y) / texelSize.y;
    float maxRadius = max(min(distToEdgeX, distToEdgeY) - 1.0, 1.0); 
    float searchRadius = min(currentUbo.lightSize * 2.0, maxRadius); 
    int blockers = 0;
    float avgBlockerDepth = 0.0;
    float centerDepth = texture(shadowAtlas, clamp(atlasUV, tileMin, tileMax)).r;
    if (centerDepth < currentDepth - bias) {
        blockers++;
        avgBlockerDepth += centerDepth;
    }
    for (int i = 0; i < 8; i++) {
        vec2 offset = rot * poissonDisk[i] * searchRadius * texelSize;
        float pcfDepth = texture(shadowAtlas, clamp(atlasUV + offset, tileMin, tileMax)).r;
        if (pcfDepth < currentDepth - bias) {
            blockers++;
            avgBlockerDepth += pcfDepth;
        }
    }
    if (blockers == 0) return 0.0; 
    avgBlockerDepth /= float(blockers);
    float distanceToBlocker = max(currentDepth - avgBlockerDepth, 0.0);
    float penumbra = distanceToBlocker * 300.0;
    float filterRadius = min(clamp(penumbra * currentUbo.lightSize, 0.0, 15.0), maxRadius);
    float shadow = 0.0;
    for (int i = 0; i < 16; ++i) {
        vec2 offset = rot * poissonDisk[i] * filterRadius * texelSize; 
        float pcfDepth = texture(shadowAtlas, clamp(atlasUV + offset, tileMin, tileMax)).r;
        shadow += currentDepth - bias > pcfDepth ? 1.0 : 0.0;
    }
    return shadow / 16.0;
}
float AtlasShadowCalculation(vec3 fragPos, vec3 N, vec3 L, Light light, GlobalUboStruct currentUbo) {
    if (light.shadowSlot < 0) return 0.0;         
    float NdotL = max(dot(N, L), 0.0);
    float slope = 1.0 - NdotL;
    vec3 normalOffset = N * (0.005 + 0.01 * slope);
    vec4 fragPosLightSpace = light.lightSpaceMatrix * vec4(fragPos + normalOffset, 1.0);
    vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    projCoords.y = 1.0 - projCoords.y; 
    if(projCoords.z > 1.0 || projCoords.x < 0.0 || projCoords.x > 1.0 || projCoords.y < 0.0 || projCoords.y > 1.0) return 0.0;
    float currentDepth = projCoords.z;
    float bias = 0.00005 + 0.0002 * slope;
    int encodedInt = int(light.shadowSlot);
    int realSlot   = encodedInt / 10000;
    int tileSzInt  = encodedInt % 10000; 
    const int minTile      = 128;
    const int atlasInUnits = int(atlasResolution) / minTile; 
    int pxX = (realSlot % atlasInUnits) * minTile;
    int pxY = (realSlot / atlasInUnits) * minTile;
    float uvScale = float(tileSzInt) / atlasResolution;
    vec2 tileMin  = vec2(float(pxX), float(pxY)) / atlasResolution;
    vec2 tileMax  = tileMin + vec2(uvScale) - vec2(1.0 / atlasResolution);
    vec2 atlasUV  = projCoords.xy * uvScale + tileMin;
    vec2 noiseUV = (gl_GlobalInvocationID.xy / 256.0) + vec2(float(light.shadowSlot) * 0.137);
    float randomAngle = texture(noiseTexture, noiseUV).r * 6.2831853;
    float s = sin(randomAngle);
    float c = cos(randomAngle);
    mat2 rot = mat2(c, -s, s, c);
    return CalculatePCSS_Atlas(atlasUV, tileMin, tileMax, currentDepth, bias, rot,currentUbo);
}
float PointShadowCalculation_Atlas(vec3 fragPos, vec3 N, Light light, GlobalUboStruct currentUbo) {
    if (light.shadowSlot < 0) return 0.0;
    vec3 L_dir = normalize(light.position - fragPos);
    float NdotL = max(dot(N, L_dir), 0.0);
    float slope = 1.0 - NdotL;
    vec3 normalOffset = N * (0.02 + 0.05 * slope);
    vec3 offsetFragPos = fragPos + normalOffset;
    vec3 fragToLight = offsetFragPos - light.position;
    vec3 absVec = abs(fragToLight);
    float maxAxis = max(max(absVec.x, absVec.y), absVec.z);
    if (maxAxis >= light.radius) return 0.0;
    int face = 0;
    if (absVec.x >= absVec.y && absVec.x >= absVec.z)
        face = fragToLight.x > 0.0 ? 0 : 1;
    else if (absVec.y >= absVec.x && absVec.y >= absVec.z)
        face = fragToLight.y > 0.0 ? 2 : 3;
    else
        face = fragToLight.z > 0.0 ? 4 : 5;
    mat4 faceMat = faceMatricesBuffer.faceMatrices[light.lightIndex].faces[face];
    vec4 fragLightSpace = faceMat * vec4(offsetFragPos, 1.0);
    vec3 projCoords = fragLightSpace.xyz / fragLightSpace.w;
    if (projCoords.z <= 0.0 || projCoords.z >= 1.0) return 0.0;
    if (abs(projCoords.x) > 1.0 || abs(projCoords.y) > 1.0) return 0.0;
    vec2 uv = projCoords.xy * 0.5 + 0.5;
    float currentDepth = projCoords.z;
    int encodedSlot    = light.shadowSlot;
    int realSlot       = encodedSlot / 10000;
    int tileSize       = encodedSlot % 10000;
    float uvScale      = float(tileSize) / atlasResolution;
    const int minTile      = 128;
    const int atlasInUnits = int(atlasResolution) / minTile;
    int baseX = (realSlot % atlasInUnits) * minTile;
    int baseY = (realSlot / atlasInUnits) * minTile;
    int faceX = baseX + face * tileSize;
    int faceY = baseY;
    if (faceX + tileSize > int(atlasResolution)) {
        faceX = faceX % int(atlasResolution);
        faceY += tileSize;
    }
    vec2 halfTexel = vec2(0.5 / atlasResolution);
    vec2 tileMin   = vec2(float(faceX), float(faceY)) / atlasResolution + halfTexel;
    vec2 tileMax   = tileMin + vec2(uvScale) - halfTexel * 2.0;
    vec2 atlasUV   = uv * uvScale + vec2(float(faceX), float(faceY)) / atlasResolution;
    float bias = 0.002 + 0.005 * slope;
    vec2 noiseUV     = (gl_GlobalInvocationID.xy / 256.0) + vec2(float(light.shadowSlot + face) * 0.137);
    float randomAngle = texture(noiseTexture, noiseUV).r * 6.2831853;
    float s = sin(randomAngle);
    float c = cos(randomAngle);
    mat2 rot = mat2(c, -s, s, c);
    return CalculatePCSS_Atlas(atlasUV, tileMin, tileMax, currentDepth, bias, rot,currentUbo);
}
float SearchBlocker(vec3 projCoords, int layer, float zReceiver, vec2 texelSize, mat2 rot, GlobalUboStruct currentUbo) {
    int blockers = 0;
    float avgBlockerDepth = 0.0;
    float searchRadius = currentUbo.lightSize * 3.0; 
    float blockerBias = 0.00001;
    float centerDepth = texture(sunShadowMap, vec3(projCoords.xy, float(layer))).r;
    if (centerDepth < zReceiver - blockerBias) {
        blockers++;
        avgBlockerDepth += centerDepth;
    }
    for (int i = 0; i < 8; i++) {
        vec2 offset = rot * poissonDisk[i] * searchRadius;
        float pcfDepth = texture(sunShadowMap, vec3(projCoords.xy + offset * texelSize, float(layer))).r;
        if (pcfDepth < zReceiver - blockerBias) {
            blockers++;
            avgBlockerDepth += pcfDepth;
        }
    }
    if (blockers > 0) return avgBlockerDepth / float(blockers);
    return -1.0; 
}
float CalculateSingleCascadeShadow(vec3 fragPos, vec3 N, vec3 L, int layer, float depth, GlobalUboStruct currentUbo) {
    float NdotL = max(dot(N, L), 0.0);
    float offsetMultiplier = (layer == 0) ? 0.02 : (layer == 1) ? 0.05 : 
                             (layer == 2) ? 0.15 : 0.5;
    vec3 normalOffset = N * offsetMultiplier * (1.0 - NdotL);
    vec4 fragPosLightSpace = currentUbo.sunLightSpaceMatrices[layer] * vec4(fragPos + normalOffset, 1.0);
    vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    if (projCoords.z > 1.0 || projCoords.x < 0.0 || projCoords.x > 1.0 || projCoords.y < 0.0 || projCoords.y > 1.0) {
        return 0.0;
    }
    vec2 texelSize = 1.0 / vec2(textureSize(sunShadowMap, 0));
    float currentDepth = projCoords.z;
    float bias = max(0.0005 * (1.0 - NdotL), 0.0001) * (float(layer) + 1.0);
    vec2 noiseUV = (gl_GlobalInvocationID.xy / 256.0) + vec2(float(layer) * 0.137);
    float randomAngle = texture(noiseTexture, noiseUV).r * 6.2831853;
    float s = sin(randomAngle); float c = cos(randomAngle);
    mat2 rot = mat2(c, -s, s, c);
    float avgBlockerDepth = SearchBlocker(projCoords, layer, currentDepth, texelSize, rot, currentUbo);
    if (avgBlockerDepth == -1.0) return 0.0;
    float distanceToBlocker = max(currentDepth - avgBlockerDepth, 0.0);
    float penumbra = distanceToBlocker * 150.0;
    float minFilter = (layer == 0) ? 1.0 :
                      (layer == 1) ? 2.0 :
                      (layer == 2) ? 3.0 : 4.0;
    float filterRadius = max(clamp(penumbra * currentUbo.lightSize, 0.0, 20.0), minFilter);
    float shadow = 0.0;
    for (int i = 0; i < 16; ++i) {
        vec2 offset = rot * poissonDisk[i] * filterRadius;
        float pcfDepth = texture(sunShadowMap, vec3(projCoords.xy + offset * texelSize, float(layer))).r;
        shadow += currentDepth - bias > pcfDepth ? 1.0 : 0.0;
    }
    return shadow / 16.0;
}

float SampleVirtualShadowMap(vec3 projCoords, uint lightIndex, uint face, int encodedSlot) {
    if (projCoords.z > 1.0 || projCoords.z < 0.0 ||
        projCoords.x < 0.0 || projCoords.x > 1.0 || 
        projCoords.y < 0.0 || projCoords.y > 1.0) 
    {
        return 0.0; 
    }
    float pagesPerFace = float(encodedSlot % 10000) / 128.0;
    
    uint slotIndex = lightIndex * 6 + face;
    uint offsetX = (slotIndex % 32) * 128;
    uint offsetY = (slotIndex / 32) * 128;
    
    vec2 texelSize = vec2(1.0 / PHYSICAL_ATLAS_SIZE);
    vec2 noiseUV = (gl_GlobalInvocationID.xy / 256.0) + vec2(float(encodedSlot + face) * 0.137);
    float randomAngle = texture(noiseTexture, noiseUV).r * 6.2831853;
    float s = sin(randomAngle); float c = cos(randomAngle);
    mat2 rot = mat2(c, -s, s, c);
    
    float shadow = 0.0;
    float bias = max(0.005 * (1.0 - projCoords.z), 0.0005);

    // Мягкие тени VSM (PCF)
    for (int i = 0; i < 16; ++i) {
        vec2 offset = rot * poissonDisk[i] * 3.0 * texelSize;
        vec2 sampleCoords = clamp(projCoords.xy + offset, vec2(0.0), vec2(0.99999));
        vec2 pUV = fract(sampleCoords * pagesPerFace);
        
        uint localX = clamp(uint(sampleCoords.x * pagesPerFace), 0u, uint(pagesPerFace - 1.0));
        uint localY = clamp(uint(sampleCoords.y * pagesPerFace), 0u, uint(pagesPerFace - 1.0));
        uint pvX = offsetX + localX;
        uint pvY = offsetY + localY;
        uint physPage = virtualPages[pvY * VIRTUAL_PAGES_X + pvX];
        
        if (physPage != 0xFFFFFFFF && physPage != 0xFFFFFFFE) {
            uint pX = physPage % 32;
            uint pY = physPage / 32;
            vec2 physTexelCoord = vec2(pX * PAGE_SIZE, pY * PAGE_SIZE) + pUV * PAGE_SIZE;
            float shadowDepth = texture(vsmPhysicalAtlas, physTexelCoord / PHYSICAL_ATLAS_SIZE).r;
            shadow += (projCoords.z - bias > shadowDepth) ? 1.0 : 0.0;
        }
    }
    return shadow / 16.0;
}
float SpotShadowCalculation_VSM(vec3 fragPos, vec3 N, vec3 L, Light light, GlobalUboStruct currentUbo) {
    float NdotL = max(dot(N, L), 0.0);
    vec3 normalOffset = N * (0.01 + 0.02 * (1.0 - NdotL));
    vec4 fragPosLightSpace = light.lightSpaceMatrix * vec4(fragPos + normalOffset, 1.0);
    vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    projCoords.y = 1.0 - projCoords.y; // Фикс переворота Y
    return SampleVirtualShadowMap(projCoords, uint(light.lightIndex), 0, light.shadowSlot);
}
float PointShadowCalculation_VSM(vec3 fragPos, vec3 N, Light light, GlobalUboStruct currentUbo) {
    vec3 fragToLight = fragPos - light.position;
    vec3 absVec = abs(fragToLight);
    int face = 0;
    if (absVec.x >= absVec.y && absVec.x >= absVec.z) face = fragToLight.x > 0.0 ? 0 : 1;
    else if (absVec.y >= absVec.x && absVec.y >= absVec.z) face = fragToLight.y > 0.0 ? 2 : 3;
    else face = fragToLight.z > 0.0 ? 4 : 5;
    vec3 L_dir = normalize(light.position - fragPos);
    float NdotL = max(dot(N, L_dir), 0.0);
    vec3 normalOffset = N * (0.02 + 0.05 * (1.0 - NdotL));
    vec3 offsetFragPos = fragPos + normalOffset;
    mat4 faceMat = faceMatricesBuffer.faceMatrices[light.lightIndex].faces[face];
    vec4 fragLightSpace = faceMat * vec4(fragPos, 1.0);
    vec3 projCoords = fragLightSpace.xyz / fragLightSpace.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    projCoords.y = 1.0 - projCoords.y; // Фикс переворота Y
    return SampleVirtualShadowMap(projCoords, uint(light.lightIndex), uint(face), light.shadowSlot);
}

float SunShadowCalculation(vec3 fragPos, vec3 N, vec3 L, GlobalUboStruct currentUbo) {
    float depth = abs((currentUbo.view * vec4(fragPos, 1.0)).z);
    int layer = 3;
    for(int i = 0; i < 4; i++) {
        if(depth < currentUbo.cascadeSplits[i] + 0.5) {
            layer = i;
            break;
        }
    }
    return CalculateSingleCascadeShadow(fragPos, N, L, layer, depth, currentUbo);
}
float ContactShadows(vec3 worldPos, vec3 N, vec3 L, GlobalUboStruct currentUbo) {
    if (currentUbo.sscsParams.x < 0.5) return 1.0;
    int steps = int(currentUbo.sscsParams.z);
    float maxRayLength = currentUbo.sscsParams.y;
    float thickness_limit = currentUbo.sscsParams.w;
    float stepSize = maxRayLength / float(steps);

    // Смещаем старт луча по нормали, чтобы поверхность не затеняла саму себя
    vec3 rayPos = worldPos + N * 0.05;

    // Шум для сглаживания ступенек (дизеринг)
    float dither = fract(sin(dot(gl_GlobalInvocationID.xy, vec2(12.9898, 78.233))) * 43758.5453);
    rayPos += L * stepSize * dither;

    for (int i = 0; i < steps; i++) {
        rayPos += L * stepSize;

        // Переводим точку в экранные координаты
        vec4 clipPos = currentUbo.projection * currentUbo.view * vec4(rayPos, 1.0);
        vec3 ndc = clipPos.xyz / clipPos.w;
        vec2 sampleUV = ndc.xy * 0.5 + 0.5;

        // Если луч ушел за края экрана — прекращаем поиск
        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) break;

        float sampledDepth = textureLod(gDepth, sampleUV, 0.0).r;

        // Если глубина на экране ближе к камере, чем наш луч -> что-то перекрыло свет
        if (sampledDepth < ndc.z) {
            vec4 hitClip = vec4(ndc.xy, sampledDepth, 1.0);
            vec4 hitWorldRaw = currentUbo.invViewProj * hitClip;
            vec3 hitWorld = hitWorldRaw.xyz / hitWorldRaw.w;
            
            float rayDist = distance(currentUbo.camPos, rayPos);
            float hitDist = distance(currentUbo.camPos, hitWorld);
            float thickness = rayDist - hitDist;
            
            if (thickness > 0.0 && thickness < thickness_limit) { 
                return 0.0; // Тень полная при пересечении
            }
        }
    }
    return 1.0; 
}

vec3 CalculateSky(vec3 viewDir, GlobalUboStruct currentUbo) {
    float t = max(viewDir.y, 0.0);
    vec3 skyColor = mix(currentUbo.skyHorizonColor.rgb, currentUbo.skyZenithColor.rgb, pow(t, 0.5));
    
    // Мягко смешиваем небо с туманом на горизонте
    if (currentUbo.fogParams.x > 0.5) {
        skyColor = mix(currentUbo.fogColor.rgb, skyColor, pow(t, 0.5));
    }
    
    float sunDot = dot(viewDir, -currentUbo.sunDir);
    float sunSize = currentUbo.skySunParams.x;
    float sunGlow = currentUbo.skySunParams.y;
    float sunGlowSize = max(currentUbo.skySunParams.z, 0.001);
    
    float sunDisk = smoothstep(1.0 - sunSize - 0.001, 1.0 - sunSize, sunDot);
    float sunAura = pow(max(sunDot, 0.0), 1.0 / sunGlowSize) * sunGlow;
    
    vec3 sunRenderColor = currentUbo.sunColor * currentUbo.sunIntensity;
    skyColor += sunRenderColor * sunDisk;
    skyColor += sunRenderColor * sunAura * 0.1;
    return skyColor;
}

// --- Bilateral Upsampling для GTAO (из 1/2 разрешения в 1/1) ---
float GetGTAOBilateral(vec2 uv, float centerDepth, GlobalUboStruct currentUbo) {
    if (currentUbo.gtaoParams.x < 0.5) return 1.0;
    
    ivec2 texSize = imageSize(gtaoMap);
    vec2 p = uv * vec2(texSize) - 0.5;
    ivec2 i = ivec2(p);
    vec2 f = fract(p);

    float cLin = (currentUbo.zNear * currentUbo.zFar) / (currentUbo.zFar + centerDepth * (currentUbo.zNear - currentUbo.zFar));

    float sumW = 0.0;
    float sumAO = 0.0;

    ivec2 offsets[4] = ivec2[](ivec2(0,0), ivec2(1,0), ivec2(0,1), ivec2(1,1));
    float weights[4] = float[]((1.0-f.x)*(1.0-f.y), f.x*(1.0-f.y), (1.0-f.x)*f.y, f.x*f.y);

    for (int j = 0; j < 4; j++) {
        ivec2 tapPos = clamp(i + offsets[j], ivec2(0), texSize - 1);
        float ao = imageLoad(gtaoMap, tapPos).r;
        ivec2 fullResPos = clamp(tapPos * 2, ivec2(0), ivec2(currentUbo.screenSize.xy)-1);
        float d = texelFetch(gDepth, fullResPos, 0).r;
        float dLin = (currentUbo.zNear * currentUbo.zFar) / (currentUbo.zFar + d * (currentUbo.zNear - currentUbo.zFar));
        float depthDiff = abs(cLin - dLin);
        float weight = weights[j] * exp(-depthDiff * 10.0);
        sumW += weight;
        sumAO += ao * weight;
    }
    if (sumW > 0.0001) return sumAO / sumW;
    return imageLoad(gtaoMap, ivec2(uv * vec2(texSize))).r;
}

// --- Bilateral Upsampling для Volumetric Fog ---
vec4 GetVolumetricFogBilateral(vec2 uv, float centerDepth, GlobalUboStruct currentUbo) {
    if (currentUbo.fogParams.x < 0.5) return vec4(0.0, 0.0, 0.0, 1.0);
    
    vec2 texSize = vec2(textureSize(volumetricFogTex, 0));

    float cLin = (currentUbo.zNear * currentUbo.zFar) / (currentUbo.zFar + centerDepth * (currentUbo.zNear - currentUbo.zFar));

    float sumW = 0.0;
    vec4 sumVol = vec4(0.0);

    // Расширенный 3x3 фильтр с гауссовыми весами для устранения шума (dither)
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 offset = vec2(x, y) * 1.5; // Размываем шире для подавления шума
            vec2 offsetUV = uv + offset / texSize;
            vec4 vol = textureLod(volumetricFogTex, offsetUV, 0.0);
        
            ivec2 fullResPos = clamp(ivec2(offsetUV * currentUbo.screenSize.xy), ivec2(0), ivec2(currentUbo.screenSize.xy)-1);
            float d = texelFetch(gDepth, fullResPos, 0).r;
            float dLin = (currentUbo.zNear * currentUbo.zFar) / (currentUbo.zFar + d * (currentUbo.zNear - currentUbo.zFar));
        
            float depthDiff = abs(cLin - dLin);
            float spatialWeight = exp(-float(x*x + y*y) * 0.6);
            float depthWeight = exp(-depthDiff * 0.5); // Мягче реагируем на разницу глубины
            float weight = spatialWeight * depthWeight;
        
            sumW += weight;
            sumVol += vol * weight;
        }
    }
    if (sumW > 0.0001) return sumVol / sumW;
    return textureLod(volumetricFogTex, uv, 0.0);
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    uint portal_id = texelFetch(gPortalID, pixelCoords, 0).r;
    GlobalUboStruct currentUbo = ubo;
    if (portal_id > 0 && portal_id <= 10) {
        currentUbo = portalUbos.data[portal_id - 1];
    }

    if (pixelCoords.x >= int(currentUbo.screenSize.x) || pixelCoords.y >= int(currentUbo.screenSize.y)) return;
    vec2 uv = (vec2(pixelCoords) + 0.5) / currentUbo.screenSize.xy;
    float depth = texelFetch(gDepth, pixelCoords, 0).r;

    if (depth >= 1.0) {
        vec4 ndc = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
        vec4 worldPosRaw = currentUbo.invViewProj * ndc;
        vec3 viewDir = normalize(worldPosRaw.xyz / worldPosRaw.w - currentUbo.camPos);
        vec3 skyColor = CalculateSky(viewDir, currentUbo);
        
        vec4 volFog = GetVolumetricFogBilateral(uv, depth, currentUbo);
        skyColor = skyColor * volFog.a + volFog.rgb;
        
        imageStore(outColor, pixelCoords, vec4(skyColor, 1.0)); 
        return; 
    }
    vec4 normRough = texelFetch(gNormalRoughness, pixelCoords, 0);
    if (length(normRough.rgb) < 0.1) {
        imageStore(outColor, pixelCoords, vec4(0.0));
        return; 
    }
    vec4 albMet    = texelFetch(gAlbedoMetallic, pixelCoords, 0); 
    vec4 heightAO  = texelFetch(gHeightAO, pixelCoords, 0); 
    vec3 N = normalize(normRough.rgb);
    float roughness = clamp(normRough.a, 0.15, 1.0);
    vec3 albedo    = albMet.rgb;
    float metallic = albMet.a;
    float height   = heightAO.r; 
    float ao       = heightAO.g; 
    
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosRaw = currentUbo.invViewProj * ndc;
    vec3 crntPos = worldPosRaw.xyz / worldPosRaw.w;

    // --- SCREEN SPACE DECALS ---
    int maxDecals = min(decalBuffer.decalCount, 1000);
    for (int i = 0; i < maxDecals; i++) {
        DecalDataGPU decal = decalBuffer.decals[i];
        vec4 localPosP = decal.invModelMatrix * vec4(crntPos, 1.0);
        vec3 localPos = localPosP.xyz / localPosP.w;
        if (abs(localPos.x) <= 0.5 && abs(localPos.y) <= 0.5 && abs(localPos.z) <= 0.5) {
            vec2 decalUV = localPos.xy + 0.5; decalUV.y = 1.0 - decalUV.y;
            float opacity = decal.params.z; int albedoIdx = int(decal.params.x); int normalIdx = int(decal.params.y);
            if (albedoIdx >= 0) {
                vec4 decalAlbedo = textureLod(bindlessTextures[nonuniformEXT(albedoIdx)], decalUV, 0.0);
                if (decalAlbedo.a > 0.01) {
                    float blend = decalAlbedo.a * opacity;
                    albedo = mix(albedo, decalAlbedo.rgb, blend);
                    roughness = mix(roughness, 0.8, blend);
                    if (normalIdx >= 0) {
                        vec3 dNorm = textureLod(bindlessTextures[nonuniformEXT(normalIdx)], decalUV, 0.0).rgb * 2.0 - 1.0;
                        mat3 dRot = transpose(inverse(mat3(inverse(decal.invModelMatrix))));
                        N = normalize(mix(N, normalize(dRot * dNorm), blend));
                    }
                }
            }
        }
    }

    float gtao     = GetGTAOBilateral(uv, depth, currentUbo); // Умное растягивание GTAO
    vec3 V = normalize(currentUbo.camPos - crntPos); 
    float cavity = clamp(height * 0.5 + 0.9, 0.0, 1.0);
        vec3 emissive = texture(gEmissive, uv).rgb;
    // --- Software VRS (Adaptive Shading) ---
    if (currentUbo.ppSSSS.w > 0.5) {
        float luma = dot(albedo, vec3(0.2126, 0.7152, 0.0722));
        if (luma < 0.03 && length(emissive) < 0.01) {
            imageStore(outColor, pixelCoords, vec4(0.0, 0.0, 0.0, 1.0)); 
            return; // Пропускаем тяжелый PBR для черных участков
        }
    }

    // Полностью убираем фейковый ambient. В закрытой комнате должна быть абсолютная темнота!
    vec3 ambient = vec3(0.0);
    vec3 resultRadiance = vec3(0.0);
    vec4 viewPos = currentUbo.view * vec4(crntPos, 1.0);
    float zView = max(-viewPos.z, currentUbo.zNear + 0.001); 
    uint clusterX = uint(float(pixelCoords.x) / (currentUbo.screenSize.x / float(currentUbo.gridDimX)));
    uint clusterY = uint(float(pixelCoords.y) / (currentUbo.screenSize.y / float(currentUbo.gridDimY)));
    uint clusterZ = uint(max(0.0, log(zView / currentUbo.zNear) * float(currentUbo.gridDimZ) / log(currentUbo.zFar / currentUbo.zNear)));
    clusterX = clamp(clusterX, 0u, currentUbo.gridDimX - 1u);
    clusterY = clamp(clusterY, 0u, currentUbo.gridDimY - 1u);
    clusterZ = clamp(clusterZ, 0u, currentUbo.gridDimZ - 1u);
    uint clusterIdx = clusterX + clusterY * ubo.gridDimX + clusterZ * ubo.gridDimX * ubo.gridDimY;
    uint offset = lightGrid[clusterIdx].offset;
    uint lightsInCluster = lightGrid[clusterIdx].count;
    for (uint i = 0; i < lightsInCluster; ++i) { 
        uint lightIndex = globalIndexList[offset + i];
        PointLightData rawLight = lightBlock.lights[lightIndex];
        Light light;
        light.type = int(rawLight.posType.w);
        light.position = rawLight.posType.xyz;
        light.color = rawLight.colorInt.xyz;
        light.intensity = rawLight.colorInt.w;
        light.direction = rawLight.dirRadius.xyz;
        light.radius = rawLight.dirRadius.w;
        light.innerCone = rawLight.shadowParams.x;
        light.outerCone = rawLight.shadowParams.y;
        light.castShadows = int(rawLight.shadowParams.z + 0.5);
        light.shadowSlot  = int(rawLight.shadowParams.w + 0.5);
        light.lightSpaceMatrix = rawLight.lightSpaceMatrix;
        light.lightIndex  = int(i);
        vec3 L = vec3(0.0);
        float attenuation = 1.0;
        if (light.type == 0) { 
            L = normalize(-light.direction);
        }
        else if (light.type == 1) { 
            L = normalize(light.position - crntPos);
            float dist = length(light.position - crntPos);
            float distSq = dist * dist;
            float radiusSq = light.radius * light.radius;
            float falloff = clamp(1.0 - pow(distSq / radiusSq, 2.0), 0.0, 1.0);
            attenuation = (falloff * falloff) / (distSq + 0.0001); 
        }
        else if (light.type == 2) { 
            L = normalize(light.position - crntPos);
            float dist = length(light.position - crntPos);
            float distSq = dist * dist;
            float radiusSq = light.radius * light.radius;
            float falloff = clamp(1.0 - pow(distSq / radiusSq, 2.0), 0.0, 1.0);
            attenuation = (falloff * falloff) / (distSq + 0.0001);
            float theta = dot(L, normalize(-light.direction));
            float epsilon = light.innerCone - light.outerCone;
            float spotEffect = clamp((theta - light.outerCone) / epsilon, 0.0, 1.0);
            attenuation *= spotEffect;
        }
        else if (light.type == 4) { 
            float skyBlend = 0.5 * (N.y + 1.0); 
            ambient += (light.color * light.intensity * skyBlend + (light.color * 0.2) * light.intensity * (1.0 - skyBlend)) * albedo * ao * cavity;
            continue;         
        }
        float NdotL = dot(N, L);
        float angleFade = smoothstep(0.0, 0.05, NdotL);
        attenuation *= angleFade;
        if (attenuation <= 0.001) continue; 
        if (light.castShadows == 1) {
            if (light.type == 0)      attenuation *= (1.0 - SunShadowCalculation(crntPos, N, L, currentUbo)); // Возвращаем стабильный CSM
            else if (light.type == 1) attenuation *= (1.0 - PointShadowCalculation_VSM(crntPos, N, light, currentUbo));
            else if (light.type == 2) attenuation *= (1.0 - SpotShadowCalculation_VSM(crntPos, N, L, light, currentUbo));
            if (attenuation > 0.01) {
                attenuation *= ContactShadows(crntPos, N, L, currentUbo);
            }
        }
        vec3 radiance = light.color * light.intensity * attenuation;
        resultRadiance += CalculatePBR(N, V, L, albedo, metallic, roughness, radiance, cavity, currentUbo.ppStylizedParams.z);
    }
    int debugMode = 0; 
    if (debugMode == 1) {
        imageStore(outColor, pixelCoords, vec4(N * 0.5 + 0.5, 1.0));
        return;
    } 
    else if (debugMode == 2) {
        float d = pow(depth, 50.0); 
        imageStore(outColor, pixelCoords, vec4(vec3(d), 1.0));
        return;
    } 
    else if (debugMode == 3) {
        imageStore(outColor, pixelCoords, vec4(albedo, 1.0));
        return;
    }
    else if (debugMode == 4) {
        vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
        vec4 worldPosRaw = currentUbo.invViewProj * ndc;
        vec3 crntPos = worldPosRaw.xyz / worldPosRaw.w;
        imageStore(outColor, pixelCoords, vec4(crntPos / 10.0, 1.0));
        return;
    }
vec2 texelSize = 1.0 / textureSize(diffuseGITex, 0);
vec3 diffSum = vec3(0.0);
vec3 specSum = vec3(0.0);
float diffWeightSum = 0.0;
float specWeightSum = 0.0;

// Линеаризуем глубину для идеального размытия
float centerDepthLin = (currentUbo.zNear * currentUbo.zFar) / (currentUbo.zFar + depth * (currentUbo.zNear - currentUbo.zFar));
vec3 centerNormal = N;

// Проходим квадратом 3x3 (можно увеличить до 5x5 для супер-гладкости)
for(int x = -1; x <= 1; x++) {
    for(int y = -1; y <= 1; y++) {
        vec2 offsetUV = uv + vec2(x, y) * texelSize * 2.0; // * 2.0 расширяет радиус блюра
        
        // Читаем соседние пиксели
        vec3 sampleDiff = texture(diffuseGITex, offsetUV).rgb;
        vec3 sampleSpec = texture(specularGITex, offsetUV).rgb;
        vec3 sampleNormal = texture(gNormalRoughness, offsetUV).rgb;
        float sampleDepthRaw = texture(gDepth, offsetUV).r;
        float sampleDepthLin = (currentUbo.zNear * currentUbo.zFar) / (currentUbo.zFar + sampleDepthRaw * (currentUbo.zNear - currentUbo.zFar));
        
        // Считаем вес: если сосед слишком далеко по глубине или нормаль смотрит в другую сторону, не размываем с ним!
        float depthDiff = abs(centerDepthLin - sampleDepthLin);
        float normalDot = max(0.0, dot(centerNormal, sampleNormal));
        
        // Настроили веса под линейную глубину
        float weight = exp(-depthDiff * 10.0) * pow(normalDot, 8.0);
        
        diffSum += sampleDiff * weight;
        diffWeightSum += weight;
        
        // Для Specular применяем меньшее пространственное размытие на гладких (Roughness -> 0) материалах
        float specWeight = weight * exp(-float(x*x + y*y) / (max(roughness, 0.01) * 3.0));
        specSum += sampleSpec * specWeight;
        specWeightSum += specWeight;
    }
}

vec3 diffuseGI = diffSum / max(diffWeightSum, 0.0001);
vec3 specularGI = specSum / max(specWeightSum, 0.0001);
 
    // Сила GI = 2.0 давала двойную энергию и вытягивала весь синий цвет
    float giStrength = 1.0; 
    
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    vec3 F = fresnelSchlick(max(dot(N, V), 0.0), F0);
    
    // Доля диффузного света. Металлы не имеют диффузного цвета (kD = 0)
    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);

    float rcEnable = currentUbo.rtParams.z;
    
    if (currentUbo.ppStylizedParams.z > 0.0) {
        float celLevels = currentUbo.ppStylizedParams.z;
        diffuseGI = floor(diffuseGI * celLevels + 0.5) / celLevels;
    }
    
    vec3 indirectDiffuse = (ambient + diffuseGI * giStrength) * albedo * kD * ao * gtao * cavity * rcEnable;
    vec3 indirectSpecular = specularGI * giStrength * F * ao * gtao * cavity * rcEnable;

    float rtReflEnable = currentUbo.rtParams.x;
    vec3 reflections = imageLoad(rtReflectionsMap, pixelCoords).rgb * rtReflEnable;
    float reflectionMask = smoothstep(0.6, 0.2, roughness); // Мягко скрываем зеркальность на матовых объектах
    // Локальные RT отражения перекрывают Specular GI на гладких поверхностях
    vec3 finalSpecular = mix(indirectSpecular, reflections * F, reflectionMask);

    // Итоговый цвет: Прямой свет + Косвенный свет + Отражения
    vec3 finalColor = resultRadiance + indirectDiffuse + finalSpecular;

    // Читаем Emissive из G-Buffer

    finalColor += emissive;

    // Накладываем объемные лучи поверх сцены
    vec4 volFog = GetVolumetricFogBilateral(uv, depth, currentUbo);
    finalColor = finalColor * volFog.a + volFog.rgb;

    if (any(isnan(finalColor)) || any(isinf(finalColor))) finalColor = vec3(0.0);

    if (debugMode == 5) {
        vec3 debugGI = (diffuseGI * albedo * kD + specularGI * F) * giStrength * ao * gtao * cavity;
        
        // Сжимаем яркие цвета (Tone mapping) и делаем гамму
        debugGI = debugGI / (debugGI + vec3(1.0));
        debugGI = pow(debugGI, vec3(1.0 / 2.2));
        imageStore(outColor, pixelCoords, vec4(debugGI, 1.0));
        return;
    }


    // Выводим финальный цвет со всем светом и тенями!
    imageStore(outColor, pixelCoords, vec4(finalColor, 1.0));
}
#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) uniform GlobalSceneUbo {
     mat4 projection; mat4 invViewProj; mat4 view; vec3 camPos; float zNear;
    vec3 sunDir; float zFar; vec4 screenSize; mat4 sunLightSpaceMatrices[4];
    vec4 cascadeSplits; uint gridDimX; uint gridDimY; uint gridDimZ; uint portalID; float lightSize;
    vec3 sunColor; float sunIntensity;
    vec4 sscsParams; vec4 gtaoParams; vec4 fogParams; vec4 fogColor; vec4 inscatterColor;
    vec4 skyZenithColor; vec4 skyHorizonColor; vec4 skySunParams;
    vec4 ssgiParams;
    vec4 rtParams;
    
    mat4 prevViewProj;
    vec4 ppExposureParams;
    vec4 ppColorBalance;
    vec4 ppBloomParams;
    vec4 ppDoFParams; 
    vec4 ppVignetteGrain;
    vec4 ppMotionBlur;
    vec4 ppLensFlare;
    vec4 ppTAA_CAS;       // ДОБАВЛЕНО
    vec4 ppLensAdvanced;  // x: halo, y: caDir, z: autoFocus, w: tonemapper
    vec4 ppDistortionDirt;
    vec4 ppDitherAniso;
    vec4 cgShadows;
    vec4 cgMidtones;
    vec4 cgHighlights;
    vec4 ppRetroParams;
    vec4 ppRetroParams2;
    vec4 ppStylizedParams;
    vec4 ppOutlineParams;
    vec4 ppOutlineColor;
    vec4 ppOutlineJitter;
       vec4 ppWeatherSSR;
    vec4 ppSSSS;
    vec4 ppWeatherParams;

    vec4 cgGlobalLift;
    vec4 cgGlobalGamma;
    vec4 cgGlobalGain;
    vec4 cgGlobalOffset;
    vec4 cgShadowsLift;
    vec4 cgShadowsGamma;
    vec4 cgShadowsGain;
    vec4 cgShadowsOffset;
    vec4 cgMidtonesLift;
    vec4 cgMidtonesGamma;
    vec4 cgMidtonesGain;
    vec4 cgMidtonesOffset;
    vec4 cgHighlightsLift;
    vec4 cgHighlightsGamma;
    vec4 cgHighlightsGain;
    vec4 cgHighlightsOffset;
    vec4 cgRgbMixerRed;
    vec4 cgRgbMixerGreen;
    vec4 cgRgbMixerBlue;
    vec4 ppBlurs;
    vec4 ppBlurCenter;
    vec4 ppColorFX;
    vec4 ppFilmDamage;
    vec4 ppEdgeDetect;
    vec4 ppEdgeDetect2;
    vec4 ppEdgeColor;
    vec4 ppEmboss;
    vec4 ppSketch;
    vec4 ppSketch2;
    vec4 ppHalftone; 
    vec4 ppDitherData;
    vec4 ditherShadow;
    vec4 ditherMid;
    vec4 ditherHighlight;
    vec4 ppWarp;
    vec4 ppWarp2;
    vec4 ppColorComp;
    vec4 shadowRampColor1;
    vec4 shadowRampColor2;
} ubo;

struct PointLightData {
    vec4 posType;
    vec4 colorInt;
    vec4 dirRadius;
    vec4 shadowParams;
    mat4 lightSpaceMatrix;
};

layout(std140, set = 1, binding = 0) uniform LightBlock {
    int activeLightsCount;
    PointLightData lights[100];
} lightBlock;

struct LightGrid { uint offset; uint count; };
layout(std430, set = 1, binding = 1) writeonly buffer GridBuffer { LightGrid lightGrid[]; };
layout(std430, set = 1, binding = 2) buffer IndexBuffer { 
    uint globalIndexCount;
    uint globalIndexList[]; 
};

void main() {
    uint cx = gl_GlobalInvocationID.x;
    uint cy = gl_GlobalInvocationID.y;
    uint cz = gl_GlobalInvocationID.z;

    if (cx >= ubo.gridDimX || cy >= ubo.gridDimY || cz >= ubo.gridDimZ) return;

    // Логарифмическое разделение глубины
    float zTileNear = ubo.zNear * pow(ubo.zFar / ubo.zNear, float(cz) / float(ubo.gridDimZ));
    float zTileFar  = ubo.zNear * pow(ubo.zFar / ubo.zNear, float(cz + 1) / float(ubo.gridDimZ));

    uint lightCount = 0;
    uint localIndices[100];

    for (int i = 0; i < lightBlock.activeLightsCount && i < 100; i++) {
        PointLightData light = lightBlock.lights[i];
        int type = int(light.posType.w);
        
        if (type == 0 || type == 4) { // Directional или Ambient видны всегда
            localIndices[lightCount++] = i;
            continue;
        }

        vec3 viewPos = (ubo.view * vec4(light.posType.xyz, 1.0)).xyz;
        float radius = light.dirRadius.w;

        // Грубая проверка по глубине (View Space Z смотрит в минус)
        if (-viewPos.z + radius < zTileNear || -viewPos.z - radius > zTileFar) continue;

        // Точная проверка по осям X и Y (Screen-Space AABB пересечение с тайлом)
        vec4 centerClip = ubo.projection * vec4(viewPos, 1.0);
        vec3 centerNdc = centerClip.xyz / centerClip.w;
        float rClip = abs(ubo.projection[1][1] * radius / viewPos.z);
        
        vec2 lightMinUV = (centerNdc.xy - rClip) * 0.5 + 0.5;
        vec2 lightMaxUV = (centerNdc.xy + rClip) * 0.5 + 0.5;
        vec2 tileMinUV = vec2(cx, cy) / vec2(ubo.gridDimX, ubo.gridDimY);
        vec2 tileMaxUV = vec2(cx + 1, cy + 1) / vec2(ubo.gridDimX, ubo.gridDimY);

        if (lightMaxUV.x < tileMinUV.x || lightMinUV.x > tileMaxUV.x ||
            lightMaxUV.y < tileMinUV.y || lightMinUV.y > tileMaxUV.y) continue;

        localIndices[lightCount++] = i;
    }

    uint offset = atomicAdd(globalIndexCount, lightCount);
    for (uint i = 0; i < lightCount; i++) globalIndexList[offset + i] = localIndices[i];

    uint clusterIdx = cx + cy * ubo.gridDimX + cz * ubo.gridDimX * ubo.gridDimY;
    lightGrid[clusterIdx].offset = offset;
    lightGrid[clusterIdx].count = lightCount;
}
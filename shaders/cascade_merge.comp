#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D currentCascade;
layout(set = 0, binding = 1) uniform sampler2D nextCascade;

layout(push_constant) uniform RC {
    vec4  probeGridMin;
    vec4  probeGridMax;
    ivec4 probeCount; 
    vec4  params;     
} rc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(currentCascade);
    if (pixel.x >= sz.x || pixel.y >= sz.y) return;

    vec4 near = imageLoad(currentCascade, pixel);
    
    // Если луч во что-то врезался (alpha >= 0.99), дальний свет нам не нужен, оставляем как есть
    if (near.a >= 0.99) {
        return; 
    }

    int octaSize = int(rc.params.w);
    ivec3 pCount = rc.probeCount.xyz;

    int probeIdxX  = pixel.x / octaSize;
    int probeIdxYZ = pixel.y / octaSize;
    int probeIdxY  = probeIdxYZ % pCount.y;
    int probeIdxZ  = probeIdxYZ / pCount.y;

    ivec2 localPixel = ivec2(pixel.x % octaSize, pixel.y % octaSize);

    vec3 probePosF = vec3(
        (float(probeIdxX) + 0.5) / float(pCount.x),
        (float(probeIdxY) + 0.5) / float(pCount.y),
        (float(probeIdxZ) + 0.5) / float(pCount.z)
    );

    // Зондов в следующем каскаде в 2 раза меньше.
    // Вместо nearest делаем tri-linear между 8 соседями, чтобы убрать сетку.
    ivec3 pCountNext = max(pCount >> 1, ivec3(1));
    vec3 nextProbeF = probePosF * vec3(pCountNext) - 0.5;
    ivec3 n000 = clamp(ivec3(floor(nextProbeF)), ivec3(0), pCountNext - ivec3(1));
    ivec3 n111 = clamp(n000 + 1, ivec3(0), pCountNext - ivec3(1));
    vec3 t = clamp(fract(nextProbeF), vec3(0.0), vec3(1.0));

    vec4 far = vec4(0.0);
    for (int ix = 0; ix < 2; ix++)
    for (int iy = 0; iy < 2; iy++)
    for (int iz = 0; iz < 2; iz++) {
        ivec3 idx = ivec3(
            ix == 0 ? n000.x : n111.x,
            iy == 0 ? n000.y : n111.y,
            iz == 0 ? n000.z : n111.z
        );

        float w = (ix == 0 ? (1.0 - t.x) : t.x) *
                  (iy == 0 ? (1.0 - t.y) : t.y) *
                  (iz == 0 ? (1.0 - t.z) : t.z);

        int nextBaseX = idx.x * octaSize;
        int nextBaseY = (idx.z * pCountNext.y + idx.y) * octaSize;
        ivec2 nextPixel = ivec2(nextBaseX, nextBaseY) + localPixel;
        far += texelFetch(nextCascade, nextPixel, 0) * w;
    }

    // Смешиваем свет. Так как near.a близко к 0, по сути мы прибавляем цвет из far
    float missFactor = 1.0 - near.a;
    vec3 merged = near.rgb + far.rgb * missFactor;
    
    // Если дальний каскад нашел попадание, прокидываем этот факт в более ближние каскады.
    float outAlpha = max(near.a, far.a);
    imageStore(currentCascade, pixel, vec4(merged, outAlpha));
}
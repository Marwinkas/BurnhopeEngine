#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 85, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 255, max_primitives = 85) out;

struct TaskPayload {
    uint objectID;
    uint firstIndex;
    uint lodTriCount;
};
taskPayloadSharedEXT TaskPayload payload;

struct ObjectData {
    mat4 modelMatrix;
    uint materialID;
    uint indexCount;
    uint vrsRate;
    uint boneOffset;
    uint64_t posBufferAddress;
    uint64_t attrBufferAddress;
    uint64_t indexBufferAddress;
    uint64_t colorBufferAddress;
    uint64_t uv2BufferAddress;
    uint64_t animBufferAddress;
    vec4 aabbMin;
    vec4 aabbMax;
};





layout(std430, set = 1, binding = 0) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(std430, set = 1, binding = 3) readonly buffer BoneMatricesBuffer {
    mat4 boneMatrices[];
};

struct PackedVertexPos {
    uint16_t x, y, z, pad;
};
struct PackedVertexAttr {
    uint texUV;
    uint qTangent;
};

struct PackedVertexAnim {
    uint16_t pivotX, pivotY, pivotZ, cloth_ao;
    uint boneIndices;
    uint boneWeights;
};

layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer PosBuffer { PackedVertexPos p[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer AttrBuffer { PackedVertexAttr a[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer IndexBuffer { uint i[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer ColorBuffer { uint c[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer UV2Buffer { uint u[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer AnimBuffer { PackedVertexAnim a[]; };

struct GlobalUboStruct {
    mat4 projection; mat4 invViewProj; mat4 view; vec3 camPos; float zNear;
    vec3 sunDir; float zFar; vec4 screenSize; mat4 sunLightSpaceMatrices[4];
    vec4 cascadeSplits; uint gridDimX; uint gridDimY; uint gridDimZ; uint portalID; float lightSize;
    vec3 sunColor; float sunIntensity; vec4 sscsParams; vec4 gtaoParams; vec4 fogParams; vec4 fogColor; vec4 inscatterColor;
    vec4 skyZenithColor; vec4 skyHorizonColor; vec4 skySunParams; vec4 ssgiParams; vec4 rtParams;
    mat4 prevViewProj; vec4 ppExposureParams; vec4 ppColorBalance; vec4 ppBloomParams; vec4 ppDoFParams; 
    vec4 ppVignetteGrain; vec4 ppMotionBlur; // ppMotionBlur.z is Time
};
layout(set = 0, binding = 0) uniform GlobalSceneUbo { GlobalUboStruct ubo; };

layout(location = 0) out vec3 outCrntPos[];
layout(location = 1) out vec2 outTexCoord[];
layout(location = 2) out mat3 outTBN[];
layout(location = 5) flat out uint outMatID[];
layout(location = 6) out vec4 outColor[];
layout(location = 7) out vec2 outUV2[];
layout(location = 8) out float outThickness[];
layout(location = 9) out vec3 outWorldNormal[];

// Must match glm::packSnorm3x10_1x2 / VK_FORMAT_A2B10G10R10_SNORM_PACK32
vec4 unpackQTangent(uint packedVal) {
    int ix = int(packedVal << 22) >> 22;
    int iy = int(packedVal << 12) >> 22;
    int iz = int(packedVal <<  2) >> 22;
    int iw = int(packedVal << 30) >> 30;
    return clamp(vec4(ix, iy, iz, iw) / vec4(511.0, 511.0, 511.0, 1.0), vec4(-1.0), vec4(1.0));
}

void main() {
    uint objIdx = payload.objectID;
    ObjectData obj = objects[objIdx];
    
    PosBuffer pb = PosBuffer(obj.posBufferAddress);
    AttrBuffer ab = AttrBuffer(obj.attrBufferAddress);
    IndexBuffer ib = IndexBuffer(obj.indexBufferAddress);
    
    uint totalTriangles = payload.lodTriCount;
    uint startTriangle = gl_WorkGroupID.x * 85;
    uint localTriCount = min(85, totalTriangles - startTriangle);
    
    SetMeshOutputsEXT(localTriCount * 3, localTriCount);
    
    uint tid = gl_LocalInvocationID.x; 
    if (tid < localTriCount) {
        gl_PrimitiveTriangleIndicesEXT[tid] = uvec3(tid * 3, tid * 3 + 1, tid * 3 + 2);
    }
    
    if (tid < localTriCount) {
        uint globalTriIdx = startTriangle + tid;
        vec3 extent = obj.aabbMax.xyz - obj.aabbMin.xyz;
        mat3 normalMatrix = transpose(inverse(mat3(obj.modelMatrix)));
        
        ColorBuffer cb = ColorBuffer(obj.colorBufferAddress);
        UV2Buffer u2b = UV2Buffer(obj.uv2BufferAddress);

        vec3 worldPosArr[3];
        vec3 localPosArr[3];
        vec3 vertNArr[3];
        vec3 wTArr[3];
        vec3 wBArr[3];
        
        for (int k = 0; k < 3; k++) {
            uint vIdx = tid * 3 + k;
            uint globalVtxIdx = ib.i[payload.firstIndex + globalTriIdx * 3 + k];
            
            PackedVertexPos vtxP = pb.p[globalVtxIdx];
            PackedVertexAttr vtxA = ab.a[globalVtxIdx];
            
            vec4 vColor = vec4(1.0);
            if (obj.colorBufferAddress != 0) {
                vColor = unpackUnorm4x8(cb.c[globalVtxIdx]);
            }
            outColor[vIdx] = vColor;

            vec2 vUV2 = vec2(0.0);
            if (obj.uv2BufferAddress != 0) {
                vUV2 = unpackHalf2x16(u2b.u[globalVtxIdx]);
            }
            outUV2[vIdx] = vUV2;

            float thickness = float((vtxP.pad >> 8) & 0xFF) / 255.0;
            float windW = float(vtxP.pad & 0xFF) / 255.0;
            outThickness[vIdx] = thickness;

            vec3 localPosNorm = vec3(
                float(vtxP.x) / 65535.0,
                float(vtxP.y) / 65535.0,
                float(vtxP.z) / 65535.0
            );
            vec3 localPos = obj.aabbMin.xyz + localPosNorm * extent;
            
            if (windW > 0.0) {
                float time = ubo.ppMotionBlur.z * 1.5;
                localPos += vec3(sin(time + localPos.x), 0.0, cos(time + localPos.z)) * windW * 0.15;
            }

            mat4 skinMat = mat4(0.0);
            mat3 vtxNormalMatrix = normalMatrix;
            if (obj.boneOffset != 0xFFFFFFFF && obj.animBufferAddress != 0) {
                AnimBuffer anBuf = AnimBuffer(obj.animBufferAddress);
                PackedVertexAnim vtxAn = anBuf.a[globalVtxIdx];
                uint bInd = vtxAn.boneIndices;
                uint bWgh = vtxAn.boneWeights;
                
                float w0 = float((bWgh >> 0) & 0xFF) / 255.0;
                float w1 = float((bWgh >> 8) & 0xFF) / 255.0;
                float w2 = float((bWgh >> 16) & 0xFF) / 255.0;
                float w3 = float((bWgh >> 24) & 0xFF) / 255.0;
                
                if (w0 > 0.0) skinMat += boneMatrices[obj.boneOffset + ((bInd >> 0) & 0xFF)] * w0;
                if (w1 > 0.0) skinMat += boneMatrices[obj.boneOffset + ((bInd >> 8) & 0xFF)] * w1;
                if (w2 > 0.0) skinMat += boneMatrices[obj.boneOffset + ((bInd >> 16) & 0xFF)] * w2;
                if (w3 > 0.0) skinMat += boneMatrices[obj.boneOffset + ((bInd >> 24) & 0xFF)] * w3;
                vtxNormalMatrix = transpose(inverse(mat3(obj.modelMatrix) * mat3(skinMat)));
            }

            vec4 worldPos = obj.boneOffset != 0xFFFFFFFF ? (obj.modelMatrix * skinMat * vec4(localPos, 1.0)) : (obj.modelMatrix * vec4(localPos, 1.0));
            gl_MeshVerticesEXT[vIdx].gl_Position = ubo.projection * ubo.view * worldPos;
            
            outCrntPos[vIdx] = worldPos.xyz;
            outMatID[vIdx] = obj.materialID;
            outTexCoord[vIdx] = unpackHalf2x16(vtxA.texUV);
            localPosArr[k] = localPos;
            worldPosArr[k] = worldPos.xyz;
            
            vec4 aQTangent = unpackQTangent(vtxA.qTangent);
            float qx = aQTangent.x; float qy = aQTangent.y; float qz = aQTangent.z;
            float qw = sqrt(max(0.0, 1.0 - qx*qx - qy*qy - qz*qz));
            vec3 T = vec3(1.0 - 2.0*qy*qy - 2.0*qz*qz, 2.0*qx*qy + 2.0*qz*qw, 2.0*qx*qz - 2.0*qy*qw);
            vec3 N = vec3(2.0*qx*qz + 2.0*qy*qw, 2.0*qy*qz - 2.0*qx*qw, 1.0 - 2.0*qx*qx - 2.0*qy*qy);
            float signT = aQTangent.w < 0.0 ? -1.0 : 1.0;
            vec3 B = cross(N, T) * signT;

            wTArr[k] = normalize(vtxNormalMatrix * T);
            wBArr[k] = normalize(vtxNormalMatrix * B);
            vertNArr[k] = normalize(vtxNormalMatrix * N);
        }

        vec3 faceN = vertNArr[0];
        if (obj.boneOffset != 0xFFFFFFFFu) {
            vec3 e1 = worldPosArr[1] - worldPosArr[0];
            vec3 e2 = worldPosArr[2] - worldPosArr[0];
            vec3 n = cross(e1, e2);
            if (dot(n, n) > 1e-10) faceN = normalize(n);
        } else {
            vec3 localFaceN = cross(localPosArr[1] - localPosArr[0], localPosArr[2] - localPosArr[0]);
            if (dot(localFaceN, localFaceN) > 1e-10) faceN = normalize(normalMatrix * localFaceN);
        }
        vec3 worldCenter = vec3(obj.modelMatrix * vec4((obj.aabbMin.xyz + obj.aabbMax.xyz) * 0.5, 1.0));
        vec3 triCenter = (worldPosArr[0] + worldPosArr[1] + worldPosArr[2]) / 3.0;
        if (dot(faceN, triCenter - worldCenter) < 0.0) faceN = -faceN;

        for (int k = 0; k < 3; k++) {
            uint vIdx = tid * 3 + k;
            outWorldNormal[vIdx] = faceN;
            outTBN[vIdx] = mat3(wTArr[k], wBArr[k], faceN);
        }
    }
}

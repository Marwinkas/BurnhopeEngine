#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// Предыдущий, более крупный мипмап
layout(set = 0, binding = 0) uniform sampler2D inDepth; 
// Текущий, более мелкий мипмап (куда мы пишем)
layout(set = 0, binding = 1, r32f) uniform writeonly image2D outDepth;

layout(push_constant) uniform Push {
    vec2 invSize; // 1.0 / размер inDepth
} push;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(outDepth);
    
    if (pos.x >= outSize.x || pos.y >= outSize.y) return;
    
    // Считаем UV координаты для чтения из предыдущего уровня
    vec2 uv = (vec2(pos) + 0.5) * (1.0 / vec2(outSize));
    
    // Берём 4 пикселя из более крупного уровня
    // (Используем textureLod с LOD=0, так как мы привязываем конкретный уровень во view)
    float d1 = textureLod(inDepth, uv + vec2(-0.25, -0.25) * push.invSize, 0.0).r;
    float d2 = textureLod(inDepth, uv + vec2( 0.25, -0.25) * push.invSize, 0.0).r;
    float d3 = textureLod(inDepth, uv + vec2(-0.25,  0.25) * push.invSize, 0.0).r;
    float d4 = textureLod(inDepth, uv + vec2( 0.25,  0.25) * push.invSize, 0.0).r;
    
    // Hi-Z сохраняет МАКСИМАЛЬНУЮ глубину!
    float maxD = max(max(d1, d2), max(d3, d4));
    
    // Записываем результат
    imageStore(outDepth, pos, vec4(maxD));
}
{
  "name": "guiMain",
  "children": [
    {
      "name": "panel",
      "class": "window_panel",
      "children": [
        { "name": "title", "class": "label", "text": "bh_gui", "size": 14 },
        { "name": "play", "class": "btn_default", "text": "Play", "behaviors": ["hover", "click"], "action": 1 },
        { "name": "pause", "class": "btn_default", "text": "Pause", "behaviors": ["hover", "click"], "action": 2 },
        { "name": "view", "class": "btn_default", "text": "View", "behaviors": ["hover", "click"], "action": 3 },
        { "name": "camera", "class": "btn_default", "text": "Camera", "behaviors": ["hover", "click"], "action": 4 },
        { "name": "posX", "class": "slider", "behaviors": ["hover", "drag"], "axis": "x", "mode": 0, "value": 0.5, "minV": -50, "maxV": 50 },
        { "name": "posY", "class": "slider", "behaviors": ["hover", "drag"], "axis": "x", "mode": 0, "value": 0.5, "minV": -50, "maxV": 50 },
        { "name": "posZ", "class": "slider", "behaviors": ["hover", "drag"], "axis": "x", "mode": 0, "value": 0.5, "minV": -50, "maxV": 50 },
        { "name": "rotX", "class": "slider", "behaviors": ["hover", "drag"], "axis": "x", "mode": 0, "value": 0.5, "minV": -180, "maxV": 180 },
        { "name": "rotY", "class": "slider", "behaviors": ["hover", "drag"], "axis": "x", "mode": 0, "value": 0.5, "minV": -180, "maxV": 180 },
        { "name": "rotZ", "class": "slider", "behaviors": ["hover", "drag"], "axis": "x", "mode": 0, "value": 0.5, "minV": -180, "maxV": 180 },
        { "name": "sclX", "class": "slider", "behaviors": ["hover", "drag"], "axis": "x", "mode": 0, "value": 0.1, "minV": 0.1, "maxV": 10 },
        { "name": "sclY", "class": "slider", "behaviors": ["hover", "drag"], "axis": "x", "mode": 0, "value": 0.1, "minV": 0.1, "maxV": 10 },
        { "name": "sclZ", "class": "slider", "behaviors": ["hover", "drag"], "axis": "x", "mode": 0, "value": 0.1, "minV": 0.1, "maxV": 10 }
      ]
    }
  ]
}

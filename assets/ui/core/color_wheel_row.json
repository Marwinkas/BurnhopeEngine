    { "name": "val", "role": "panel", "class": "cw_val", "flex": { "shrink": 0 } },
    { "name": "side", "role": "column", "class": "cw_side", "flex": { "dir": "column", "shrink": 0 },
      "parts": [
        { "name": "swatch", "role": "panel", "class": "cw_swatch", "flex": { "wp": 100, "shrink": 0 } },
        { "use": "core/button", "name": "pick", "class": "pick_button", "flex": { "wp": 100, "grow": 1, "shrink": 0 } }
      ] }
  ],
  "slots": { "wheel": "wheel", "val": "val", "swatch": "swatch", "pick": "pick" }

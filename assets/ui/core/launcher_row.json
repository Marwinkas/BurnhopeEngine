{
  "role": "row",
  "class": "launcher_row",
  "flex": { "dir": "row", "align": "center", "shrink": 0, "wp": 100 },
  "traits": ["hoverable", "focusable", "pass"],
  "parts": [
    { "name": "stack", "role": "column", "class": "launcher_stack", "flex": { "dir": "column", "grow": 1, "shrink": 1 }, "traits": ["pass"],
      "parts": [
        { "use": "core/label", "name": "name", "class": "launcher_name", "flex": { "grow": 1, "shrink": 1 }, "text": { "align": "left", "valign": "center", "ellipsis": "end", "leading": 1 } },
        { "use": "core/label", "name": "path", "class": "launcher_path", "flex": { "grow": 1, "shrink": 1 }, "text": { "align": "left", "valign": "center", "ellipsis": "end", "leading": 1 } }
      ] },
    { "use": "core/label", "name": "date", "class": "launcher_date", "text": { "align": "right", "valign": "center", "ellipsis": "end", "leading": 1 } }
  ],
  "slots": { "name": "name", "path": "path", "date": "date" }
}

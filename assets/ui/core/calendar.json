{
  "role": "calendar",
  "class": "calendar",
  "flex": { "shrink": 0 },
  "parts": [
    { "name": "bar", "role": "row", "class": "cal_bar", "flex": { "dir": "row", "align": "center", "shrink": 0 },
      "parts": [
        { "use": "core/button", "name": "prev" },
        { "use": "core/label", "name": "head" },
        { "use": "core/button", "name": "next" },
        { "use": "core/button", "name": "close" }
      ] },
    { "name": "todayrow", "role": "row", "class": "cal_row", "flex": { "dir": "row", "shrink": 0 },
      "parts": [ { "use": "core/button", "name": "today" } ] },
    { "name": "weekhead", "role": "row", "class": "cal_head_row", "flex": { "dir": "row", "shrink": 0 },
      "parts": [ { "use": "core/label", "name": "dow", "class": "cal_head_cell", "count": 7 } ] },
    { "name": "week", "role": "row", "class": "cal_week", "flex": { "dir": "row", "shrink": 0 }, "count": 6,
      "parts": [ { "use": "core/button", "name": "day", "class": "cal_day", "count": 7 } ] }
  ],
  "slots": { "prev": "prev", "head": "head", "next": "next", "close": "close", "today": "today", "weekhead": "weekhead" }
}

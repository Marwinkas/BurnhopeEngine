{
  "role": "panel",
  "class": "launcher_veil",
  "flex": { "dir": "row", "align": "center", "justify": "center", "shrink": 0, "wp": 100, "hp": 100 },
  "traits": ["focusable"],
  "parts": [
    { "name": "card", "role": "column", "class": "launcher_card", "flex": { "dir": "column", "shrink": 0 },
      "parts": [
        { "use": "core/label", "name": "title" },
        { "name": "bar", "role": "row", "class": "launcher_bar", "flex": { "dir": "row", "shrink": 0 } },
        { "use": "core/label", "name": "recent" },
        { "name": "list", "role": "column", "class": "launcher_list", "flex": { "dir": "column", "shrink": 0 } }
      ] }
  ],
  "slots": { "card": "card", "title": "title", "bar": "bar", "recent": "recent", "list": "list" }
}

{
  "role": "treerow",
  "class": "tree_row",
  "flex": { "dir": "row", "align": "center", "justify": "start", "shrink": 0 },
  "traits": ["hoverable", "focusable"],
  "parts": [
    { "name": "chevron", "role": "icon", "class": "tree_chevron", "flex": { "shrink": 0 }, "traits": ["focusable"] },
    { "name": "icon", "role": "icon", "class": "tree_icon", "flex": { "shrink": 0 }, "traits": ["nohit"] },
    { "name": "label", "role": "label", "class": "tree_label", "flex": { "grow": 1, "shrink": 1, "self": "stretch" },
      "text": { "align": "left", "valign": "center", "ellipsis": "end", "leading": 1 }, "traits": ["nohit"] }
  ],
  "slots": { "chevron": "chevron", "icon": "icon", "label": "label" }
}

{
  "tokens": {
    "space": { "xs": 4, "sm": 8, "md": 10, "lg": 12 },
    "ctl_h": 28,
    "tool": 30,
    "radius": 4,
    "tile": { "gutter": 44, "caption": 50, "min": 48, "max": 160, "step": 8, "pad": 4, "top": 6, "nameH": 22, "typeH": 16, "typePx": 11 },
    "list": { "rowH": 26 },
    "browser": { "marquee": 4 }
  },
  "classes": {
    "screen": { "direction": "column" },
    "viewport": { "grow": 1 },
    "label": { "h": "$ctl_h", "textSize": 14, "bg": "text", "alpha": 0, "border": 0, "shrink": 0 },
    "label_title": { "extends": "label", "textSize": 16 },
    "label_title_fill": { "extends": "label_title", "grow": 1, "shrink": 1 },
    "label_small": { "extends": "label", "textSize": 12, "h": 20 },
    "label_cell": { "extends": "label", "w": 84 },
    "label_fill": { "extends": "label", "grow": 1, "shrink": 1 },

    "topbar": { "h": 44, "direction": "row", "align": "center", "gap": "$space.xs", "padH": "$space.md", "bg": "title", "alpha": 1, "shrink": 0 },
    "bar_gap": { "w": "$space.sm", "h": 1, "shrink": 0 },
    "bar_sep": { "w": 1, "h": 20, "bg": "muted", "alpha": 0.5, "shrink": 0 },
    "bar_spacer": { "grow": 1, "h": 1 },
    "bar_stats": { "extends": "label", "textSize": 12, "textAlign": "right", "w": 240 },

    "main_row": { "grow": 1, "direction": "row", "shrink": 1 },

    "dock": { "direction": "column", "bg": "side", "alpha": 0.96, "pad": "$space.sm", "gap": "$space.xs", "shrink": 0 },
    "dock_right": { "extends": "dock", "w": 400, "minW": 280 },
    "dock_bottom": { "extends": "dock", "h": 280, "minH": 140 },
    "dock_panel": { "direction": "column", "gap": "$space.sm", "padV": "$space.xs", "grow": 1, "shrink": 1, "basis": 0, "minH": 0 },
    "dock_panel_row": { "direction": "row", "gap": "$space.xs", "grow": 1, "shrink": 1, "basis": 0, "minH": 0 },
    "dock_column": { "direction": "column", "gap": "$space.xs", "shrink": 1 },
    "dock_tree": { "extends": "dock_column", "w": 240, "minW": 140, "shrink": 0 },
    "dock_files": { "extends": "dock_column", "grow": 1, "minW": 0 },
    "tab_bar": { "direction": "row", "align": "center", "gap": 2, "h": 30, "padH": 2, "radius": "$radius", "bg": "title", "alpha": 1, "shrink": 0 },
    "tab": { "h": 24, "padL": 28, "padR": 30, "radius": "$radius", "bg": "button", "alpha": 1, "border": 0, "textSize": 13, "textAlign": "left", "hoverAlpha": 0.15, "shrink": 0 },
    "tab_active": { "extends": "tab", "bg": "content", "border": 1, "borderBg": "accent" },
    "tab_close": { "position": "absolute", "right": 6, "top": 4, "w": 16, "h": 16, "radius": 3, "bg": "muted", "alpha": 0.25, "hoverAlpha": 0.6, "shrink": 0 },
    "splitter_v": { "w": 6, "radius": 3, "bg": "muted", "alpha": 0.3, "hoverAlpha": 0.9, "shrink": 0 },
    "splitter_h": { "h": 6, "radius": 3, "bg": "muted", "alpha": 0.3, "hoverAlpha": 0.9, "shrink": 0 },

    "button": { "h": "$ctl_h", "padH": "$space.md", "radius": "$radius", "bg": "button", "activeBg": "accent", "alpha": 1, "textSize": 14, "textAlign": "center", "hoverAlpha": 0.12, "shrink": 0 },
    "tool_button": { "extends": "button", "w": "$tool", "h": "$tool", "padH": 0 },
    "up_button": { "extends": "button", "w": 22, "h": 22, "padH": 0, "radius": 4 },
    "danger_button": { "extends": "button", "bg": "close" },
    "menu_button": { "extends": "button", "bg": "title", "activeBg": "button" },
    "menu_popup": { "direction": "column", "w": 200, "pad": 4, "gap": 2, "bg": "menu", "alpha": 1, "radius": "$radius", "border": 1, "borderBg": "muted" },
    "menu_item": { "extends": "button", "w": 192, "bg": "menu", "textAlign": "left", "hoverAlpha": 0.2 },

    "section_header": { "h": "$ctl_h", "padH": "$space.md", "radius": "$radius", "bg": "title", "alpha": 1, "textSize": 16, "textAlign": "left", "hoverAlpha": 0.12, "shrink": 0 },
    "section_body": { "direction": "column", "gap": "$space.xs", "padV": "$space.xs", "shrink": 0 },
    "row": { "direction": "row", "h": "$ctl_h", "align": "center", "gap": "$space.xs", "shrink": 0 },
    "row_tall": { "extends": "row", "h": 36 },

    "number": { "h": "$ctl_h", "grow": 1, "shrink": 1, "minW": 0, "padH": "$space.md", "radius": "$radius", "bg": "field", "alpha": 1, "textSize": 14, "textAlign": "left", "hoverAlpha": 0.12 },
    "slider": { "extends": "number", "bg": "slider" },
    "reset_button": { "extends": "button", "w": "$ctl_h", "padH": 0 },
    "swatch": { "h": 36, "radius": "$radius", "bg": "text", "alpha": 1, "shrink": 0 },
    "toggle": { "extends": "button", "w": 56, "bg": "field", "activeBg": "accent" },

    "input": { "h": "$ctl_h", "padH": "$space.md", "radius": "$radius", "border": 1, "borderBg": "muted", "bg": "field", "alpha": 1, "textSize": 14, "grow": 1, "shrink": 1, "minW": 0 },
    "crumbs": { "extends": "label", "grow": 1, "shrink": 1, "padH": "$space.sm" },
    "search": { "extends": "input", "grow": 0, "w": 200 },

    "list_tree": { "grow": 1, "bg": "content", "alpha": 1, "radius": "$radius" },
    "list_hier": { "extends": "list_tree", "h": 150, "grow": 0, "shrink": 0 },
    "crumb_pill": { "direction": "row", "align": "center", "grow": 1, "shrink": 1, "minW": 0, "h": 26, "radius": 4, "bg": "content", "alpha": 1, "padL": 8, "padR": 4, "gap": 0, "border": 1, "borderBg": "chrome" },
    "crumb": { "extends": "label", "h": 24, "padH": 8, "radius": 12, "hoverAlpha": 0.25, "shrink": 0 },
    "crumb_sep": { "extends": "label", "textSize": 12, "h": 24, "padH": 2, "shrink": 0 },
    "row_info": { "direction": "row", "h": 20, "gap": "$space.md", "shrink": 0 },
    "label_small_fill": { "extends": "label_small", "grow": 1, "shrink": 1 },
    "label_small_right": { "extends": "label_small", "textAlign": "right", "w": 360 },
    "menu_slider": { "extends": "slider", "w": 192, "h": 24 },
    "tile_item": { "radius": "$radius", "textSize": 13, "textAlign": "center", "bg": "item", "alpha": 1, "border": 1, "borderBg": "chrome" },
    "row_item": { "radius": 3, "textSize": 13, "textAlign": "left", "bg": "item", "alpha": 0, "padH": "$space.sm" },
    "tooltip": { "position": "absolute", "left": 0, "top": 0, "w": 230, "h": 82, "padH": 10, "padV": 6, "radius": 4, "bg": "menu", "alpha": 1, "border": 1, "borderBg": "chrome", "textSize": 12, "textAlign": "left", "shrink": 0 },
    "drag_ghost": { "extends": "tooltip", "h": 26, "padV": 0, "bg": "item", "borderBg": "accent", "textSize": 13 },
    "marquee": { "position": "absolute", "left": 0, "top": 0, "w": 0, "h": 0, "bg": "accent", "alpha": 0.2, "border": 1, "borderBg": "accent", "shrink": 0 },
    "launcher_veil": { "position": "absolute", "left": 0, "top": 0, "w": "100%", "h": "100%", "align": "center", "justify": "center", "bg": "title", "alpha": 0.94 },
    "launcher_card": { "direction": "column", "w": 560, "pad": 20, "gap": 14, "radius": 8, "bg": "side", "alpha": 1, "border": 1, "borderBg": "muted", "shrink": 0 },
    "recent_list": { "direction": "column", "gap": 2, "shrink": 0 },
    "recent_row": { "direction": "row", "align": "center", "gap": 6, "h": 48, "shrink": 0 },
    "recent_open": { "extends": "button", "grow": 1, "shrink": 1, "minW": 0, "h": 48, "textAlign": "left", "bg": "content", "textSize": 13 },
    "row_preview": { "extends": "row", "justify": "center", "h": 168 },
    "row_shapes": { "extends": "row", "justify": "center" },
    "mat_preview": { "w": 168, "h": 168, "radius": "$radius", "bg": "field", "alpha": 1, "shrink": 0 },
    "cards": { "direction": "row", "wrap": "wrap", "gap": "$space.sm", "shrink": 0 },
    "card_col": { "direction": "column", "gap": "$space.sm", "grow": 1, "shrink": 1, "basis": 0, "minW": 170 },
    "card": { "direction": "column", "gap": "$space.xs", "pad": 6, "radius": "$radius", "bg": "content", "alpha": 1, "shrink": 0 },
    "card_title": { "extends": "label_small", "textSize": 13 },
    "card_row": { "direction": "row", "gap": "$space.xs", "shrink": 0 },
    "card_thumb": { "w": 48, "h": 48, "radius": 3, "bg": "field", "alpha": 1, "textSize": 11, "textAlign": "center", "hoverAlpha": 0.15, "shrink": 0 },
    "card_ctl": { "direction": "column", "gap": "$space.xs", "grow": 1, "shrink": 1, "minW": 0 },
    "card_line": { "direction": "row", "align": "center", "gap": "$space.xs", "h": 22, "shrink": 0 },
    "card_path": { "extends": "input", "h": 22, "padH": 6, "textSize": 12, "basis": 0 },
    "mat_slider": { "extends": "slider", "h": 22, "padH": 6, "textSize": 12, "basis": 0 },
    "mat_number": { "extends": "number", "basis": 0 },
    "reset_small": { "extends": "reset_button", "w": 22, "h": 22, "padH": 0 },
    "color_swatch": { "grow": 1, "shrink": 1, "basis": 0, "minW": 0, "h": 22, "radius": 3, "bg": "field", "alpha": 1, "border": 1, "borderBg": "muted" },
    "toggle_flag": { "extends": "button", "grow": 1, "shrink": 1, "basis": 0, "minW": 0, "h": 24, "padH": 4, "bg": "field", "activeBg": "accent", "textSize": 12 },
    "toggle_wide": { "extends": "toggle_flag", "h": 22 },
    "drop_button": { "extends": "button", "grow": 1, "shrink": 1, "basis": 0, "minW": 0, "bg": "field", "textAlign": "left" },
    "mat_popup": { "extends": "menu_popup", "w": 220, "gap": 6, "pad": 8 },
    "popup_swatch": { "h": 28, "radius": 3, "bg": "field", "alpha": 1, "border": 1, "borderBg": "muted", "shrink": 0 },
    "tex_popup": { "extends": "menu_popup", "w": 520, "h": 480, "pad": 12, "gap": 8, "radius": 8 },
    "tex_search": { "extends": "search", "w": "100%", "grow": 0 },
    "list_tex": { "grow": 1, "bg": "content", "alpha": 1, "radius": "$radius" },
    "button_wide": { "extends": "button", "h": 32, "textAlign": "center" },
    "list_files": { "grow": 1, "bg": "content", "alpha": 1, "radius": "$radius" },
    "list_item": { "padH": "$space.sm", "radius": "$radius", "textSize": 14, "textAlign": "left", "bg": "item", "alpha": 0 }
  }
}
